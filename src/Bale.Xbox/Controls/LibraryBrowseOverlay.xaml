<UserControl
    x:Class="Bale.Xbox.Controls.LibraryBrowseOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views">
  <UserControl.Resources>
    <DataTemplate x:Key="AllTemplate" x:DataType="views:LibraryAlphabetEntry">
      <ToggleButton Content="{x:Bind Letter}" IsChecked="{x:Bind Selected, Mode=OneWay}"
                    Style="{StaticResource SkylineLibraryAlphabetAllStyle}" Click="OnLetterClick" Loaded="OnLetterLoaded" AutomationProperties.Name="{x:Bind Letter}" />
    </DataTemplate>
    <DataTemplate x:Key="LetterTemplate" x:DataType="views:LibraryAlphabetEntry">
      <ToggleButton Content="{x:Bind Letter}" IsChecked="{x:Bind Selected, Mode=OneWay}"
                    Style="{StaticResource SkylineLibraryAlphabetStyle}" Click="OnLetterClick" Loaded="OnLetterLoaded" AutomationProperties.Name="{x:Bind Letter}" />
    </DataTemplate>
    <views:LibraryAlphabetTemplateSelector x:Key="AlphabetTemplates" AllTemplate="{StaticResource AllTemplate}" LetterTemplate="{StaticResource LetterTemplate}" />
  </UserControl.Resources>
  <Grid>
    <!-- TvAlphabetRail.kt: tween(180) defaults to FastOutSlowIn (0.4,0,0.2,1). Animate the plain
         ScrollViewer's layout width, not a ControlTemplate, so the grid and rail share the same space. -->
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="AlphabetExpansion">
        <VisualStateGroup.Transitions>
          <VisualTransition To="AlphabetExpanded">
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AlphabetScroller" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="{StaticResource SkylineLibraryAlphabetExpandedWidth}" KeySpline="0.4,0,0.2,1" />
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </VisualTransition>
          <VisualTransition To="AlphabetCollapsed">
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AlphabetScroller" Storyboard.TargetProperty="Width" EnableDependentAnimation="True">
                <SplineDoubleKeyFrame KeyTime="0:0:0.18" Value="{StaticResource SkylineLibraryAlphabetCollapsedWidth}" KeySpline="0.4,0,0.2,1" />
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </VisualTransition>
        </VisualStateGroup.Transitions>
        <VisualState x:Name="AlphabetCollapsed"><VisualState.Setters>
          <Setter Target="AlphabetScroller.Width" Value="{StaticResource SkylineLibraryAlphabetCollapsedWidth}" />
          <Setter Target="AlphabetScroller.Margin" Value="{StaticResource SkylineLibraryAlphabetCollapsedMargin}" />
        </VisualState.Setters></VisualState>
        <VisualState x:Name="AlphabetExpanded"><VisualState.Setters>
          <Setter Target="AlphabetScroller.Width" Value="{StaticResource SkylineLibraryAlphabetExpandedWidth}" />
          <Setter Target="AlphabetScroller.Margin" Value="{StaticResource SkylineLibraryAlphabetExpandedMargin}" />
        </VisualState.Setters></VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <ScrollViewer x:Name="AlphabetScroller" Style="{StaticResource SkylineLibraryAlphabetRailStyle}" Visibility="Collapsed" SizeChanged="OnAlphabetSizeChanged">
      <ItemsControl x:Name="Alphabet" IsTabStop="False" VerticalAlignment="Center" PreviewKeyDown="OnAlphabetKeyDown"
                    GotFocus="OnAlphabetFocus" LostFocus="OnAlphabetBlur" ItemTemplateSelector="{StaticResource AlphabetTemplates}" />
    </ScrollViewer>

    <!-- TvLibraryBrowseControls.kt: centered, modal 55% black scrim. All direction keys stay here. -->
    <Grid x:Name="Modal" Background="{StaticResource SkylineLibraryBrowseScrim}" Visibility="Collapsed" PreviewKeyDown="OnPanelKeyDown">
      <Border x:Name="Panel" Style="{StaticResource SkylineLibraryBrowsePanelStyle}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel x:Name="PanelHeader" Spacing="3">
            <TextBlock x:Name="PanelEyebrow" Style="{StaticResource SkylineLibraryBrowseEyebrowStyle}" />
            <TextBlock x:Name="PanelTitle" Style="{StaticResource SkylineLibraryBrowsePanelTitleStyle}" Visibility="Collapsed" />
            <Rectangle x:Name="PanelDivider" Height="1" Fill="#1FFFFFFF" Margin="0,8" Visibility="Collapsed" />
          </StackPanel>
          <ScrollViewer x:Name="PanelScroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" IsTabStop="False">
            <ItemsControl x:Name="PanelRows" IsTabStop="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:LibraryPanelRow">
                  <Button Style="{StaticResource SkylineLibraryBrowseRowStyle}" Click="OnPanelRowClick" Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{x:Bind Mark, Mode=OneWay}" Width="15" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{x:Bind Detail, Mode=OneWay}" MaxWidth="140" Opacity="0.68" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
