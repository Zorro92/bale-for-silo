<UserControl
    x:Class="Bale.Xbox.Views.ForYouSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
  <!-- TvCascadeSelector.kt / TvForYouSelector: the same chrome as a single-library cascade. -->
  <Border Style="{StaticResource SkylineForYouPanelStyle}">
    <StackPanel>
      <TextBlock Text="FOR YOU" Style="{StaticResource SkylineLibraryCascadeHeaderStyle}" />
      <Button x:Name="RecommendationsRow" Tag="recommendations" Style="{StaticResource SkylineForYouRowStyle}" Click="OnSelected">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <PathIcon Style="{StaticResource SkylineForYouIconStyle}"
                    Data="M19,9 L20.25,6.25 L23,5 L20.25,3.75 L19,1 L17.75,3.75 L15,5 L17.75,6.25 Z M11.5,9.5 L9,4 L6.5,9.5 L1,12 L6.5,14.5 L9,20 L11.5,14.5 L17,12 Z M19,15 L17.75,17.75 L15,19 L17.75,20.25 L19,23 L20.25,20.25 L23,19 L20.25,17.75 Z" />
          <TextBlock Text="Recommendations" />
        </StackPanel>
      </Button>
      <Button x:Name="FavoritesRow" Tag="favorites" Style="{StaticResource SkylineForYouRowStyle}" Click="OnSelected">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <PathIcon Style="{StaticResource SkylineForYouIconStyle}"
                    Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 Z" />
          <TextBlock Text="Favorites" />
        </StackPanel>
      </Button>
      <Button x:Name="WatchlistRow" Tag="watchlist" Style="{StaticResource SkylineForYouRowStyle}" Click="OnSelected">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <PathIcon Style="{StaticResource SkylineForYouIconStyle}"
                    Data="M17,3 L7,3 C5.9,3 5.01,3.9 5.01,5 L5,21 L12,18 L19,21 L19,5 C19,3.9 18.1,3 17,3 Z" />
          <TextBlock Text="Watchlist" />
        </StackPanel>
      </Button>
      <Rectangle Height="0.5" Fill="{StaticResource SkylineHairline}" Margin="6,3,6,0" />
      <TextBlock Text="Press opens the section · Menu closes" Style="{StaticResource SkylineLibraryCascadeFooterStyle}" />
    </StackPanel>
  </Border>
</UserControl>
