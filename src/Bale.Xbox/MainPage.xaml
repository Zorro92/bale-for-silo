<Page
    x:Class="Bale.Xbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BaleBackground}">

  <!-- Xbox lays pages out at 960x540 effective pixels inside the TV-safe area. -->
  <Grid Padding="48,32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="12">
      <Image Source="Assets/Square44x44Logo.png" Width="36" Height="36" />
      <TextBlock Text="Bale" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource BaleStraw}" VerticalAlignment="Center" />
      <TextBlock Text="a client for Silo" FontSize="16" Foreground="{StaticResource BaleMuted}" VerticalAlignment="Center" Margin="4,6,0,0" />
    </StackPanel>

    <!-- Step 1: which server -->
    <StackPanel x:Name="ServerPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="520" Spacing="16">
      <TextBlock Text="Connect to your Silo server" FontSize="32" FontWeight="SemiBold" />
      <TextBox x:Name="ServerBox" Header="Server address" PlaceholderText="silo.example.com" InputScope="Url" KeyDown="OnServerBoxKeyDown" />
      <Button x:Name="ConnectButton" Content="Continue" Click="OnConnectClick" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
      <TextBlock x:Name="ServerError" Foreground="#FF8A80" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>

    <!-- Step 2: show the pairing code -->
    <StackPanel x:Name="CodePanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
      <TextBlock Text="On your phone or computer, go to" FontSize="22" Foreground="{StaticResource BaleMuted}" HorizontalAlignment="Center" />
      <TextBlock x:Name="ActivateText" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" IsTextSelectionEnabled="False" />
      <TextBlock Text="and enter the code" FontSize="22" Foreground="{StaticResource BaleMuted}" HorizontalAlignment="Center" Margin="0,12,0,0" />
      <TextBlock x:Name="CodeText" FontSize="72" FontWeight="Bold" CharacterSpacing="200" Foreground="{StaticResource BaleStraw}" HorizontalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,12,0,0">
        <ProgressRing IsActive="True" Width="20" Height="20" />
        <TextBlock x:Name="PairingStatus" Text="Waiting for approval" FontSize="18" Foreground="{StaticResource BaleMuted}" />
      </StackPanel>
      <Button x:Name="CancelPairingButton" Content="Use a different server" Click="OnCancelPairingClick" HorizontalAlignment="Center" Margin="0,24,0,0" />
    </StackPanel>

    <!-- Step 3: signed in (placeholder until the home screen exists) -->
    <StackPanel x:Name="SignedInPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Visibility="Collapsed">
      <TextBlock x:Name="WelcomeText" FontSize="40" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock x:Name="ServerText" FontSize="18" Foreground="{StaticResource BaleMuted}" HorizontalAlignment="Center" />
      <Button x:Name="SignOutButton" Content="Sign out" Click="OnSignOutClick" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>

    <ProgressRing x:Name="BusyRing" Grid.Row="1" Width="48" Height="48" Visibility="Collapsed" />
  </Grid>
</Page>
