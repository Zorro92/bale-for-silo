<Page
    x:Class="Bale.Xbox.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    Background="{StaticResource SkylineBackground}">

  <!--
    A title's detail page, pushed full screen over the shell (no top bar), laid out like Silo's
    Android TV TvItemDetailScreen: hero (TvDetailHero) with the action row; on a series the Show /
    Season tabs (TvSeriesModePicker) and the episode rail (TvDetailEpisodeRail, series geometry) sit
    in the same first screen, which stays still while focus is in it; then Cast & Crew
    (TvCastCrewSection). Geometry is TvDetailHero's: 50 px side inset, content from 58 px down,
    540 px wide, with fixed slots so focusing an episode never moves the controls; the art box is
    64% x 70% of a 16:9 canvas, top right.
  -->
  <Page.Resources>
    <DataTemplate x:Key="EpisodeTemplate" x:DataType="views:EpisodeView">
      <StackPanel Width="180" Spacing="7">
        <Grid x:Name="Art" Width="180" Height="101">
          <Grid CornerRadius="8" Background="{StaticResource SkylineCardPlaceholder}">
            <Image Source="{x:Bind Still}" Stretch="UniformToFill" />
            <Grid Visibility="{x:Bind ProgressVisibility}" VerticalAlignment="Bottom" Height="5" Background="#99000000">
              <Border Background="{StaticResource SkylinePrimary}" HorizontalAlignment="Left" Width="{x:Bind ProgressFillWidth}" />
            </Grid>
            <Border Visibility="{x:Bind WatchedVisibility}" Width="20" Height="20" CornerRadius="10" Background="#FFFFFFFF"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
              <FontIcon Glyph="&#xE73E;" FontSize="9" Foreground="#FF000000" />
            </Border>
          </Grid>
          <Border Visibility="{x:Bind CurrentVisibility}" CornerRadius="8" BorderThickness="2" BorderBrush="#B3FFFFFF" IsHitTestVisible="False" />
          <Border x:Name="FocusGlow" Margin="-6" CornerRadius="{StaticResource SkylineFocusGlowRadius}" BorderThickness="3"
                  BorderBrush="{StaticResource SkylineFocusGlow}" Opacity="0" IsHitTestVisible="False" />
          <Border x:Name="FocusRing" Margin="-3" CornerRadius="{StaticResource SkylineFocusRingRadius}" BorderThickness="2"
                  BorderBrush="{StaticResource SkylineFocusRing}" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <StackPanel Spacing="3">
          <TextBlock Text="{x:Bind Caption}" FontSize="9.9" LineHeight="12" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold"
                     Foreground="#EBEDEDED" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind CaptionMeta}" FontSize="9" LineHeight="11.2" LineStackingStrategy="BlockLineHeight" FontWeight="Medium"
                     Foreground="#B3EDEDED" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CastTemplate" x:DataType="views:CastView">
      <StackPanel Width="100" Spacing="0">
        <Grid x:Name="Art" Width="100" Height="100">
          <Ellipse Fill="{StaticResource SkylineSurfaceElevated}" />
          <FontIcon Glyph="&#xE77B;" FontSize="34" Foreground="#99FFFFFF" Visibility="{x:Bind PlaceholderVisibility}" />
          <Ellipse>
            <Ellipse.Fill>
              <ImageBrush ImageSource="{x:Bind Photo}" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse x:Name="FocusGlow" Margin="-6" Stroke="{StaticResource SkylineFocusGlow}" StrokeThickness="3" Opacity="0" IsHitTestVisible="False" />
          <Ellipse x:Name="FocusRing" Margin="-3" Stroke="{StaticResource SkylineFocusRing}" StrokeThickness="2" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <TextBlock Text="{x:Bind Name}" Margin="0,8,0,0" FontSize="11.2" LineHeight="14" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold"
                   TextAlignment="Center" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind Role}" Margin="0,2,0,0" FontSize="10.3" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource SkylineCaptionSubtitle}" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <!-- Page tint from the art (TvItemDetailScreen: sampled tint over black), then the masked art box. -->
    <Rectangle x:Name="Wash" IsHitTestVisible="False" />
    <Grid x:Name="ArtBox" Width="614" Height="378" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" />

    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
      <StackPanel x:Name="PageContent" Padding="0,0,0,70">
        <!-- Hero: fixed slots from 58 px down (logo 80, facts 18, synopsis 56, credit 14, selectors 14), then the actions. -->
        <StackPanel x:Name="Hero" Margin="50,58,50,0" HorizontalAlignment="Left">
          <Grid x:Name="TitleSlot" Height="80" MaxWidth="540" HorizontalAlignment="Left">
            <TextBlock x:Name="TitleText" FontSize="36" FontWeight="Bold" LineHeight="39.5" LineStackingStrategy="BlockLineHeight"
                       TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Bottom" />
            <Image x:Name="TitleLogo" MaxHeight="80" MaxWidth="325" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Uniform" Opacity="0" />
          </Grid>
          <TextBlock x:Name="SubtitleText" Margin="0,2,0,0" FontSize="17.2" FontWeight="ExtraBold" Foreground="#F0FFFFFF" Visibility="Collapsed" />
          <!-- TvDetailHero.MetadataRow: rating chip, then facts, ratings and quality, then type and genres. -->
          <StackPanel x:Name="Metadata" Margin="0,7,0,0" Orientation="Horizontal" Spacing="7" Height="18" />
          <TextBlock x:Name="Synopsis" Margin="0,4,0,0" Height="56" Width="540" HorizontalAlignment="Left" FontSize="11.2" LineHeight="15.5"
                     LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis" Foreground="#F2FFFFFF" />
          <TextBlock x:Name="CreditLine" Margin="0,13,0,0" Height="14" FontSize="10.3" FontWeight="Medium" Foreground="#9EFFFFFF" TextTrimming="CharacterEllipsis" />
          <!-- Room for the Version / Audio / Subtitles summary, which arrives with playback. -->
          <Border x:Name="SelectorSlot" Height="14" Margin="0,2,0,0" />

          <!-- Action row: Play, Start Over (with a resume point), Watchlist, More (TvItemDetailScreen.HeroActionRow). -->
          <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="9" Margin="0,13,0,0" XYFocusKeyboardNavigation="Enabled">
            <Button x:Name="PlayButton" Style="{StaticResource SkylinePlayButtonStyle}" Click="OnPlayClick">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <FontIcon Glyph="&#xF5B0;" FontSize="15" />
                <TextBlock x:Name="PlayLabel" Text="Play" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="StartOverButton" Style="{StaticResource SkylineActionButtonStyle}" Click="OnStartOverClick"
                    AutomationProperties.Name="Start Over" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Glyph="&#xE892;" FontSize="15" />
                <TextBlock Text="Start Over" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="WatchlistButton" Style="{StaticResource SkylineActionButtonStyle}" Click="OnWatchlistClick" AutomationProperties.Name="Watchlist">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <!-- Bookmark (Icons.Filled.BookmarkBorder / Bookmark); Segoe MDL2 has no bookmark. -->
                <Path x:Name="WatchlistIcon" Width="11" Height="15" Stretch="Fill" Stroke="#FFFFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round"
                      Data="M 0,0 L 10,0 L 10,14 L 5,10.5 L 0,14 Z" VerticalAlignment="Center" />
                <TextBlock Text="Watchlist" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="MoreButton" Style="{StaticResource SkylineActionButtonStyle}" AutomationProperties.Name="More">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Glyph="&#xE712;" FontSize="15" />
                <TextBlock Text="More" VerticalAlignment="Center" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout x:Name="MoreMenu" Placement="Bottom">
                  <MenuFlyoutItem x:Name="FavoriteItem" Text="Add to Favorites" Click="OnFavoriteClick" />
                  <MenuFlyoutItem x:Name="WatchedItem" Text="Mark as Watched" Click="OnWatchedClick" />
                  <MenuFlyoutItem x:Name="SeriesItem" Text="Go to Series" Click="OnSeriesClick" Visibility="Collapsed" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
          <TextBlock x:Name="ActionStatus" Margin="0,6,0,0" FontSize="10.3" Foreground="{StaticResource SkylineCaptionSubtitle}" />
        </StackPanel>

        <!-- Series: Show / Season tabs and the episode rail, inside the first screen. -->
        <StackPanel x:Name="EpisodesSection" Margin="0,8,0,0" Visibility="Collapsed">
          <ItemsControl x:Name="Seasons" IsTabStop="False">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                  <ItemsPresenter />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- TvSeasonPicker.kt: inset lives here, not on the scroller, so tabs scroll to screen edges.
                     Leave room for the focused tab's outward ring: the scroller clips inside its padding. -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="50,4,50,4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:SeasonView">
                <ToggleButton Content="{x:Bind Title}" Style="{StaticResource SkylineChipStyle}" Click="OnSeasonClick" GotFocus="OnSeasonFocus" Loaded="OnTabLoaded" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ListView x:Name="Episodes" ItemTemplate="{StaticResource EpisodeTemplate}" SelectionMode="None" IsItemClickEnabled="True"
                    ItemClick="OnEpisodeClick" GotFocus="OnCardFocus" LostFocus="OnCardBlur" Height="155"
                    Padding="50,10,0,6" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource SkylineCardItemStyle}">
                <Setter Property="Margin" Value="0,0,20,0" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <ItemsStackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
          </ListView>
        </StackPanel>

        <!-- Cast & Crew. -->
        <StackPanel x:Name="CastSection" Margin="0,36,0,0" Spacing="10" Visibility="Collapsed">
          <TextBlock Text="Cast &amp; Crew" Margin="50,0,50,0" FontSize="17.2" FontWeight="SemiBold" />
          <ListView x:Name="Cast" ItemTemplate="{StaticResource CastTemplate}" SelectionMode="None" IsItemClickEnabled="False"
                    GotFocus="OnCardFocus" LostFocus="OnCardBlur"
                    Padding="50,12,0,12" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource SkylineCardItemStyle}">
                <Setter Property="Margin" Value="0,0,22,0" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <ItemsStackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
          </ListView>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="True" Foreground="{StaticResource SkylinePrimary}" />
    <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
      <TextBlock x:Name="ErrorText" FontSize="{StaticResource SkylineBodySize}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                 Foreground="{StaticResource SkylineSecondary}" />
      <Button x:Name="RetryButton" Content="Try Again" Style="{StaticResource SkylineButtonStyle}" HorizontalAlignment="Center" Click="OnRetryClick" />
    </StackPanel>
  </Grid>
</Page>
