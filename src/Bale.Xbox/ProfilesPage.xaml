<Page
    x:Class="Bale.Xbox.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    Background="{StaticResource BaleBackground}">

  <Grid Padding="48,32">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="32">
      <TextBlock Text="Who's watching?" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <GridView x:Name="Profiles" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnProfileClick" HorizontalAlignment="Center">
        <GridView.ItemsPanel>
          <ItemsPanelTemplate>
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" />
          </ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemContainerStyle>
          <Style TargetType="GridViewItem">
            <Setter Property="Margin" Value="12" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource BaleStraw}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="3" />
          </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
          <DataTemplate x:DataType="views:ProfileView">
            <StackPanel Width="120" Spacing="10" Padding="0,4">
              <Grid Width="96" Height="96" CornerRadius="48" Background="#3A352A" HorizontalAlignment="Center">
                <TextBlock Text="{x:Bind Initial}" FontSize="40" FontWeight="SemiBold" Foreground="{StaticResource BaleStraw}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                <TextBlock Text="{x:Bind Name}" FontSize="18" TextTrimming="CharacterEllipsis" MaxWidth="100" />
                <FontIcon Glyph="&#xE72E;" FontSize="14" Visibility="{x:Bind LockVisibility}" Foreground="{StaticResource BaleMuted}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>
      <ProgressRing x:Name="Loading" Width="40" Height="40" IsActive="True" />
      <TextBlock x:Name="ErrorText" Foreground="#FF8A80" HorizontalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</Page>
