<Page
    x:Class="Bale.Xbox.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    Background="{StaticResource SkylineAurora}">

  <!-- Android TV's profile picker: Aurora backdrop, rounded-square tiles with the initial, name below. -->
  <Grid>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
      <TextBlock Text="Who's watching?" FontSize="{StaticResource SkylineScreenTitleSize}" FontWeight="Black" HorizontalAlignment="Center" />
      <TextBlock Text="Select your profile" FontSize="{StaticResource SkylineBodySize}" Foreground="{StaticResource SkylineSecondary}" HorizontalAlignment="Center" />
      <GridView x:Name="Profiles" Margin="0,26,0,0" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnProfileClick"
                GotFocus="OnProfileFocus" LostFocus="OnProfileBlur" HorizontalAlignment="Center" ItemContainerStyle="{StaticResource SkylineGridItemStyle}">
        <GridView.ItemsPanel>
          <ItemsPanelTemplate>
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="5" />
          </ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemTemplate>
          <DataTemplate x:DataType="views:ProfileView">
            <StackPanel Width="136" Spacing="12" Margin="10">
              <Grid x:Name="Art" Width="136" Height="136">
                <Grid CornerRadius="12" Background="#FF66758B">
                  <TextBlock Text="{x:Bind Initial}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
                  <Border Width="28" Height="28" CornerRadius="14" Background="#99000000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                          Visibility="{x:Bind LockVisibility}">
                    <FontIcon Glyph="&#xE72E;" FontSize="12" />
                  </Border>
                </Grid>
                <Border x:Name="FocusGlow" Margin="-6" CornerRadius="18" BorderThickness="3" BorderBrush="{StaticResource SkylineFocusGlow}" Opacity="0" />
                <Border x:Name="FocusRing" Margin="-3" CornerRadius="15" BorderThickness="2" BorderBrush="{StaticResource SkylineFocusRing}" Opacity="0" />
              </Grid>
              <TextBlock Text="{x:Bind Name}" FontSize="{StaticResource SkylineRowTitleSize}" FontWeight="SemiBold" HorizontalAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxWidth="136" />
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>
      <ProgressRing x:Name="LoadingRing" Width="24" Height="24" IsActive="True" Foreground="{StaticResource SkylinePrimary}" />
      <TextBlock x:Name="ErrorText" FontSize="{StaticResource SkylineBodySize}" Foreground="{StaticResource SkylineError}" HorizontalAlignment="Center"
                 TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</Page>
