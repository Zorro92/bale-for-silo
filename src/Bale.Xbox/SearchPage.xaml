<Page
    x:Class="Bale.Xbox.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    Background="{StaticResource SkylineBackground}">

  <Grid Margin="44,75,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBox x:Name="QueryBox" Width="440" HorizontalAlignment="Left" PlaceholderText="Search movies, shows and episodes"
             Style="{StaticResource SkylineTextBoxStyle}" TextChanged="OnQueryChanged" InputScope="Search" />
    <TextBlock x:Name="Status" Grid.Row="1" Margin="0,12,0,0" FontSize="{StaticResource SkylineBodySize}" Foreground="{StaticResource SkylineTertiary}" />

    <GridView x:Name="Results" Grid.Row="2" Margin="0,12,0,0" Padding="0,4,44,24" SelectionMode="None" IsItemClickEnabled="True"
              ItemClick="OnResultClick" ItemContainerStyle="{StaticResource SkylineGridItemStyle}">
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="views:CardView">
          <StackPanel Width="{x:Bind Width}" Spacing="5">
            <Grid Width="{x:Bind Width}" Height="{x:Bind Height}" CornerRadius="{StaticResource SkylineCardRadius}" Background="{StaticResource SkylineCardPlaceholder}">
              <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind FallbackVisibility}" TextWrapping="Wrap" TextAlignment="Center"
                         FontSize="{StaticResource SkylineCardSubtitleSize}" VerticalAlignment="Center" Margin="6" Foreground="{StaticResource SkylineSecondary}" />
              <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
            </Grid>
            <TextBlock Text="{x:Bind Title}" FontSize="{StaticResource SkylineCardTitleSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{x:Bind Subtitle}" FontSize="{StaticResource SkylineCardSubtitleSize}" Foreground="{StaticResource SkylineTertiary}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
