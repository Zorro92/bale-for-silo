<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="bale-native" value=".cache/ffmpeg-native" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Never silently replace our rebuilt native DLLs with the public 8.1.2 package. -->
    <packageSource key="bale-native">
      <package pattern="FFmpegInteropX.UWP.FFmpeg" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
