<Page
    x:Class="Bale.Xbox.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    Background="{StaticResource SkylineBackground}">

  <Grid>
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
      <TextBlock Text="Who's watching?" FontSize="{StaticResource SkylineScreenTitleSize}" FontWeight="Bold" HorizontalAlignment="Center" />
      <GridView x:Name="Profiles" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnProfileClick" HorizontalAlignment="Center">
        <GridView.ItemsPanel>
          <ItemsPanelTemplate>
            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" />
          </ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.ItemContainerStyle>
          <Style TargetType="GridViewItem">
            <Setter Property="Margin" Value="8" />
            <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource SkylinePrimary}" />
            <Setter Property="FocusVisualPrimaryThickness" Value="1" />
            <Setter Property="FocusVisualSecondaryThickness" Value="0" />
          </Style>
        </GridView.ItemContainerStyle>
        <GridView.ItemTemplate>
          <DataTemplate x:DataType="views:ProfileView">
            <StackPanel Width="80" Spacing="8" Padding="0,6">
              <Grid Width="56" Height="56" CornerRadius="28" Background="{StaticResource SkylineChromeSelected}" HorizontalAlignment="Center">
                <TextBlock Text="{x:Bind Initial}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="{x:Bind Name}" FontSize="{StaticResource SkylineBodySize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="68" />
                <FontIcon Glyph="&#xE72E;" FontSize="9" Visibility="{x:Bind LockVisibility}" Foreground="{StaticResource SkylineTertiary}" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>
      <ProgressRing x:Name="LoadingRing" Width="24" Height="24" IsActive="True" Foreground="{StaticResource SkylinePrimary}" />
      <TextBlock x:Name="ErrorText" FontSize="{StaticResource SkylineBodySize}" Foreground="{StaticResource SkylineError}" HorizontalAlignment="Center"
                 TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</Page>
