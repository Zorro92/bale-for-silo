            <Border x:Name="Highlight" CornerRadius="4" Background="#8CEDEDED" Opacity="0" />
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="Highlight.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="PointerFocused"><VisualState.Setters><Setter Target="Highlight.Opacity" Value="1" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SkylinePersonFilmographyTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15.48" />
    <Setter Property="LineHeight" Value="18.92" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
  </Style>
  <Style x:Key="SkylinePersonCountStyle" TargetType="TextBlock" BasedOn="{StaticResource SkylinePersonBadgeTextStyle}">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="#99EDEDED" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style x:Key="SkylinePersonStatusStyle" TargetType="TextBlock" BasedOn="{StaticResource SkylinePersonCountStyle}">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0" />
  </Style>
  <!-- Person chips differ from Search chips: selected is white@22%, only focus inverts. -->
  <Style x:Key="SkylinePersonFilterStyle" TargetType="ToggleButton">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="13,6" />
    <Setter Property="FontSize" Value="12.04" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="Lift" /></Grid.RenderTransform>
            <Border CornerRadius="15" Background="#14FFFFFF" BorderThickness="1" BorderBrush="#0FFFFFFF" />
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}" Foreground="#D9FFFFFF" VerticalContentAlignment="Center" />
            <Grid x:Name="CheckedLayer" Opacity="0">
              <Border CornerRadius="15" Background="#38FFFFFF" BorderBrush="#59FFFFFF" BorderThickness="1" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}" Foreground="#FFFFFFFF" VerticalContentAlignment="Center" />
            </Grid>
            <Grid x:Name="FocusLayer" Opacity="0">
              <Border CornerRadius="15" Background="#F0FFFFFF" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}" Foreground="#FF000000" VerticalContentAlignment="Center" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Pressed" /><VisualState x:Name="Disabled" />
                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="CheckedLayer.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="CheckedLayer.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="CheckedLayer.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="CheckedDisabled" /><VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="Focused"><VisualState.Setters><Setter Target="FocusLayer.Opacity" Value="1" /><Setter Target="Lift.ScaleX" Value="1.05" /><Setter Target="Lift.ScaleY" Value="1.05" /></VisualState.Setters></VisualState>
                <VisualState x:Name="PointerFocused"><VisualState.Setters><Setter Target="FocusLayer.Opacity" Value="1" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SkylinePersonLoadingStyle" TargetType="ProgressRing">
    <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="24" /><Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style x:Key="SkylinePersonBioDialogTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.76" /><Setter Property="LineHeight" Value="19.78" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="Foreground" Value="#D1FFFFFF" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Thickness x:Key="SkylinePersonBioDialogPadding">32,28</Thickness>
  <SolidColorBrush x:Key="SkylinePersonDialogScrim" Color="#C7000000" />
  <Style x:Key="SkylineDetailPosterBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="#99000000" /><Setter Property="BorderBrush" Value="#26FFFFFF" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style x:Key="SkylineDetailPosterBadgeTextStyle" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SkylineFocusRing}" />
  </Style>
  <Style x:Key="SkylineDetailPosterRingStyle" TargetType="Border">
    <Setter Property="Margin" Value="-3" /><Setter Property="CornerRadius" Value="{StaticResource SkylineFocusRingRadius}" />
    <Setter Property="BorderThickness" Value="2" /><Setter Property="BorderBrush" Value="{StaticResource SkylineFocusRing}" />
    <Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style x:Key="SkylineDetailPosterGlowStyle" TargetType="Border" BasedOn="{StaticResource SkylineDetailPosterRingStyle}">
    <Setter Property="Margin" Value="-6" /><Setter Property="CornerRadius" Value="{StaticResource SkylineFocusGlowRadius}" />
    <Setter Property="BorderThickness" Value="3" /><Setter Property="BorderBrush" Value="{StaticResource SkylineFocusGlow}" />
  </Style>
  <Style x:Key="SkylineDetailPosterTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource SkylineCardTitleSize}" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SkylineCaptionTitle}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="SkylineDetailPosterSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SkylineDetailPosterTitleStyle}">
    <Setter Property="FontSize" Value="{StaticResource SkylineCardSubtitleSize}" /><Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{StaticResource SkylineCaptionSubtitle}" />
  </Style>
  <Style x:Key="SkylinePersonErrorPanelStyle" TargetType="StackPanel">
    <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Spacing" Value="12" />
  </Style>
  <!-- End Wave 2 detail extras + people. -->

  <!-- TvExploreAllCard.kt: 8dp shape, 44dp arrow circle, 10dp gap, 15.5sp label. -->
  <Style x:Key="SkylineExploreAllCardStyle" TargetType="ContentControl">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border x:Name="Surface" Background="#14FFFFFF" CornerRadius="8">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CardStates">
                <VisualState x:Name="Resting" />
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Surface.Background" Value="#29FFFFFF" />
                    <Setter Target="Circle.Background" Value="#3DFFFFFF" />
                    <Setter Target="Label.Foreground" Value="#FFFFFFFF" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border x:Name="Circle" Width="44" Height="44" CornerRadius="22" Background="#24FFFFFF" HorizontalAlignment="Center">
                <Path Width="24" Height="24" Fill="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M12,4 L10.59,5.41 L16.17,11 L4,11 L4,13 L16.17,13 L10.59,18.59 L12,20 L20,12 Z" />
              </Border>
              <TextBlock x:Name="Label" Text="Explore all" FontFamily="{StaticResource SkylineFont}" FontSize="13.33" LineHeight="15.91"
                         LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="#D9FFFFFF" TextAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- TvSectionHeader.kt / FocusModifier.kt: 16dp chevron, 2dp outline with 6dp radius on focus. -->
  <Style x:Key="SkylineSeeAllButtonStyle" TargetType="Button">
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="False" /><Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="Lift" /></Grid.RenderTransform>
            <Border x:Name="Outline" CornerRadius="6" BorderBrush="#FFFFFFFF" BorderThickness="2" Opacity="0" />
            <StackPanel Orientation="Horizontal" Spacing="4" Padding="8,4">
              <TextBlock Text="See all" FontFamily="{StaticResource SkylineFont}" FontSize="13.76" LineHeight="17.2"
                         LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="#BFFFFFFF" />
              <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                <Path Width="24" Height="24" Fill="#BFFFFFFF" Data="M8.59,16.59 L13.17,12 L8.59,7.41 L10,6 L16,12 L10,18 Z" />
              </Viewbox>
            </StackPanel>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" />
                <VisualState x:Name="Focused"><VisualState.Setters>
                  <Setter Target="Outline.Opacity" Value="1" /><Setter Target="Lift.ScaleX" Value="1.06" /><Setter Target="Lift.ScaleY" Value="1.06" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="PointerFocused"><VisualState.Setters>
                  <Setter Target="Outline.Opacity" Value="1" /><Setter Target="Lift.ScaleX" Value="1.06" /><Setter Target="Lift.ScaleY" Value="1.06" />
                </VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- TvSectionBrowseScreen.kt: six equal columns, 40dp safe area, 30dp top/gaps, 40dp bottom. -->
  <Thickness x:Key="SkylineCatalogPagePadding">40,30,20,40</Thickness>
  <Thickness x:Key="SkylineCatalogHeaderMargin">0,0,20,30</Thickness>
  <x:Double x:Key="SkylineCatalogCaptionGap">11</x:Double>
  <!-- TvMediaCard.kt: 15.5/18.5sp title, 14/18sp year; only the title brightens on focus. -->
  <Style x:Key="SkylineCatalogCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SkylineDetailPosterTitleStyle}">
    <Setter Property="FontSize" Value="13.33" /><Setter Property="LineHeight" Value="15.91" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="Foreground" Value="#C7FFFFFF" />
  </Style>
  <Style x:Key="SkylineCatalogCardSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SkylineDetailPosterSubtitleStyle}">
    <Setter Property="FontSize" Value="12.04" /><Setter Property="LineHeight" Value="15.48" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="Foreground" Value="#B3FFFFFF" />
  </Style>
  <Style x:Key="SkylineCatalogGridItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource SkylineGridItemStyle}">
    <Setter Property="Margin" Value="0,0,20,30" />
  </Style>
  <Style x:Key="SkylineCatalogTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24.08" /><Setter Property="LineHeight" Value="27.52" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="FontWeight" Value="Black" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
  </Style>
  <Style x:Key="SkylineCatalogMessageStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18.92" /><Setter Property="Foreground" Value="{StaticResource SkylineSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Margin" Value="48" />
  </Style>
  <Style x:Key="SkylineCatalogRetryPanelStyle" TargetType="StackPanel">
    <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Spacing" Value="12" /><Setter Property="Margin" Value="24" />
  </Style>
</ResourceDictionary>
