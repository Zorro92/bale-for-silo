  <!-- TvAlphabetRail.kt: ONE persistent target; 8dp collapsed node, 4dp/35% dot or 6dp/90% selected dot.
       Expansion hides the dot layer, never the control. The 42dp, 18sp mono letter chip inverts when selected. -->
  <Style x:Key="SkylineLibraryAlphabetStyle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource SkylineMono}" /><Setter Property="FontSize" Value="15.48" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid x:Name="Root" Width="8" Height="8" Margin="0,0,0,1" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="ExpansionStates">
                <VisualState x:Name="Collapsed" />
                <VisualState x:Name="Expanded"><VisualState.Setters>
                  <Setter Target="Root.Width" Value="42" /><Setter Target="Root.Height" Value="42" /><Setter Target="Root.Margin" Value="0,0,0,4" />
                  <Setter Target="Chips.Opacity" Value="1" /><Setter Target="Dots.Visibility" Value="Collapsed" />
                </VisualState.Setters></VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="DotStates">
                <VisualState x:Name="DotVisible" />
                <VisualState x:Name="DotHidden"><VisualState.Setters><Setter Target="Dot.Opacity" Value="0" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Pressed" /><VisualState x:Name="Disabled" />
                <VisualState x:Name="Checked"><VisualState.Setters>
                  <Setter Target="SelectedChip.Opacity" Value="1" /><Setter Target="RestingChip.Visibility" Value="Collapsed" />
                  <Setter Target="SelectedDot.Visibility" Value="Visible" /><Setter Target="Dot.Visibility" Value="Collapsed" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="CheckedPointerOver" /><VisualState x:Name="CheckedPressed" /><VisualState x:Name="CheckedDisabled" /><VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Unfocused" /><VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Focused"><VisualState.Setters>
                  <Setter Target="FocusedChip.Opacity" Value="1" /><Setter Target="LowerChips.Visibility" Value="Collapsed" />
                </VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <!-- Separate layers keep focus loss from overwriting the checked entry's appearance.
                 Content is always a string, as required by SkylineTabStyle's repeated presenters. -->
            <Grid x:Name="Chips" Opacity="0">
              <Grid x:Name="LowerChips">
                <ContentPresenter x:Name="RestingChip" Content="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                                  FontWeight="{TemplateBinding FontWeight}" Foreground="#8CFFFFFF" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Border x:Name="SelectedChip" CornerRadius="8" Background="#FFFFFFFF" Opacity="0">
                  <ContentPresenter Content="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                                    FontWeight="{TemplateBinding FontWeight}" Foreground="#FF000000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </Border>
              </Grid>
              <Border x:Name="FocusedChip" CornerRadius="8" Background="#FFFFFFFF" Opacity="0">
                <ContentPresenter Content="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}"
                                  FontWeight="{TemplateBinding FontWeight}" Foreground="#FF000000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
              </Border>
            </Grid>
            <Grid x:Name="Dots">
              <Ellipse x:Name="Dot" Width="4" Height="4" Fill="#59FFFFFF" />
              <Ellipse x:Name="SelectedDot" Width="6" Height="6" Fill="#E6FFFFFF" Visibility="Collapsed" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
