<UserControl
    x:Class="Bale.Xbox.Controls.SettingsPickerSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    FontFamily="{StaticResource SkylineFont}" IsTabStop="False">
  <!-- TvSettingsPickerSheet (TvSettingsScreen.kt:2384): the card, header and rows of the page's fixed pickers, with its rows
       built from a Bale.Core SettingsPickerModel; a long list (the subtitle languages) scrolls inside the card's 460dp
       maximum while the header stays. The page owns the keys: Up/Down call Move, Back closes it. -->
  <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="{StaticResource SkylineSettingsPickerScrim}">
    <Border Style="{StaticResource SkylineSettingsPickerCardStyle}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Style="{StaticResource SkylineSettingsPickerHeaderStyle}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Style="{StaticResource SkylineSettingsPickerTitleStyle}">
            <TextBlock x:Name="TitleText" Style="{StaticResource SkylineSettingsPaneTitleStyle}" />
            <TextBlock Text="Choose an option" Style="{StaticResource SkylineSettingsPickerHintTextStyle}" />
          </StackPanel>
          <Border Grid.Column="1" Style="{StaticResource SkylineSettingsPickerHintStyle}">
            <StackPanel Style="{StaticResource SkylineSettingsPickerHintContentStyle}">
              <Viewbox Style="{StaticResource SkylineSettingsPickerHintIconStyle}"><Path Style="{StaticResource SkylineSettingsGlyphStyle}" Opacity="{StaticResource SkylineSettingsHintOpacity}" Data="M12.5,8 C9.85,8 7.45,8.99 5.6,10.6 L2,7 V16 H11 L7.38,12.38 C8.77,11.22 10.54,10.5 12.5,10.5 C16.04,10.5 19.05,12.81 20.1,16 L22.47,15.22 C21.08,11.03 17.15,8 12.5,8 Z" /></Viewbox>
              <TextBlock Text="Back to close" Style="{StaticResource SkylineSettingsPickerHintTextStyle}" />
            </StackPanel>
          </Border>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource SkylineSettingsPickerDividerStyle}" />
        <ScrollViewer x:Name="Scroller" Grid.Row="2" Style="{StaticResource SkylineSettingsDetailScrollerStyle}">
          <ItemsControl x:Name="Options" IsTabStop="False" HorizontalContentAlignment="Stretch">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Style="{StaticResource SkylineSettingsPickerOptionsStyle}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:SettingsPickerOptionView">
                <Button Style="{StaticResource SkylineSettingsPickerOptionStyle}" Loaded="OnOptionLoaded" GotFocus="OnOptionFocus" Click="OnOptionClick"
                        AutomationProperties.Name="{x:Bind Label}">
                  <TextBlock Text="{x:Bind Label}" Style="{StaticResource SkylineSettingsRowTextStyle}" />
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
