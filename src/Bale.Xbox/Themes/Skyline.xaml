  <!-- TvTextInputDialog.kt: outlined 56dp inputs stretch inside the 320dp card. Keep the native
       editing parts, but not Login's fixed widths, credential icons or white Marquee focus fill. -->
  <Style x:Key="SkylineProfileTextFieldStyle" TargetType="TextBox" BasedOn="{StaticResource SkylineCredentialFieldStyle}">
