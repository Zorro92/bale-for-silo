<Page
    x:Class="Bale.Xbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bale.Xbox.Controls"
    Background="{StaticResource SkylineAurora}">
  <Grid>
  <!-- TvMarquee.kt: 45dp safe sides, left copy and a 320dp card, no signed-in shell chrome. -->
  <Grid x:Name="AuthLayout" Style="{StaticResource SkylineAuthLayoutStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="{StaticResource SkylineAuthHeaderRow}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
        <TextBlock Text="BALE" FontSize="{StaticResource SkylineWordmarkSize}" FontWeight="Black" CharacterSpacing="340" VerticalAlignment="Center" />
        <TextBlock Text="a client for Silo" FontSize="{StaticResource SkylineCardSubtitleSize}" Foreground="{StaticResource SkylineTertiary}" VerticalAlignment="Center" />
      </StackPanel>
      <!-- TvServerSetupScreen.kt accessory: rememberTvName() in a TvMarqueeStatusChip with Outlined.Tv. -->
      <Border x:Name="TvNameChip" Visibility="Collapsed" Style="{StaticResource SkylineServerTvChipStyle}">
        <StackPanel Style="{StaticResource SkylineSessionNoticeContentStyle}">
          <Viewbox Style="{StaticResource SkylineSessionNoticeIconStyle}">
            <Path Data="M21,3H3C1.9,3 1,3.9 1,5V17C1,18.1 1.9,19 3,19H8V21H16V19H21C22.1,19 23,18.1 23,17V5C23,3.9 22.1,3 21,3M21,17H3V5H21Z" Fill="{StaticResource SkylineAuthSecondary}" />
          </Viewbox>
          <TextBlock x:Name="TvNameText" Style="{StaticResource SkylineServerTvNameStyle}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- TvServerSetupScreen.kt AddressEntryScreen: advanced scheme/port and identity-confirmed LAN rows. -->
    <ScrollViewer x:Name="ServerPanel" Grid.Row="1" Style="{StaticResource SkylineServerEntryScrollStyle}">
      <StackPanel Style="{StaticResource SkylineServerEntryStyle}">
        <TextBlock Text="Enter your&#x0A;server address" Style="{StaticResource SkylineServerEntryTitleStyle}" />
        <TextBlock Text="Type the address you use for Silo." Style="{StaticResource SkylineServerEntryCaptionStyle}" />
        <TextBox x:Name="ServerBox" PlaceholderText="media.example.com" InputScope="Url" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                 PreventKeyboardDisplayOnProgrammaticFocus="True" TextChanged="OnServerTextChanged"
                 PreviewKeyDown="OnServerBoxPreviewKeyDown" Style="{StaticResource SkylineServerAddressStyle}" />
        <Button x:Name="AdvancedButton" Content="Advanced options" Style="{StaticResource SkylineConnectionAdvancedButtonStyle}" Click="OnAdvancedClick" PreviewKeyDown="OnSetupControlPreviewKeyDown" />
        <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Spacing="10" Margin="0,10,0,0">
          <!-- rail-layout: non-card — ServerSetupAddress.kt Auto / HTTPS / HTTP scheme options. -->
          <ItemsControl x:Name="SchemeActions" PreviewKeyDown="OnSetupControlPreviewKeyDown">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ToggleButton x:Name="AutoButton" IsChecked="True" Content="Auto" Tag="Auto" Style="{StaticResource SkylineConnectionSchemeStyle}" Click="OnSchemeClick" />
            <ToggleButton x:Name="HttpsButton" Content="HTTPS" Tag="Https" Style="{StaticResource SkylineConnectionSchemeStyle}" Click="OnSchemeClick" />
            <ToggleButton x:Name="HttpButton" Content="HTTP" Tag="Http" Style="{StaticResource SkylineConnectionSchemeStyle}" Click="OnSchemeClick" />
          </ItemsControl>
          <TextBox x:Name="PortBox" PlaceholderText="Port: auto" InputScope="Number" PreventKeyboardDisplayOnProgrammaticFocus="True"
                   Style="{StaticResource SkylineConnectionPortStyle}" TextChanged="OnServerTextChanged" PreviewKeyDown="OnSetupControlPreviewKeyDown" />
        </StackPanel>
        <TextBlock x:Name="ServerError" Visibility="Collapsed" Style="{StaticResource SkylineServerEntryErrorStyle}" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="ServerSecurityHint" Text="Secure HTTPS is tried automatically." Style="{StaticResource SkylineServerEntryHintStyle}" />
        <!-- rail-layout: non-card — TvServerSetupScreen.kt manual server-entry actions. -->
        <ItemsControl x:Name="ServerActions" Style="{StaticResource SkylineServerEntryActionsStyle}" PreviewKeyDown="OnServerActionsPreviewKeyDown">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource SkylineAuthActionGap}" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClick" Style="{StaticResource SkylineAuthButtonStyle}" />
          <Button x:Name="ServerBackButton" Content="Back" Click="OnServerBackClick" Style="{StaticResource SkylineAuthPlainButtonStyle}" />
        </ItemsControl>
        <StackPanel x:Name="NearbyPanel" Visibility="Collapsed" Style="{StaticResource SkylineConnectionNearbyPanelStyle}" Spacing="6">
          <TextBlock Text="Found nearby" Style="{StaticResource SkylineServerListCaptionStyle}" />
          <Button x:Name="NearbyFirst" Style="{StaticResource SkylineSavedServerButtonStyle}" Click="OnNearbyClick" PreviewKeyDown="OnSetupControlPreviewKeyDown">
            <StackPanel Spacing="4"><TextBlock x:Name="NearbyFirstName" /><TextBlock x:Name="NearbyFirstAddress" Style="{StaticResource SkylineSavedServerAddressStyle}" /></StackPanel>
          </Button>
          <Button x:Name="NearbySecond" Style="{StaticResource SkylineSavedServerButtonStyle}" Click="OnNearbyClick" PreviewKeyDown="OnSetupControlPreviewKeyDown" Visibility="Collapsed">
            <StackPanel Spacing="4"><TextBlock x:Name="NearbySecondName" /><TextBlock x:Name="NearbySecondAddress" Style="{StaticResource SkylineSavedServerAddressStyle}" /></StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- TvLoginScreen.kt / TvMarquee.kt: server context and copy opposite a single QR/code/status card. -->
    <Grid x:Name="CodePanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource SkylineAuthCopyColumn}" />
        <ColumnDefinition Width="*" MinWidth="{StaticResource SkylineAuthColumnGap}" />
        <ColumnDefinition Width="{StaticResource SkylineAuthCardColumn}" />
      </Grid.ColumnDefinitions>
      <ScrollViewer Style="{StaticResource SkylineConnectionLoginScrollerStyle}">
      <StackPanel Style="{StaticResource SkylineConnectionLoginCopyStyle}">
        <!-- TvLoginScreen.kt notices: a polite status chip ABOVE the server card, not an error on it. -->
        <Border x:Name="SessionNotice" Visibility="Collapsed" Style="{StaticResource SkylineSessionNoticeStyle}">
          <StackPanel Style="{StaticResource SkylineSessionNoticeContentStyle}">
            <Viewbox Style="{StaticResource SkylineSessionNoticeIconStyle}">
              <Path Data="M11,15H13V17H11M11,7H13V13H11M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z" Fill="{StaticResource SkylineAuthSecondary}" />
            </Viewbox>
            <TextBlock x:Name="SessionNoticeText" Style="{StaticResource SkylineSessionNoticeTextStyle}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SkylineLoginServerCardStyle}">
          <StackPanel Orientation="Horizontal">
            <!-- MarqueeServerMark.kt: branded mark over a serif initial, or a plain dark tile. -->
            <Grid>
              <Border Style="{StaticResource SkylineLoginEmptyServerMarkStyle}" />
              <Border x:Name="ServerInitialMark" Style="{StaticResource SkylineLoginServerMarkStyle}">
                <TextBlock x:Name="ServerInitialText" Style="{StaticResource SkylineLoginServerInitialStyle}" />
              </Border>
              <Border x:Name="ServerImageMark" Visibility="Collapsed" Style="{StaticResource SkylineLoginServerMarkStyle}">
                <Border.Background><ImageBrush x:Name="ServerMarkBrush" Stretch="UniformToFill" /></Border.Background>
              </Border>
            </Grid>
            <StackPanel Style="{StaticResource SkylineLoginServerLabelsStyle}">
              <TextBlock x:Name="ServerNameText" Style="{StaticResource SkylineLoginServerNameStyle}" />
              <TextBlock x:Name="ServerAddressText" Style="{StaticResource SkylineLoginServerAddressStyle}" />
            </StackPanel>
            <Border x:Name="SecureBadge" Style="{StaticResource SkylineLoginSecureBadgeStyle}">
              <TextBlock Text="SECURE" Style="{StaticResource SkylineLoginSecurityTextStyle}" />
            </Border>
            <Border x:Name="HttpBadge" Visibility="Collapsed" Style="{StaticResource SkylineLoginHttpBadgeStyle}">
              <TextBlock Text="HTTP" Foreground="{StaticResource SkylineAuthWarning}" Style="{StaticResource SkylineLoginSecurityTextStyle}" />
            </Border>
          </StackPanel>
        </Border>
        <TextBlock x:Name="SignInTitle" Style="{StaticResource SkylineLoginTitleStyle}" />
        <TextBlock x:Name="SignInInstructions" Style="{StaticResource SkylineLoginInstructionsStyle}" />
        <StackPanel x:Name="PhoneHint" Style="{StaticResource SkylineLoginHintRowStyle}">
          <Viewbox Style="{StaticResource SkylineLoginPhoneIconStyle}">
            <Path Data="M17,1H7A2,2 0 0,0 5,3V21A2,2 0 0,0 7,23H17A2,2 0 0,0 19,21V3A2,2 0 0,0 17,1M17,19H7V5H17M13,22H11V20H13Z" Fill="{StaticResource SkylineAuthTertiary}" />
          </Viewbox>
          <TextBlock Text="Have Silo on your phone? Open it on the same Wi‑Fi to sign in this TV." Style="{StaticResource SkylineLoginHintStyle}" />
        </StackPanel>
        <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,20,0,0">
          <TextBox x:Name="UsernameBox" PlaceholderText="Username" InputScope="PersonalFullName" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                   PreventKeyboardDisplayOnProgrammaticFocus="True" Style="{StaticResource SkylineCredentialFieldStyle}" TextChanged="OnUsernameChanged" PreviewKeyDown="OnCredentialPreviewKeyDown" />
          <!-- rail-layout: non-card — TvLoginScreen.kt password field and reveal action. -->
          <ItemsControl x:Name="PasswordRow" Margin="0,10,0,0" PreviewKeyDown="OnCredentialPreviewKeyDown">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <PasswordBox x:Name="PasswordInput" PlaceholderText="Password" PasswordRevealMode="Hidden" PreventKeyboardDisplayOnProgrammaticFocus="True"
                         Style="{StaticResource SkylineCredentialPasswordStyle}" PasswordChanged="OnPasswordChanged" />
            <Button x:Name="RevealButton" Style="{StaticResource SkylineCredentialRevealStyle}" AutomationProperties.Name="Show password" Click="OnRevealClick">
              <Grid>
                <TextBlock x:Name="RevealInk" />
                <Viewbox Width="16" Height="16"><Grid>
                  <Path x:Name="RevealIcon" Fill="{Binding Foreground, ElementName=RevealInk}" Data="M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5S21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5M12,17A5,5 0 1,1 12,7A5,5 0 0,1 12,17M12,9A3,3 0 1,0 12,15A3,3 0 0,0 12,9Z" />
                  <Path x:Name="HideIcon" Visibility="Collapsed" Fill="{Binding Foreground, ElementName=RevealInk}" Data="M2,4.27L4.28,6.55C2.82,8.01 1.69,9.86 1,12C2.73,16.39 7,19.5 12,19.5C13.76,19.5 15.44,19.11 16.96,18.4L19.73,21.17L21.14,19.76L3.41,2.86L2,4.27M12,17A5,5 0 0,1 7,12C7,11.23 7.18,10.5 7.5,9.85L9.06,11.41A3,3 0 0,0 12.59,14.94L14.15,16.5C13.5,16.82 12.77,17 12,17M12,4.5C17,4.5 21.27,7.61 23,12C22.36,13.61 21.36,15.04 20.14,16.18L17.27,13.31C17.42,12.89 17.5,12.45 17.5,12A5.5,5.5 0 0,0 12,6.5C11.55,6.5 11.11,6.58 10.69,6.73L8.57,4.61C9.68,4.29 10.83,4.5 12,4.5Z" />
                </Grid></Viewbox>
              </Grid>
            </Button>
          </ItemsControl>
          <TextBlock x:Name="PasswordError" Style="{StaticResource SkylineServerEntryErrorStyle}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
          <TextBlock x:Name="ProviderHint" Style="{StaticResource SkylineServerEntryHintStyle}" Visibility="Collapsed" />
          <!-- rail-layout: non-card — TvLoginScreen.kt's Sign in and secondary actions. -->
          <ItemsControl x:Name="PasswordActions" Margin="0,20,0,0" PreviewKeyDown="OnPasswordActionsPreviewKeyDown">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="11" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource SkylineAuthButtonStyle}" Click="OnSignInClick" />
            <Button x:Name="UsePhoneButton" Content="Use your phone instead" Style="{StaticResource SkylineAuthPlainButtonStyle}" Click="OnUsePhoneClick" />
            <Button x:Name="PasswordChangeServerButton" Content="Change server" Style="{StaticResource SkylineAuthPlainButtonStyle}" Click="OnChangeServerClick" />
          </ItemsControl>
        </StackPanel>
        <!-- rail-layout: non-card — TvLoginScreen.kt CodeActions, including password sign-in. -->
        <ItemsControl x:Name="CodeActions" Style="{StaticResource SkylineLoginActionsStyle}" PreviewKeyDown="OnCodeActionsPreviewKeyDown">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource SkylineAuthActionGap}" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <Button x:Name="NewCodeButton" Content="Show a new code" Click="OnNewCodeClick" Visibility="Collapsed" Style="{StaticResource SkylineAuthButtonStyle}" />
          <Button x:Name="PasswordButton" Content="Sign in with a password" Click="OnPasswordClick" Style="{StaticResource SkylineAuthButtonStyle}" />
          <Button x:Name="ChangeServerButton" Content="Change server" Click="OnChangeServerClick" Style="{StaticResource SkylineAuthPlainButtonStyle}" />
        </ItemsControl>
      </StackPanel>
      </ScrollViewer>
      <Border x:Name="PhoneHelpCard" Grid.Column="2" Style="{StaticResource SkylineLoginCardStyle}" Visibility="Collapsed">
        <StackPanel Spacing="18">
          <TextBlock Text="Use your phone" Style="{StaticResource SkylineServerListTitleStyle}" />
          <TextBlock x:Name="PhoneHelpText" Style="{StaticResource SkylineHttpDialogMessageStyle}" />
        </StackPanel>
      </Border>
      <Border x:Name="CodeCard" Grid.Column="2" Style="{StaticResource SkylineLoginCardStyle}">
        <StackPanel HorizontalAlignment="Center">
          <StackPanel x:Name="CodeDetails">
            <Border Style="{StaticResource SkylineLoginQrFrameStyle}">
              <Grid>
                <Image x:Name="QrImage" Style="{StaticResource SkylineLoginQrImageStyle}" AutomationProperties.Name="Scan to sign in on your phone" />
                <ProgressRing x:Name="CodeLoadingRing" IsActive="True" Style="{StaticResource SkylineLoginLoadingRingStyle}" />
                <TextBlock x:Name="QrFallback" Text="Use the address&#x0A;and code below" Visibility="Collapsed" Style="{StaticResource SkylineLoginQrFallbackStyle}" />
              </Grid>
            </Border>
            <!-- TvMarqueeCodeTiles: grouped tabular digits, shrinking long codes to fit. -->
            <Viewbox Style="{StaticResource SkylineLoginCodeBoxStyle}">
              <TextBlock x:Name="CodeText" Style="{StaticResource SkylineLoginCodeStyle}" Typography.NumeralAlignment="Tabular" Typography.SlashedZero="True" />
            </Viewbox>
            <TextBlock x:Name="ActivateText" Style="{StaticResource SkylineLoginActivateStyle}" />
          </StackPanel>
          <Viewbox x:Name="CodeProblemIcon" Visibility="Collapsed" Style="{StaticResource SkylineLoginProblemSymbolStyle}">
            <Path Data="M11,15H13V17H11M11,7H13V13H11M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z" Fill="{StaticResource SkylineAuthWarning}" />
          </Viewbox>
          <Viewbox x:Name="CodeApprovedIcon" Visibility="Collapsed" Style="{StaticResource SkylineLoginApprovedSymbolStyle}">
            <Path Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59Z" Fill="{StaticResource SkylineAuthLive}" />
          </Viewbox>
          <!-- TvLoginScreen.kt CodeCard: Opened replaces Waiting with Continue on your phone. -->
          <StackPanel Style="{StaticResource SkylineLoginStatusRowStyle}">
            <ProgressRing x:Name="PairingRing" IsActive="True" Style="{StaticResource SkylineLoginStatusRingStyle}" />
            <TextBlock x:Name="PairingStatus" Text="Getting a sign-in code…" Style="{StaticResource SkylineLoginStatusStyle}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="PairingError" Visibility="Collapsed" Style="{StaticResource SkylineLoginErrorStatusStyle}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
  <controls:ConnectionDialog x:Name="HttpPrompt" />
  </Grid>
</Page>
