<!--
  Skyline: the design system of Silo's TV apps (silo-apple docs/skyline-design-guide.md, and
  silo-android androidTvApp ui/theme). Guide values are 1920x1080 mockup pixels; Xbox lays out at
  960x540 effective pixels, so every size here is the guide's value halved, the same mapping
  Android TV uses. Keep this file the only place sizes and colors are defined.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colors (guide §4): OLED black, monochrome white-at-opacity, no chromatic accent. -->
  <Color x:Key="SkylineBackgroundColor">#FF000000</Color>
  <Color x:Key="SkylinePrimaryColor">#FFEDEDED</Color>
  <SolidColorBrush x:Key="SkylineBackground" Color="#FF000000" />
  <SolidColorBrush x:Key="SkylineSurface" Color="#FF0A0A0A" />
  <SolidColorBrush x:Key="SkylineSurfaceElevated" Color="#FF15171C" />
  <SolidColorBrush x:Key="SkylinePrimary" Color="#FFEDEDED" />
  <!-- 75% rather than the guide's 60%: Silo raised it for 10-foot legibility (Color.kt, 2026-07-20). -->
  <SolidColorBrush x:Key="SkylineSecondary" Color="#BFEDEDED" />
  <SolidColorBrush x:Key="SkylineTertiary" Color="#61EDEDED" />
  <SolidColorBrush x:Key="SkylineHairline" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="SkylineChromeSelected" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="SkylineChromeSelectedBorder" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="SkylineChromeResting" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="SkylineTabResting" Color="#9EFFFFFF" />
  <SolidColorBrush x:Key="SkylineGlassStrong" Color="#DB16171B" />
  <SolidColorBrush x:Key="SkylineScrimDropdown" Color="#8C000000" />
  <SolidColorBrush x:Key="SkylineCardPlaceholder" Color="#FF15171C" />
  <SolidColorBrush x:Key="SkylineProgressTrack" Color="#42FFFFFF" />
  <SolidColorBrush x:Key="SkylineMarqueeTick" Color="#D9FFFFFF" />
  <SolidColorBrush x:Key="SkylineError" Color="#FFFF8A80" />

  <!-- Geometry (guide §4, §5). -->
  <x:Double x:Key="SkylineSafeAreaX">44</x:Double>
  <Thickness x:Key="SkylineRowInset">44,0,44,0</Thickness>
  <CornerRadius x:Key="SkylineCardRadius">6</CornerRadius>
  <CornerRadius x:Key="SkylinePanelRadius">11</CornerRadius>
  <CornerRadius x:Key="SkylineRowRadius">7</CornerRadius>
  <CornerRadius x:Key="SkylinePill">999</CornerRadius>

  <!-- Type ramp (guide §4.1), halved. Platform system font (Segoe UI on Xbox). -->
  <x:Double x:Key="SkylineWordmarkSize">13</x:Double>
  <x:Double x:Key="SkylineTabSize">11.5</x:Double>
  <x:Double x:Key="SkylinePillSize">9.5</x:Double>
  <x:Double x:Key="SkylineEyebrowSize">8.5</x:Double>
  <x:Double x:Key="SkylineMarqueeTitleSize">42</x:Double>
  <x:Double x:Key="SkylineMarqueeTitleCompactSize">33</x:Double>
  <x:Double x:Key="SkylineMetaSize">10</x:Double>
  <x:Double x:Key="SkylineSynopsisSize">11</x:Double>
  <x:Double x:Key="SkylineButtonSize">11.5</x:Double>
  <x:Double x:Key="SkylineRowTitleSize">15</x:Double>
  <x:Double x:Key="SkylineCardTitleSize">10</x:Double>
  <x:Double x:Key="SkylineCardSubtitleSize">8.5</x:Double>
  <x:Double x:Key="SkylineDropdownRowSize">11</x:Double>
  <x:Double x:Key="SkylineDropdownHeaderSize">7</x:Double>
  <x:Double x:Key="SkylineScreenTitleSize">21</x:Double>
  <x:Double x:Key="SkylineBodySize">11</x:Double>
  <FontFamily x:Key="SkylineMono">Consolas</FontFamily>

  <!--
    Capsule control used for top-bar tabs, pills and buttons. Resting: label at 62% white, no fill.
    Focused: inverted to a white capsule with black label (guide §5.1). No system focus rectangle:
    the inversion is the focus cue.
  -->
  <Style x:Key="SkylineCapsuleStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource SkylineTabResting}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="13,5.5" />
    <Setter Property="FontSize" Value="{StaticResource SkylineTabSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylinePill}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Capsule" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <Border.BackgroundTransition>
              <BrushTransition Duration="0:0:0.12" />
            </Border.BackgroundTransition>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Opacity" Value="0.85" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Background" Value="{StaticResource SkylinePrimary}" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylineBackground}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!--
    Top-bar tab (guide §5.1) as a ToggleButton. Content must be a string (a label or an icon glyph),
    never an element: the template shows it in two presenters.: Checked = the selected destination (chrome.selected
    capsule, full-white label); Focused = inverted white capsule with black label. The two looks use
    separate layers so the Checked and Focus state groups never fight over one property.
  -->
  <Style x:Key="SkylineTabStyle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource SkylineTabResting}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="13,5.5" />
    <Setter Property="FontSize" Value="{StaticResource SkylineTabSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="SelectedFill" CornerRadius="{StaticResource SkylinePill}" Background="{StaticResource SkylineChromeSelected}"
                    BorderBrush="{StaticResource SkylineChromeSelectedBorder}" BorderThickness="0.5" Opacity="0" />
            <Border x:Name="FocusFill" CornerRadius="{StaticResource SkylinePill}" Background="{StaticResource SkylinePrimary}" Opacity="0">
              <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.12" />
              </Border.OpacityTransition>
            </Border>
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              FontFamily="{TemplateBinding FontFamily}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <ContentPresenter x:Name="FocusedContent" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              Foreground="{StaticResource SkylineBackground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              FontFamily="{TemplateBinding FontFamily}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Opacity="0" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectedFill.Opacity" Value="1" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylinePrimary}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="SelectedFill.Opacity" Value="1" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylinePrimary}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="SelectedFill.Opacity" Value="1" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylinePrimary}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="IndeterminatePointerOver" />
                <VisualState x:Name="IndeterminatePressed" />
                <VisualState x:Name="IndeterminateDisabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusFill.Opacity" Value="1" />
                    <Setter Target="Content.Opacity" Value="0" />
                    <Setter Target="FocusedContent.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons on full screens (sign-in, dialogs): resting white @ 7% with a hairline, inverts on focus. -->
  <Style x:Key="SkylineButtonStyle" TargetType="Button" BasedOn="{StaticResource SkylineCapsuleStyle}">
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="Background" Value="{StaticResource SkylineChromeResting}" />
    <Setter Property="BorderBrush" Value="{StaticResource SkylineHairline}" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="Padding" Value="18,7" />
    <Setter Property="FontSize" Value="{StaticResource SkylineButtonSize}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- Rows in anchored panels (library cascade, profile dropdown): left-aligned, invert on focus. -->
  <Style x:Key="SkylinePanelRowStyle" TargetType="Button" BasedOn="{StaticResource SkylineCapsuleStyle}">
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylineRowRadius}" />
    <Setter Property="Padding" Value="9,8" />
    <Setter Property="FontSize" Value="{StaticResource SkylineDropdownRowSize}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!-- Card containers in rows and grids. Focus = scale 1.05 (done in code) + 1 px white ring + lift. -->
  <Style x:Key="SkylineCardItemStyle" TargetType="ListViewItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,12,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-1" />
    <Setter Property="FocusVisualPrimaryThickness" Value="1" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource SkylinePrimary}" />
  </Style>

  <Style x:Key="SkylineGridItemStyle" TargetType="GridViewItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,12,14" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualMargin" Value="-1" />
    <Setter Property="FocusVisualPrimaryThickness" Value="1" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource SkylinePrimary}" />
  </Style>

  <Style x:Key="SkylineTextBoxStyle" TargetType="TextBox">
    <Setter Property="FontSize" Value="{StaticResource SkylineBodySize}" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylineRowRadius}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource SkylinePrimary}" />
  </Style>
</ResourceDictionary>
