<!--
  Silo TV design, as Silo's Android TV app draws it (silo-android androidTvApp ui/theme and
  ui/components). Navigation follows Skyline (silo-apple docs/skyline-design-guide.md); sizes and
  look follow the Android TV code. Xbox lays out at 960x540 effective pixels, the same canvas as
  Android TV's dp, so geometry maps 1:1 and text is the Android sp value x 0.86 (TvUiFontScale).
  Keep this file the only place sizes and colors are defined, and never look these resources up
  from code: under Native AOT that throws, so pages reference them from XAML only.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Typeface: Inter, as bundled by the Android apps (OFL, see THIRD_PARTY_NOTICES.md). -->
  <FontFamily x:Key="SkylineFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
  <FontFamily x:Key="SkylineMono">Consolas</FontFamily>

  <!-- Colors (Color.kt). Monochrome white-at-opacity; the page tint comes from the focused art. -->
  <SolidColorBrush x:Key="SkylineBackground" Color="#FF000000" />
  <SolidColorBrush x:Key="SkylineSurfaceElevated" Color="#FF15171C" />
  <SolidColorBrush x:Key="SkylinePrimary" Color="#FFEDEDED" />
  <SolidColorBrush x:Key="SkylineSecondary" Color="#BFEDEDED" />
  <SolidColorBrush x:Key="SkylineTertiary" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="SkylineCaptionTitle" Color="#C7FFFFFF" />
  <SolidColorBrush x:Key="SkylineCaptionSubtitle" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="SkylineHairline" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="SkylineChromeSelected" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="SkylineChromeSelectedBorder" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="SkylineChromeResting" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="SkylineTabResting" Color="#A6FFFFFF" />
  <SolidColorBrush x:Key="SkylineGlassStrong" Color="#DB16171B" />
  <SolidColorBrush x:Key="SkylineScrimDropdown" Color="#8C000000" />
  <SolidColorBrush x:Key="SkylineCardPlaceholder" Color="#FF15171C" />
  <SolidColorBrush x:Key="SkylineProgressTrack" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="SkylineFocusRing" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SkylineFocusGlow" Color="#47FFFFFF" />
  <SolidColorBrush x:Key="SkylineBadgeFill" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="SkylineBadgeBorder" Color="#3DFFFFFF" />
  <SolidColorBrush x:Key="SkylineBadgeText" Color="#EBFFFFFF" />
  <SolidColorBrush x:Key="SkylineError" Color="#FFFF8A80" />

  <!-- First-run screens: the "plum night" Aurora backdrop (TvAuroraBackdrop.kt). -->
  <LinearGradientBrush x:Key="SkylineAurora" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FF1C1329" Offset="0" />
    <GradientStop Color="#FF0D0A17" Offset="0.55" />
    <GradientStop Color="#FF070509" Offset="1" />
  </LinearGradientBrush>

  <!-- Geometry (Spacing.kt, RowDimens, TvSkyline). -->
  <CornerRadius x:Key="SkylineCardRadius">8</CornerRadius>
  <CornerRadius x:Key="SkylineFocusRingRadius">11</CornerRadius>
  <CornerRadius x:Key="SkylineFocusGlowRadius">14</CornerRadius>
  <CornerRadius x:Key="SkylinePanelRadius">12</CornerRadius>
  <CornerRadius x:Key="SkylineRowRadius">8</CornerRadius>
  <CornerRadius x:Key="SkylineBadgeRadius">3</CornerRadius>
  <CornerRadius x:Key="SkylinePill">999</CornerRadius>

  <!-- Type (Type.kt and component sizes, x 0.86). -->
  <x:Double x:Key="SkylineWordmarkSize">13</x:Double>
  <x:Double x:Key="SkylineTabSize">12.9</x:Double>
  <x:Double x:Key="SkylinePillSize">11.2</x:Double>
  <x:Double x:Key="SkylineMarqueeTitleSize">37.8</x:Double>
  <x:Double x:Key="SkylineMarqueeTitleLine">43.5</x:Double>
  <x:Double x:Key="SkylineMarqueeTitleCompactSize">30</x:Double>
  <x:Double x:Key="SkylineMetaSize">12</x:Double>
  <x:Double x:Key="SkylineSynopsisSize">13.8</x:Double>
  <x:Double x:Key="SkylineSynopsisLine">18.6</x:Double>
  <x:Double x:Key="SkylineBadgeSize">9</x:Double>
  <x:Double x:Key="SkylineRowTitleSize">15.5</x:Double>
  <x:Double x:Key="SkylineCardTitleSize">13.3</x:Double>
  <x:Double x:Key="SkylineCardSubtitleSize">12</x:Double>
  <x:Double x:Key="SkylineCardOverlaySize">11.5</x:Double>
  <x:Double x:Key="SkylineDropdownRowSize">13</x:Double>
  <x:Double x:Key="SkylineDropdownHeaderSize">9</x:Double>
  <x:Double x:Key="SkylineScreenTitleSize">31</x:Double>
  <x:Double x:Key="SkylineBodySize">13.8</x:Double>
  <x:Double x:Key="SkylineButtonSize">13</x:Double>

  <!--
    Capsule control for buttons and pills. Focused inverts to a white capsule with a black label.
    No system focus rectangle: the inversion is the focus cue. No implicit transitions inside
    templates: on the console they crashed the first layout.
  -->
  <Style x:Key="SkylineCapsuleStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource SkylineTabResting}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14.5,6" />
    <Setter Property="FontSize" Value="{StaticResource SkylineTabSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylinePill}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Capsule" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Opacity" Value="0.85" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Background" Value="{StaticResource SkylinePrimary}" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylineBackground}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Top-bar tab as a ToggleButton: Checked = the selected destination (chrome.selected capsule,
    full-white label); Focused = inverted white capsule, black label. Content must be a string (a
    label or an icon glyph), never an element: the template shows it in two presenters.
  -->
  <Style x:Key="SkylineTabStyle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource SkylineTabResting}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="14.5,6" />
    <Setter Property="FontSize" Value="{StaticResource SkylineTabSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="SelectedFill" CornerRadius="{StaticResource SkylinePill}" Background="{StaticResource SkylineChromeSelected}"
                    BorderBrush="{StaticResource SkylineChromeSelectedBorder}" BorderThickness="0.5" Opacity="0" />
            <Border x:Name="FocusFill" CornerRadius="{StaticResource SkylinePill}" Background="{StaticResource SkylinePrimary}" Opacity="0" />
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              FontFamily="{TemplateBinding FontFamily}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <ContentPresenter x:Name="FocusedContent" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              Foreground="{StaticResource SkylineBackground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              FontFamily="{TemplateBinding FontFamily}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Opacity="0" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectedFill.Opacity" Value="1" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylinePrimary}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="SelectedFill.Opacity" Value="1" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylinePrimary}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="SelectedFill.Opacity" Value="1" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylinePrimary}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="IndeterminatePointerOver" />
                <VisualState x:Name="IndeterminatePressed" />
                <VisualState x:Name="IndeterminateDisabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusFill.Opacity" Value="1" />
                    <Setter Target="Content.Opacity" Value="0" />
                    <Setter Target="FocusedContent.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons on full screens (sign-in): resting white @ 8% with a hairline, inverts on focus. -->
  <Style x:Key="SkylineButtonStyle" TargetType="Button" BasedOn="{StaticResource SkylineCapsuleStyle}">
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="Background" Value="{StaticResource SkylineChromeResting}" />
    <Setter Property="BorderBrush" Value="{StaticResource SkylineHairline}" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="FontSize" Value="{StaticResource SkylineButtonSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Rows in anchored panels (library panel, profile dropdown): left-aligned, invert on focus. -->
  <Style x:Key="SkylinePanelRowStyle" TargetType="Button" BasedOn="{StaticResource SkylineCapsuleStyle}">
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylineRowRadius}" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="FontSize" Value="{StaticResource SkylineDropdownRowSize}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!--
    Card containers. Focus is drawn by the card template's FocusRing/FocusGlow (2 px white ring
    and soft glow, rounded like the card) plus a 1.10 lift, set from code (CardFocus).
  -->
  <Style x:Key="SkylineCardItemStyle" TargetType="ListViewItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,20,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style x:Key="SkylineGridItemStyle" TargetType="GridViewItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,20,16" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style x:Key="SkylineTextBoxStyle" TargetType="TextBox">
    <Setter Property="FontSize" Value="{StaticResource SkylineBodySize}" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylineRowRadius}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource SkylinePrimary}" />
  </Style>

  <!-- Outlined marquee badge (TvFocusMarquee.MarqueeBadge): "4K", "HDR", "EAC3", "TV-MA". -->
  <Style x:Key="SkylineBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SkylineBadgeFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource SkylineBadgeBorder}" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylineBadgeRadius}" />
    <Setter Property="Padding" Value="6,2.5" />
  </Style>
</ResourceDictionary>
