root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,targets,pubxml,appxmanifest,xaml,slnx}]
indent_size = 2

[*.sh]
indent_size = 2

[src/Bale.Core/Api/**.cs]
generated_code = true
