<Page
    x:Class="Bale.Xbox.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    xmlns:services="using:Bale.Xbox.Services"
    NavigationCacheMode="Required"
    Background="{StaticResource SkylineBackground}">

  <Page.Resources>
    <DataTemplate x:Key="LibrarySectionTemplate" x:DataType="views:LibrarySectionChoiceView">
      <Button Style="{StaticResource SkylineLibrarySectionRowStyle}" Click="OnLibrarySectionClick">
        <!-- shell/TvLibraryPill.kt: Material AutoAwesome, GridView and Collections glyphs. -->
        <StackPanel Style="{StaticResource SkylineLibrarySectionContentStyle}">
          <Viewbox Style="{StaticResource SkylineLibrarySectionIconStyle}">
            <Grid Width="24" Height="24">
              <Path Style="{StaticResource SkylineLibrarySectionGlyphStyle}" Visibility="{x:Bind RecommendedVisibility}" Data="M19,9 L20.25,6.25 L23,5 L20.25,3.75 L19,1 L17.75,3.75 L15,5 L17.75,6.25 Z M11,9 L8.5,3 L6,9 L0,11.5 L6,14 L8.5,20 L11,14 L17,11.5 Z M19,15 L17.75,17.75 L15,19 L17.75,20.25 L19,23 L20.25,20.25 L23,19 L20.25,17.75 Z" />
              <Path Style="{StaticResource SkylineLibrarySectionGlyphStyle}" Visibility="{x:Bind BrowseVisibility}" Data="M3,3 H11 V11 H3 Z M13,3 H21 V11 H13 Z M3,13 H11 V21 H3 Z M13,13 H21 V21 H13 Z" />
              <Path Style="{StaticResource SkylineLibrarySectionGlyphStyle}" Visibility="{x:Bind CollectionsVisibility}" Data="M22,16 V4 C22,2.9 21.1,2 20,2 H8 C6.9,2 6,2.9 6,4 V16 C6,17.1 6.9,18 8,18 H20 C21.1,18 22,17.1 22,16 Z M11,12 L13.03,14.71 L16,11 L20,16 H8 Z M2,6 V20 C2,21.1 2.9,22 4,22 H18 V20 H4 V6 Z" />
            </Grid>
          </Viewbox>
          <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="LibraryFlyoutTemplate" x:DataType="views:LibrarySectionChoiceView">
      <Button Style="{StaticResource SkylineLibraryFlyoutRowStyle}" Click="OnLibrarySectionClick">
        <StackPanel Style="{StaticResource SkylineLibraryFlyoutContentStyle}">
          <Viewbox Style="{StaticResource SkylineLibraryFlyoutIconStyle}">
            <Grid Width="24" Height="24">
              <Path Style="{StaticResource SkylineLibrarySectionGlyphStyle}" Visibility="{x:Bind RecommendedVisibility}" Data="M19,9 L20.25,6.25 L23,5 L20.25,3.75 L19,1 L17.75,3.75 L15,5 L17.75,6.25 Z M11,9 L8.5,3 L6,9 L0,11.5 L6,14 L8.5,20 L11,14 L17,11.5 Z M19,15 L17.75,17.75 L15,19 L17.75,20.25 L19,23 L20.25,20.25 L23,19 L20.25,17.75 Z" />
              <Path Style="{StaticResource SkylineLibrarySectionGlyphStyle}" Visibility="{x:Bind BrowseVisibility}" Data="M3,3 H11 V11 H3 Z M13,3 H21 V11 H13 Z M3,13 H11 V21 H3 Z M13,13 H21 V21 H13 Z" />
              <Path Style="{StaticResource SkylineLibrarySectionGlyphStyle}" Visibility="{x:Bind CollectionsVisibility}" Data="M22,16 V4 C22,2.9 21.1,2 20,2 H8 C6.9,2 6,2.9 6,4 V16 C6,17.1 6.9,18 8,18 H20 C21.1,18 22,17.1 22,16 Z M11,12 L13.03,14.71 L16,11 L20,16 H8 Z M2,6 V20 C2,21.1 2.9,22 4,22 H18 V20 H4 V6 Z" />
            </Grid>
          </Viewbox>
          <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Page.Resources>

  <!-- Root screens (Home, library tabs, Search) live in ContentFrame under the Skyline top bar (guide §5.1). -->
  <Grid x:Name="Root">
    <services:PageFrame x:Name="ContentFrame" />

    <!-- Library previews retain their scrim; TvMainShell.kt's profile dropdown has none. -->
    <Rectangle x:Name="PanelScrim" Fill="{StaticResource SkylineScrimDropdown}" Visibility="Collapsed" IsHitTestVisible="False" />

    <Grid x:Name="TopBar" Margin="44,28,44,0" Height="32" VerticalAlignment="Top">
      <Grid.OpacityTransition>
        <ScalarTransition Duration="0:0:0.2" />
      </Grid.OpacityTransition>
      <TextBlock Text="BALE" FontSize="{StaticResource SkylineWordmarkSize}" FontWeight="Black" CharacterSpacing="340"
                 Foreground="{StaticResource SkylinePrimary}" VerticalAlignment="Center" HorizontalAlignment="Left" />
      <!-- Center cluster (TvTopMenuBar): Search just left of Home, the tabs, and an invisible twin of the
           search icon after them so the tabs themselves stay centered on screen. -->
      <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center" XYFocusKeyboardNavigation="Enabled">
        <Button x:Name="SearchButton" Style="{StaticResource SkylineBarIconStyle}" Click="OnSearchClick" Content="&#xE721;"
                AutomationProperties.Name="Search" VerticalAlignment="Center" />
        <!-- rail-layout: non-card — Top navigation tabs. -->
        <ItemsControl x:Name="Tabs" VerticalAlignment="Center" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:TabView">
              <ToggleButton Content="{x:Bind Title}" Style="{StaticResource SkylineTabStyle}" Click="OnTabClick" GotFocus="OnTabFocus" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Width="28" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="11" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="AvatarButton" Style="{StaticResource SkylineAvatarStyle}" Click="OnAvatarClick" AutomationProperties.Name="Profile">
          <Grid Width="28" Height="28">
            <TextBlock x:Name="AvatarInitial" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <!-- An Ellipse with an ImageBrush: a reliably round crop of the profile picture. -->
            <Ellipse x:Name="AvatarPicture" Visibility="Collapsed" />
          </Grid>
        </Button>
      </StackPanel>
    </Grid>

    <!-- TvMainShell.kt: top-center at 92dp, above content but below the cascade overlays. -->
    <Button x:Name="OfflinePill" Style="{StaticResource SkylineOfflinePillStyle}" Visibility="Collapsed" Click="OnOfflineRetryClick">
      <TextBlock Text="Offline mode - select to retry" Style="{StaticResource SkylineOfflinePillTextStyle}" />
    </Button>

    <!-- Cascading library selector, level 1 (guide §5.3): anchored under the focused tab. -->
    <Border x:Name="LibraryPanel" Width="230" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,66,0,0" Padding="7"
            Background="{StaticResource SkylineGlassStrong}" CornerRadius="{StaticResource SkylinePanelRadius}" Visibility="Collapsed">
      <StackPanel Spacing="2">
        <TextBlock x:Name="LibraryPanelHeader" Style="{StaticResource SkylineLibraryCascadeHeaderStyle}" />
        <ScrollViewer x:Name="LibraryListScroller" MaxHeight="180" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" IsTabStop="False">
        <ItemsControl x:Name="LibraryRows" IsTabStop="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:LibraryChoiceView">
              <Button Style="{StaticResource SkylineLibrarySectionRowStyle}" Click="OnLibraryRowClick" GotFocus="OnLibraryChoiceFocus" Margin="0,1">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                  <FontIcon Grid.Column="1" Glyph="{x:Bind Trailing}" FontSize="10" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
        <ItemsControl x:Name="SingleLibrarySections" IsTabStop="False" ItemTemplate="{StaticResource LibrarySectionTemplate}" Visibility="Collapsed" />
        <Rectangle Height="0.5" Fill="#1FFFFFFF" Margin="6,3,6,0" />
        <TextBlock x:Name="LibraryFooterHint" Style="{StaticResource SkylineLibraryCascadeFooterStyle}" />
      </StackPanel>
    </Border>

    <!-- TvCascadeSelector.kt: a separate 150dp flyout, 9dp right of its anchored library row. -->
    <Border x:Name="LibrarySectionPanel" Width="150" Padding="5" CornerRadius="9" Background="{StaticResource SkylineGlassStrong}"
            HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
      <StackPanel Spacing="2">
        <TextBlock x:Name="LibrarySectionHeader" Style="{StaticResource SkylineLibraryCascadeHeaderStyle}" Margin="7,3,7,4" />
        <ItemsControl x:Name="LibrarySectionRows" IsTabStop="False" ItemTemplate="{StaticResource LibraryFlyoutTemplate}" />
      </StackPanel>
    </Border>

    <!-- TvCascadeSelector.kt / TvForYouSelector: Recommendations, Favorites, Watchlist. -->
    <views:ForYouSelector x:Name="ForYouPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,66,0,0" Visibility="Collapsed" />

    <!-- TvMainShell.kt: no page scrim, and directional focus stays inside this dropdown. -->
    <Border x:Name="ProfilePanel" Style="{StaticResource SkylineProfilePanelStyle}" Visibility="Collapsed">
      <StackPanel Spacing="2">
        <Grid Margin="16,6" ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="32" Height="32" CornerRadius="16" Background="#29FFFFFF">
            <Grid>
              <TextBlock x:Name="PanelInitial" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Ellipse x:Name="PanelPicture" Visibility="Collapsed" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="PanelProfileName" FontSize="12.9" LineHeight="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PanelServer" FontSize="11.2" LineHeight="13.8" Foreground="#61EDEDED" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Grid>
        <Rectangle Height="1" Fill="#1AFFFFFF" Margin="12,4" />
        <Button x:Name="SwitchProfileRow" Style="{StaticResource SkylineProfileMenuRowStyle}" Click="OnSwitchProfileClick" GotFocus="OnProfileRowFocus" LostFocus="OnProfileRowBlur">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Viewbox Style="{StaticResource SkylineProfileMenuIconStyle}"><Path Style="{StaticResource SkylineProfileMenuIconPathStyle}" Data="M16,11 C17.66,11 18.99,9.66 18.99,8 C18.99,6.34 17.66,5 16,5 C14.34,5 13,6.34 13,8 C13,9.66 14.34,11 16,11 Z M8,11 C9.66,11 10.99,9.66 10.99,8 C10.99,6.34 9.66,5 8,5 C6.34,5 5,6.34 5,8 C5,9.66 6.34,11 8,11 Z M8,13 C5.67,13 1,14.17 1,16.5 V19 H15 V16.5 C15,14.17 10.33,13 8,13 Z M16,13 C15.71,13 15.38,13.02 15.03,13.05 C16.19,13.89 17,15.02 17,16.5 V19 H23 V16.5 C23,14.17 18.33,13 16,13 Z" /></Viewbox>
            <TextBlock Text="Switch Profile" Style="{StaticResource SkylineProfileMenuLabelStyle}" />
          </StackPanel>
        </Button>
        <Button x:Name="WatchlistRow" Tag="watchlist" Style="{StaticResource SkylineProfileMenuRowStyle}" Click="OnPersonalListClick" GotFocus="OnProfileRowFocus" LostFocus="OnProfileRowBlur">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Viewbox Style="{StaticResource SkylineProfileMenuIconStyle}"><Path Style="{StaticResource SkylineProfileMenuIconPathStyle}" Data="M17,3 H7 C5.9,3 5,3.9 5,5 V21 L12,18 L19,21 V5 C19,3.9 18.1,3 17,3 Z" /></Viewbox>
            <TextBlock Text="Watchlist" Style="{StaticResource SkylineProfileMenuLabelStyle}" />
          </StackPanel>
        </Button>
        <Button x:Name="FavoritesRow" Tag="favorites" Style="{StaticResource SkylineProfileMenuRowStyle}" Click="OnPersonalListClick" GotFocus="OnProfileRowFocus" LostFocus="OnProfileRowBlur">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Viewbox Style="{StaticResource SkylineProfileMenuIconStyle}"><Path Style="{StaticResource SkylineProfileMenuIconPathStyle}" Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 Z" /></Viewbox>
            <TextBlock Text="Favorites" Style="{StaticResource SkylineProfileMenuLabelStyle}" />
          </StackPanel>
        </Button>
        <Button x:Name="HistoryRow" Tag="history" Style="{StaticResource SkylineProfileMenuRowStyle}" Click="OnPersonalListClick" GotFocus="OnProfileRowFocus" LostFocus="OnProfileRowBlur">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Viewbox Style="{StaticResource SkylineProfileMenuIconStyle}"><Path Style="{StaticResource SkylineProfileMenuIconPathStyle}" Data="M13,3 C8.03,3 4,7.03 4,12 H1 L4.89,15.89 L4.96,16.03 L9,12 H6 C6,8.13 9.13,5 13,5 C16.87,5 20,8.13 20,12 C20,15.87 16.87,19 13,19 C11.07,19 9.32,18.21 8.06,16.94 L6.64,18.36 C8.27,19.99 10.51,21 13,21 C17.97,21 22,16.97 22,12 C22,7.03 17.97,3 13,3 Z M12,8 V13 L16.28,15.54 L17,14.33 L13.5,12.25 V8 Z" /></Viewbox>
            <TextBlock Text="History" Style="{StaticResource SkylineProfileMenuLabelStyle}" />
          </StackPanel>
        </Button>
        <!-- Settings has no Bale page yet; do not advertise a placeholder destination. -->
        <Rectangle Height="1" Fill="#1AFFFFFF" Margin="12,4" />
        <Button x:Name="SwitchServerRow" Style="{StaticResource SkylineProfileMenuRowStyle}" Click="OnSwitchServerClick" GotFocus="OnProfileRowFocus" LostFocus="OnProfileRowBlur">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Viewbox Style="{StaticResource SkylineProfileMenuIconStyle}"><Path Style="{StaticResource SkylineProfileMenuIconPathStyle}" Data="M20,13 H4 C2.9,13 2,13.9 2,15 V19 C2,20.1 2.9,21 4,21 H20 C21.1,21 22,20.1 22,19 V15 C22,13.9 21.1,13 20,13 Z M6,19 C4.9,19 4,18.1 4,17 C4,15.9 4.9,15 6,15 C7.1,15 8,15.9 8,17 C8,18.1 7.1,19 6,19 Z M20,3 H4 C2.9,3 2,3.9 2,5 V9 C2,10.1 2.9,11 4,11 H20 C21.1,11 22,10.1 22,9 V5 C22,3.9 21.1,3 20,3 Z M6,9 C4.9,9 4,8.1 4,7 C4,5.9 4.9,5 6,5 C7.1,5 8,5.9 8,7 C8,8.1 7.1,9 6,9 Z" /></Viewbox>
            <TextBlock Text="Switch Server" Style="{StaticResource SkylineProfileMenuLabelStyle}" />
          </StackPanel>
        </Button>
        <Button x:Name="SignOutRow" Style="{StaticResource SkylineProfileMenuRowStyle}" Click="OnSignOutClick" GotFocus="OnProfileRowFocus" LostFocus="OnProfileRowBlur">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Viewbox Style="{StaticResource SkylineProfileMenuIconStyle}"><Path Style="{StaticResource SkylineProfileMenuIconPathStyle}" Data="M17,7 L15.59,8.41 L18.17,11 H8 V13 H18.17 L15.59,15.58 L17,17 L22,12 Z M4,5 H12 V3 H4 C2.89,3 2,3.9 2,5 V19 C2,20.1 2.89,21 4,21 H12 V19 H4 Z" /></Viewbox>
            <TextBlock Text="Sign Out" Style="{StaticResource SkylineProfileMenuLabelStyle}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </Grid>
</Page>
