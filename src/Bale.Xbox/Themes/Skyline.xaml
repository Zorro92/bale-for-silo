  <Style x:Key="SkylineCalendarSegmentStyle" TargetType="ToggleButton" BasedOn="{StaticResource SkylineFilterChipStyle}">
    <Setter Property="Height" Value="24.62" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Foreground" Value="{StaticResource SkylineTertiary}" />
    <Setter Property="FontSize" Value="12.04" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <!-- Like SkylineFilterChipStyle, separate selection/focus layers avoid state-group collisions.
               Content is a string, never a visual: it is presented in all three layers. -->
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="Lift" /></Grid.RenderTransform>
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" VerticalContentAlignment="Center" />
            <Grid x:Name="CheckedLayer" Opacity="0">
              <Border CornerRadius="12.31" Background="{StaticResource SkylineCalendarSelectedFill}" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{StaticResource SkylineBackground}"
                                FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" VerticalContentAlignment="Center" />
            </Grid>
            <Grid x:Name="FocusLayer" Opacity="0">
              <Border CornerRadius="12.31" Background="{StaticResource SkylinePrimary}" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{StaticResource SkylineBackground}"
                                FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold" VerticalContentAlignment="Center" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Pressed" /><VisualState x:Name="Disabled" />
                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="CheckedLayer.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="CheckedLayer.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="CheckedLayer.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="CheckedDisabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters><Setter Target="FocusLayer.Opacity" Value="1" /></VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.12" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused" /><VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

