<Page
    x:Class="Bale.Xbox.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    xmlns:services="using:Bale.Xbox.Services"
    Background="{StaticResource SkylineBackground}">

  <Page.Resources>
    <DataTemplate x:Key="BadgeTemplate" x:DataType="views:BadgeView">
      <Border Background="#99000000" BorderBrush="#26FFFFFF" BorderThickness="{x:Bind Border}" CornerRadius="{x:Bind Radius}"
              Padding="{x:Bind Padding}" HorizontalAlignment="Left" Margin="0,0,0,1">
        <TextBlock Text="{x:Bind Text}" FontSize="{x:Bind FontSize}" FontWeight="SemiBold" CharacterSpacing="55" Foreground="#FFFFFFFF" />
      </Border>
    </DataTemplate>

    <!-- TvMediaCard / TvEpisodeCard: rounded art, caption underneath, ring + glow on focus (drawn by CardFocus).
         OneWay bindings let TvHomeScreen.kt's quiet resume refresh update surviving cards in place. -->
    <DataTemplate x:Key="CardTemplate" x:DataType="views:CardView">
      <StackPanel Width="{x:Bind Width, Mode=OneWay}" Spacing="{x:Bind CaptionSpacing, Mode=OneWay}">
        <!-- Art lifts on focus with its ring; the caption below stays put. -->
        <Grid x:Name="Art" Width="{x:Bind Width, Mode=OneWay}" Height="{x:Bind Height, Mode=OneWay}">
          <Grid CornerRadius="{StaticResource SkylineCardRadius}" Background="{StaticResource SkylineCardPlaceholder}">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="{StaticResource SkylineCardSubtitleSize}" VerticalAlignment="Center" Margin="8" Foreground="{StaticResource SkylineSecondary}" />
            <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="UniformToFill" />
            <!-- CardOverlays: format badges, top-left and bottom-left. -->
            <ItemsControl ItemsSource="{x:Bind CornerTop, Mode=OneWay}" ItemTemplate="{StaticResource BadgeTemplate}" Margin="{x:Bind CornerInset, Mode=OneWay}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="False" IsHitTestVisible="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl ItemsSource="{x:Bind CornerBottom, Mode=OneWay}" ItemTemplate="{StaticResource BadgeTemplate}" Margin="{x:Bind CornerInset, Mode=OneWay}"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom" IsTabStop="False" IsHitTestVisible="False" />
            <Grid Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" VerticalAlignment="Bottom" Height="3">
              <Border Background="{StaticResource SkylineProgressTrack}" />
              <Border Background="{StaticResource SkylinePrimary}" HorizontalAlignment="Left" Width="{x:Bind ProgressFillWidth, Mode=OneWay}" />
            </Grid>
          </Grid>
          <Border x:Name="FocusGlow" Margin="-6" CornerRadius="{StaticResource SkylineFocusGlowRadius}" BorderThickness="3"
                  BorderBrush="{StaticResource SkylineFocusGlow}" Opacity="0" IsHitTestVisible="False" />
          <Border x:Name="FocusRing" Margin="-3" CornerRadius="{StaticResource SkylineFocusRingRadius}" BorderThickness="2"
                  BorderBrush="{StaticResource SkylineFocusRing}" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <StackPanel Spacing="1">
          <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="{StaticResource SkylineCardTitleSize}" FontWeight="SemiBold" LineHeight="16"
                     Foreground="{StaticResource SkylineCaptionTitle}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" FontSize="{StaticResource SkylineCardSubtitleSize}"
                     LineHeight="15.5" Foreground="{StaticResource SkylineCaptionSubtitle}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="RowTemplate" x:DataType="views:RowView">
      <!-- TvMediaRow.kt / TvSkylineSectionFeed.kt: 12 header-to-rail, 14 between rows, 7 rail padding. -->
      <StackPanel Spacing="12" Margin="0,0,0,14">
        <!-- TvSectionHeader.kt carries 4 bottom padding; the icon carries its own horizontal gap. -->
        <StackPanel Orientation="Horizontal" Margin="44,0,0,4">
          <Grid Width="22" Height="22" Margin="0,0,8,0" Visibility="{x:Bind IconVisibility, Mode=OneWay}" VerticalAlignment="Center">
            <Ellipse Fill="{StaticResource SkylinePrimary}" />
            <Polygon Points="8.5,6 16,11 8.5,16" Fill="{StaticResource SkylineBackground}" />
          </Grid>
          <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontSize="{StaticResource SkylineRowTitleSize}" FontWeight="SemiBold" LineHeight="18.9" VerticalAlignment="Center" />
        </StackPanel>
        <ListView ItemsSource="{x:Bind Cards}" ItemTemplate="{StaticResource CardTemplate}" Style="{StaticResource SkylineBrowseRailStyle}"
                  services:RailLayout.CardWidth="{x:Bind CardWidth, Mode=OneWay}" services:RailLayout.CardHeight="{x:Bind CardHeight, Mode=OneWay}"
                  ItemClick="OnCardClick" GotFocus="OnCardFocus" LostFocus="OnCardBlur" Loaded="OnRailLoaded" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="Landing">
        <!-- TvHomeScreen.kt drops only the foreground by 28: base band 270, marquee bottom 266. -->
        <VisualState x:Name="Home">
          <VisualState.Setters>
            <Setter Target="RowsScroller.Margin" Value="0,298,0,0" />
            <Setter Target="MarqueeRegion.Height" Value="294" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="ForYou" />
        <!-- Library landing: pills under the bar and a smaller title. -->
        <VisualState x:Name="Library">
          <VisualState.Setters>
            <Setter Target="PillRow.Visibility" Value="Visible" />
            <Setter Target="MarqueeTitle.FontSize" Value="{StaticResource SkylineMarqueeTitleCompactSize}" />
            <Setter Target="MarqueeTitle.LineHeight" Value="35" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <!-- TvHomeScreen.kt distinguishes first load, error, empty, and content; refresh keeps content visible. -->
      <VisualStateGroup x:Name="LoadState">
        <VisualState x:Name="Content" />
        <VisualState x:Name="Loading">
          <VisualState.Setters>
            <Setter Target="LoadingRing.Visibility" Value="Visible" />
            <Setter Target="LoadingRing.IsActive" Value="True" />
            <Setter Target="MarqueeRegion.Visibility" Value="Collapsed" />
            <Setter Target="RowsScroller.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Empty">
          <VisualState.Setters>
            <Setter Target="EmptyPanel.Visibility" Value="Visible" />
            <Setter Target="MarqueeRegion.Visibility" Value="Collapsed" />
            <Setter Target="RowsScroller.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Error">
          <VisualState.Setters>
            <Setter Target="ErrorPanel.Visibility" Value="Visible" />
            <Setter Target="MarqueeRegion.Visibility" Value="Collapsed" />
            <Setter Target="RowsScroller.Visibility" Value="Collapsed" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- TvRootHeroBackdrop.kt: sampled tint and corner-masked art animate in Composition, never XAML transitions. -->
    <Rectangle x:Name="Wash" IsHitTestVisible="False" />
    <Grid x:Name="ArtBox" Width="614" Height="378" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" />
    <Rectangle Height="90" VerticalAlignment="Top" IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#66000000" Offset="0" />
          <GradientStop Color="#00000000" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- Library tabs: sub-destination pills under the bar. Only Browse exists so far. -->
    <Grid x:Name="PillRow" Margin="44,72,44,0" VerticalAlignment="Top" Visibility="Collapsed">
      <Button x:Name="BrowsePill" Content="Browse" Style="{StaticResource SkylineCapsuleStyle}" FontSize="{StaticResource SkylinePillSize}"
              Background="{StaticResource SkylinePrimary}" Foreground="{StaticResource SkylineBackground}" Padding="12,0" Height="{StaticResource SkylineSubPillHeight}"
              CornerRadius="{StaticResource SkylineSubPill}" HorizontalAlignment="Left" />
      <TextBlock x:Name="ScopeCaption" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="{StaticResource SkylineCardSubtitleSize}"
                 Foreground="{StaticResource SkylineTertiary}" />
    </Grid>

    <!--
      TvFocusMarquee: passive, never focusable, anchored just above the rows. Rows of 6: the logo
      slot (84), the facts line (content-rating chip, then year · length · rating · genre), two lines
      of synopsis, the cast line once the title's detail lands (20), and the format badges.
    -->
    <Grid x:Name="MarqueeRegion" Height="266" VerticalAlignment="Top" IsHitTestVisible="False">
      <StackPanel x:Name="Marquee" Margin="44,0,0,0" Width="440" HorizontalAlignment="Left" VerticalAlignment="Bottom" Spacing="6">
        <Grid x:Name="TitleSlot">
          <TextBlock x:Name="MarqueeTitle" FontSize="{StaticResource SkylineMarqueeTitleSize}" FontWeight="Black"
                     LineHeight="{StaticResource SkylineMarqueeTitleLine}" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                     MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <Image x:Name="MarqueeLogo" MaxWidth="440" HorizontalAlignment="Left" Stretch="Uniform" Opacity="0" />
        </Grid>
        <StackPanel x:Name="MarqueeFacts" Orientation="Horizontal" Spacing="4" Height="18" />
        <TextBlock x:Name="MarqueeSynopsis" FontSize="{StaticResource SkylineSynopsisSize}" LineHeight="{StaticResource SkylineSynopsisLine}"
                   LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxLines="2" TextTrimming="WordEllipsis" MaxWidth="390"
                   HorizontalAlignment="Left" Foreground="{StaticResource SkylineSecondary}" />
        <TextBlock x:Name="MarqueeDetailLine" Height="20" FontSize="12" Foreground="#B3EDEDED" TextTrimming="CharacterEllipsis" Margin="0,-4,0,0" />
        <StackPanel x:Name="Badges" Orientation="Horizontal" Spacing="7" Margin="0,-6,0,0" />
      </StackPanel>
    </Grid>

    <!-- TvSkylineSectionFeed.kt: enough trailing space to pin even the last row below the marquee. -->
    <ScrollViewer x:Name="RowsScroller" Margin="0,270,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
      <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource RowTemplate}" IsTabStop="False" Padding="0,0,0,260" />
    </ScrollViewer>

    <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="False" Visibility="Collapsed" Foreground="{StaticResource SkylinePrimary}" />
    <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Margin="48" Visibility="Collapsed">
      <TextBlock x:Name="EmptyTitle" Text="Nothing to watch yet" FontSize="20.6" TextAlignment="Center" />
      <TextBlock x:Name="EmptyMessage" Text="Add media to your libraries or start watching to see it here."
                 FontSize="{StaticResource SkylineBodySize}" TextWrapping="Wrap" MaxWidth="600" TextAlignment="Center" Foreground="{StaticResource SkylineSecondary}" />
      <Button x:Name="RefreshButton" Content="Refresh" Style="{StaticResource SkylineButtonStyle}" Height="Auto" Padding="32,12"
              HorizontalAlignment="Center" Click="OnRetryClick" />
    </StackPanel>
    <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
      <TextBlock x:Name="ErrorText" FontSize="{StaticResource SkylineBodySize}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                 Foreground="{StaticResource SkylineSecondary}" />
      <Button x:Name="RetryButton" Content="Try Again" Style="{StaticResource SkylineButtonStyle}" HorizontalAlignment="Center" Click="OnRetryClick" />
    </StackPanel>
  </Grid>
</Page>
