<Page
    x:Class="Bale.Xbox.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    xmlns:controls="using:Bale.Xbox.Controls"
    Background="{StaticResource SkylineProfileBackdrop}">

  <Grid>
    <!-- TvProfileSelectionScreen.kt uses MarqueeScene.Focus.Profiles + MarqueeScrim(Ambient)
         over TvAppNavigation.kt's mirrored MarqueeBackdrop, not the legacy TvAuroraBackdrop. -->
    <Rectangle Fill="{StaticResource SkylineProfileBackdropScrim}" IsHitTestVisible="False" />
    <!-- TvProfileSelectionScreen.kt: six 128dp columns, 14dp gaps, round 110dp avatars. -->
    <Grid x:Name="PickerPanel" Margin="44,30">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Who's watching?" FontSize="{StaticResource SkylineProfileTitleSize}" FontWeight="ExtraBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="AccountText" Text=" " FontSize="{StaticResource SkylineAuthCaptionSize}" Foreground="{StaticResource SkylineSecondary}"
                   HorizontalAlignment="Center" Margin="0,7,0,0" />
        <GridView x:Name="Profiles" Margin="0,20,0,0" MaxWidth="852" MaxHeight="310" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnProfileClick"
                  GotFocus="OnProfileFocus" LostFocus="OnProfileBlur" PreviewKeyDown="OnProfilesPreviewKeyDown" HorizontalAlignment="Center"
                  Padding="0" ItemContainerStyle="{StaticResource SkylineProfileItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden">
          <GridView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" />
            </ItemsPanelTemplate>
          </GridView.ItemsPanel>
          <GridView.ItemTemplate>
            <DataTemplate x:DataType="views:ProfileView">
              <StackPanel Width="{StaticResource SkylineProfileColumnWidth}">
                <Grid x:Name="Art" Width="{StaticResource SkylineProfileAvatarSize}" Height="{StaticResource SkylineProfileAvatarSize}" HorizontalAlignment="Center">
                  <Ellipse Fill="{x:Bind AvatarFill}" />
                  <TextBlock Text="{x:Bind Initial}" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  <Ellipse>
                    <Ellipse.Fill><ImageBrush ImageSource="{x:Bind Avatar}" Stretch="UniformToFill" /></Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Stroke="{StaticResource SkylineProfileAvatarBorder}" StrokeThickness="{StaticResource SkylineProfileAvatarBorderWidth}" />
                  <!-- The ring's centre is 6dp outside the avatar; its 3dp stroke extends another 1.5dp. -->
                  <Ellipse x:Name="FocusRing" Margin="-7.5" StrokeThickness="3" Stroke="{StaticResource SkylineFocusRing}" Opacity="0" />
                  <!-- MarqueeProfileAvatar.kt: badges sit outside the circular crop, inside Art's focus scale. -->
                  <Border Width="{StaticResource SkylineProfileLockSize}" Height="{StaticResource SkylineProfileLockSize}" CornerRadius="{StaticResource SkylineProfileLockRadius}"
                          Background="{StaticResource SkylineProfileLockFill}" BorderBrush="Black" BorderThickness="{StaticResource SkylineProfileLockBorder}"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{StaticResource SkylineProfileLockOffset}" Visibility="{x:Bind LockVisibility}">
                    <!-- LockGlyph draws a shackle and rounded body, not a platform font icon. -->
                    <Viewbox Width="{StaticResource SkylineProfileLockIconSize}" Height="{StaticResource SkylineProfileLockIconSize}"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Grid Width="24" Height="24">
                        <Path Width="24" Height="24" Stroke="{StaticResource SkylineSecondary}" StrokeThickness="3.84"
                              Data="M5.76,8.16 A6.24,7.2 0 0 1 18.24,8.16" />
                        <Path Width="24" Height="24" Fill="{StaticResource SkylineSecondary}"
                              Data="M5.76,8.16 H9.6 V11.04 H5.76 Z M14.4,8.16 H18.24 V11.04 H14.4 Z" />
                        <Path Width="24" Height="24" Fill="{StaticResource SkylineSecondary}"
                              Data="M5.28,10.56 H18.72 A2.88,2.88 0 0 1 21.6,13.44 V21.12 A2.88,2.88 0 0 1 18.72,24 H5.28 A2.88,2.88 0 0 1 2.4,21.12 V13.44 A2.88,2.88 0 0 1 5.28,10.56 Z" />
                      </Grid>
                    </Viewbox>
                  </Border>
                  <Border Height="{StaticResource SkylineProfileKidsHeight}" CornerRadius="{StaticResource SkylineProfileKidsRadius}"
                          Background="White" Padding="{StaticResource SkylineProfileKidsPadding}" HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="{StaticResource SkylineProfileKidsOffset}" Visibility="{x:Bind KidsVisibility}">
                    <TextBlock Text="KIDS" FontSize="{StaticResource SkylineProfileKidsSize}" FontWeight="Black" CharacterSpacing="{StaticResource SkylineProfileKidsTracking}"
                               Foreground="Black" VerticalAlignment="Center" />
                  </Border>
                </Grid>
                <TextBlock x:Name="ProfileCaption" Text="{x:Bind Name}" FontSize="{StaticResource SkylineProfileNameSize}" FontWeight="SemiBold"
                           Foreground="{StaticResource SkylineSecondary}" HorizontalAlignment="Center" Margin="0,13,0,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="{StaticResource SkylineProfileColumnWidth}" />
              </StackPanel>
            </DataTemplate>
          </GridView.ItemTemplate>
        </GridView>
        <!-- TvProfileSelectionScreen.kt: an existing grid keeps only 14sp error text, 18dp below it. -->
        <TextBlock x:Name="InlineErrorText" Style="{StaticResource SkylineProfileInlineErrorStyle}" Visibility="Collapsed" />
      </StackPanel>
      <!-- rail-layout: non-card — Profile picker actions. -->
      <ItemsControl x:Name="PickerActions" Grid.Row="1" HorizontalAlignment="Center" PreviewKeyDown="OnPickerActionsPreviewKeyDown">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <!-- TvProfileSelectionScreen.kt: Material Outlined Dns and AutoMirrored Outlined Logout. -->
        <Button x:Name="ChangeServerButton" Click="OnChangeServerClick" GotFocus="OnPickerActionFocus" LostFocus="OnPickerActionBlur"
                Style="{StaticResource SkylineMarqueeCompactGlassStyle}" AutomationProperties.Name="Change server">
          <StackPanel Style="{StaticResource SkylineMarqueeCompactContentStyle}">
            <Viewbox Style="{StaticResource SkylineMarqueeCompactIconStyle}">
              <Path x:Name="ChangeServerIcon" Width="24" Height="24" Fill="{StaticResource SkylinePrimary}"
                    Data="M19 15v4H5v-4h14m1-2H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1v-6c0-.55-.45-1-1-1zM7 18.5c-.82 0-1.5-.67-1.5-1.5s.68-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM19 5v4H5V5h14m1-2H4c-.55 0-1 .45-1 1v6c0 .55.45 1 1 1h16c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1zM7 8.5c-.82 0-1.5-.67-1.5-1.5S6.18 5.5 7 5.5s1.5.68 1.5 1.5S7.83 8.5 7 8.5z" />
            </Viewbox>
            <TextBlock Text="Change server" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="SignOutButton" Click="OnSignOutClick" GotFocus="OnPickerActionFocus" LostFocus="OnPickerActionBlur"
                Style="{StaticResource SkylineMarqueeCompactGlassStyle}" AutomationProperties.Name="Sign out">
          <StackPanel Style="{StaticResource SkylineMarqueeCompactContentStyle}">
            <Viewbox Style="{StaticResource SkylineMarqueeCompactIconStyle}">
              <Path x:Name="SignOutIcon" Width="24" Height="24" Fill="{StaticResource SkylinePrimary}"
                    Data="M17,8l-1.41,1.41L17.17,11H9v2h8.17l-1.58,1.58L17,16l4-4L17,8z M5,5h7V3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h7v-2H5V5z" />
            </Viewbox>
            <TextBlock Text="Sign out" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </ItemsControl>
    </Grid>

    <!-- TvProfileSelectionScreen.kt / StatusViews.kt: first-load loading/error replace the picker,
         including its utility actions. TvErrorScreen's 24dp spacing applies around its extra 8dp spacer. -->
    <ProgressRing x:Name="LoadingRing" Style="{StaticResource SkylineProfileLoadingStyle}" IsActive="True" />
    <Grid x:Name="FullScreenErrorPanel" Style="{StaticResource SkylineProfileErrorScreenStyle}" Visibility="Collapsed">
      <StackPanel Style="{StaticResource SkylineProfileErrorContentStyle}">
        <TextBlock x:Name="FullScreenErrorText" Style="{StaticResource SkylineProfileErrorMessageStyle}" />
        <Border Height="{StaticResource SkylineProfileErrorSpacer}" />
        <Button x:Name="RetryButton" Content="Retry" Click="OnRetryClick" Style="{StaticResource SkylineProfileRetryStyle}" />
      </StackPanel>
    </Grid>

    <controls:ProfilePinDialog x:Name="PinPrompt" />

    <Grid x:Name="RememberPanel" Background="{StaticResource SkylinePinScrim}" Visibility="Collapsed" PreviewKeyDown="OnRememberPreviewKeyDown">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" Spacing="18">
        <TextBlock x:Name="RememberTitle" FontSize="{StaticResource SkylineProfileTitleSize}" FontWeight="ExtraBold" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="Open this profile when Bale starts on this TV." FontSize="{StaticResource SkylineAuthCaptionSize}" Foreground="{StaticResource SkylineSecondary}" HorizontalAlignment="Center" />
        <!-- rail-layout: non-card — Remember-profile confirmation actions. -->
        <ItemsControl x:Name="RememberActions" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="11" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <Button x:Name="RememberYesButton" Content="Yes" Click="OnRememberYesClick" Style="{StaticResource SkylineButtonStyle}" />
          <Button Content="Not now" Click="OnRememberNotNowClick" Style="{StaticResource SkylineButtonStyle}" />
        </ItemsControl>
      </StackPanel>
    </Grid>

    <controls:SignOutDialog x:Name="SignOutPrompt" />
  </Grid>
</Page>
