<Page
    x:Class="Bale.Xbox.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    Background="{StaticResource SkylineBackground}">

  <!--
    A title's detail page, pushed full screen over the shell (no top bar), laid out like Silo's
    Android TV TvItemDetailScreen: hero (TvDetailHero) with the action row, then the season picker
    and episode rail on a series (TvSeasonPicker, TvDetailEpisodeRail) and Cast & Crew
    (TvCastCrewSection). Geometry is TvDetailHero's: 50 px side inset, content from 58 px down,
    540 px wide; the art box is 64% x 70% of a 16:9 canvas, top right.
  -->
  <Page.Resources>
    <DataTemplate x:Key="EpisodeTemplate" x:DataType="views:EpisodeView">
      <StackPanel Width="180" Spacing="7">
        <Grid x:Name="Art" Width="180" Height="101">
          <Grid CornerRadius="8" Background="{StaticResource SkylineCardPlaceholder}">
            <Image Source="{x:Bind Still}" Stretch="UniformToFill" />
            <Grid Visibility="{x:Bind ProgressVisibility}" VerticalAlignment="Bottom" Height="3">
              <Border Background="{StaticResource SkylineProgressTrack}" />
              <Border Background="{StaticResource SkylinePrimary}" HorizontalAlignment="Left" Width="{x:Bind ProgressFillWidth}" />
            </Grid>
            <Border Visibility="{x:Bind WatchedVisibility}" Width="20" Height="20" CornerRadius="10" Background="#E6FFFFFF"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
              <FontIcon Glyph="&#xE73E;" FontSize="10" Foreground="#FF000000" />
            </Border>
          </Grid>
          <Border x:Name="FocusGlow" Margin="-6" CornerRadius="{StaticResource SkylineFocusGlowRadius}" BorderThickness="3"
                  BorderBrush="{StaticResource SkylineFocusGlow}" Opacity="0" IsHitTestVisible="False" />
          <Border x:Name="FocusRing" Margin="-3" CornerRadius="{StaticResource SkylineFocusRingRadius}" BorderThickness="2"
                  BorderBrush="{StaticResource SkylineFocusRing}" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <TextBlock Text="{x:Bind Label}" FontSize="9.5" FontWeight="Bold" CharacterSpacing="120" Foreground="{StaticResource SkylineCaptionSubtitle}" />
        <TextBlock Text="{x:Bind Title}" FontSize="{StaticResource SkylineCardTitleSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind Overview}" FontSize="11" LineHeight="14.5" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                   MaxLines="3" TextTrimming="WordEllipsis" Foreground="{StaticResource SkylineCaptionSubtitle}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CastTemplate" x:DataType="views:CastView">
      <StackPanel Width="100" Spacing="0">
        <Grid x:Name="Art" Width="100" Height="100">
          <Ellipse Fill="{StaticResource SkylineSurfaceElevated}" />
          <FontIcon Glyph="&#xE77B;" FontSize="34" Foreground="#99FFFFFF" Visibility="{x:Bind PlaceholderVisibility}" />
          <Ellipse>
            <Ellipse.Fill>
              <ImageBrush ImageSource="{x:Bind Photo}" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse x:Name="FocusGlow" Margin="-6" Stroke="{StaticResource SkylineFocusGlow}" StrokeThickness="3" Opacity="0" IsHitTestVisible="False" />
          <Ellipse x:Name="FocusRing" Margin="-3" Stroke="{StaticResource SkylineFocusRing}" StrokeThickness="2" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <TextBlock Text="{x:Bind Name}" Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind Role}" Margin="0,2,0,0" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource SkylineCaptionSubtitle}" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <!-- Page tint from the art (TvItemDetailScreen: sampled tint over black), then the masked art box. -->
    <Rectangle x:Name="Wash" IsHitTestVisible="False" />
    <Grid x:Name="ArtBox" Width="614" Height="378" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" />

    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
      <StackPanel Padding="0,0,0,70">
        <!-- Hero: 690/1080 of the screen. -->
        <Grid Height="345">
          <StackPanel Margin="50,58,50,0" MaxWidth="540" HorizontalAlignment="Left" Spacing="9">
            <StackPanel Spacing="7">
              <Grid x:Name="TitleSlot">
                <TextBlock x:Name="TitleText" FontSize="31" FontWeight="Black" LineHeight="32" LineStackingStrategy="BlockLineHeight"
                           TextWrapping="Wrap" MaxLines="2" />
                <Image x:Name="TitleLogo" Height="80" MaxWidth="325" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Uniform" Opacity="0" />
              </Grid>
              <TextBlock x:Name="SubtitleText" FontSize="17.2" FontWeight="ExtraBold" Foreground="#F0FFFFFF" Visibility="Collapsed" />
              <!-- TvDetailHero.MetadataRow: rating chip, then facts and quality, then type and genres. -->
              <StackPanel x:Name="Metadata" Orientation="Horizontal" Spacing="7" Height="18" />
              <TextBlock x:Name="Synopsis" FontSize="11.2" LineHeight="15" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" MaxLines="3"
                         TextTrimming="WordEllipsis" Foreground="#D1FFFFFF" />
              <TextBlock x:Name="CreditLine" FontSize="10.3" FontWeight="Medium" Foreground="#9EFFFFFF" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Action row: Play, Start Over (with a resume point), Watchlist, More (TvItemDetailScreen.HeroActionRow). -->
            <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="9" Margin="0,4,0,0" XYFocusKeyboardNavigation="Enabled">
              <Button x:Name="PlayButton" Style="{StaticResource SkylinePlayButtonStyle}" Click="OnPlayClick">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <FontIcon Glyph="&#xE768;" FontSize="14" />
                  <TextBlock x:Name="PlayLabel" Text="Play" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="StartOverButton" Style="{StaticResource SkylineCircleButtonStyle}" Content="&#xE892;" Click="OnStartOverClick"
                      AutomationProperties.Name="Start Over" Visibility="Collapsed" />
              <Button x:Name="WatchlistButton" Style="{StaticResource SkylineCircleButtonStyle}" Content="&#xE710;" Click="OnWatchlistClick"
                      AutomationProperties.Name="Watchlist" />
              <Button x:Name="MoreButton" Style="{StaticResource SkylineCircleButtonStyle}" Content="&#xE712;" AutomationProperties.Name="More">
                <Button.Flyout>
                  <MenuFlyout x:Name="MoreMenu" Placement="Bottom">
                    <MenuFlyoutItem x:Name="FavoriteItem" Text="Add to Favorites" Click="OnFavoriteClick" />
                    <MenuFlyoutItem x:Name="WatchedItem" Text="Mark as Watched" Click="OnWatchedClick" />
                    <MenuFlyoutItem x:Name="SeriesItem" Text="Go to Series" Click="OnSeriesClick" Visibility="Collapsed" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
            <TextBlock x:Name="ActionStatus" FontSize="10.3" Foreground="{StaticResource SkylineCaptionSubtitle}" />
          </StackPanel>
        </Grid>

        <!-- Episodes (series only): section header, season chips, episode rail. -->
        <StackPanel x:Name="EpisodesSection" Spacing="10" Margin="0,0,0,32" Visibility="Collapsed">
          <Grid Margin="50,0,50,0">
            <StackPanel Spacing="5">
              <TextBlock x:Name="SeasonEyebrow" FontSize="12" FontWeight="Bold" CharacterSpacing="125" Foreground="#B3FFFFFF" />
              <TextBlock Text="Episodes" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock x:Name="EpisodeCount" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="10.3" Foreground="{StaticResource SkylineCaptionSubtitle}" />
          </Grid>
          <ItemsControl x:Name="Seasons" Margin="50,0,0,0" IsTabStop="False" Visibility="Collapsed">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" Padding="0,6,50,6">
                  <ItemsPresenter />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="7" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:SeasonView">
                <ToggleButton Content="{x:Bind Title}" Style="{StaticResource SkylineChipStyle}" Click="OnSeasonClick" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ListView x:Name="Episodes" ItemTemplate="{StaticResource EpisodeTemplate}" ItemContainerStyle="{StaticResource SkylineCardItemStyle}"
                    SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnEpisodeClick" GotFocus="OnCardFocus" LostFocus="OnCardBlur"
                    Padding="50,9,0,9" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <ItemsStackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
          </ListView>
        </StackPanel>

        <!-- Cast & Crew. -->
        <StackPanel x:Name="CastSection" Spacing="10" Visibility="Collapsed">
          <StackPanel Spacing="5" Margin="50,0,50,0">
            <TextBlock Text="CAST" FontSize="12" FontWeight="Bold" CharacterSpacing="125" Foreground="#B3FFFFFF" />
            <TextBlock Text="&amp; Crew" FontSize="18" FontWeight="SemiBold" />
          </StackPanel>
          <ListView x:Name="Cast" ItemTemplate="{StaticResource CastTemplate}" SelectionMode="None" IsItemClickEnabled="False"
                    GotFocus="OnCardFocus" LostFocus="OnCardBlur"
                    Padding="50,12,0,12" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem" BasedOn="{StaticResource SkylineCardItemStyle}">
                <Setter Property="Margin" Value="0,0,22,0" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemsPanel>
              <ItemsPanelTemplate>
                <ItemsStackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ListView.ItemsPanel>
          </ListView>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="True" Foreground="{StaticResource SkylinePrimary}" />
    <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
      <TextBlock x:Name="ErrorText" FontSize="{StaticResource SkylineBodySize}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                 Foreground="{StaticResource SkylineSecondary}" />
      <Button x:Name="RetryButton" Content="Try Again" Style="{StaticResource SkylineButtonStyle}" HorizontalAlignment="Center" Click="OnRetryClick" />
    </StackPanel>
  </Grid>
</Page>
