  <!--
    Show / Season tab (TvSeasonPicker.TvSeriesModeTab): 26 high pill; white @ 5% with a white @ 30%
    hairline at rest, white @ 20% with a white @ 70% ring when selected (Checked), white with a
    black label and an outward white ring on focus. Content must be a string.
  -->
  <Style x:Key="SkylineChipStyle" TargetType="ToggleButton">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="FocusRing" Margin="-2.75" CornerRadius="15.75" BorderBrush="#FAFFFFFF" BorderThickness="1.25" Opacity="0" />
            <Border x:Name="Rest" CornerRadius="13" Background="#0DFFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="0.75" />
            <Border x:Name="Selected" CornerRadius="13" Background="#33FFFFFF" BorderBrush="#B3FFFFFF" BorderThickness="1" Opacity="0" />
            <Border x:Name="FocusFill" CornerRadius="13" Background="#FFFFFFFF" Opacity="0" />
            <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalContentAlignment="Center" />
            <ContentPresenter x:Name="FocusedLabel" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="#FF000000"
                              FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalContentAlignment="Center" Opacity="0" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Selected.Opacity" Value="1" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                    <Setter Target="FocusedLabel.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Selected.Opacity" Value="1" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                    <Setter Target="FocusedLabel.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Selected.Opacity" Value="1" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                    <Setter Target="FocusedLabel.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="IndeterminatePointerOver" />
                <VisualState x:Name="IndeterminatePressed" />
                <VisualState x:Name="IndeterminateDisabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusFill.Opacity" Value="1" />
                    <Setter Target="FocusRing.Opacity" Value="1" />
                    <Setter Target="Label.Opacity" Value="0" />
                    <Setter Target="FocusedLabel.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!--
    Filter chip (TvChip.TvFilterChip): a 30 high pill; transparent with a white @ 12% hairline and a
    white @ 82% label at rest, solid #EDEDED with a black label when selected (Checked) or focused,
    with a 1.02 lift on focus. Content must be a string.
  -->
  <Style x:Key="SkylineFilterChipStyle" TargetType="ToggleButton">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="22,0" />
    <Setter Property="Foreground" Value="#D1FFFFFF" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <!-- Selected and focused are separate layers: setters from two state groups on one property undo each other. -->
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="Lift" />
            </Grid.RenderTransform>
            <Border CornerRadius="15" BorderBrush="#1FFFFFFF" BorderThickness="1" />
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalContentAlignment="Center" />
            <Grid x:Name="CheckedLayer" Opacity="0">
              <Border CornerRadius="15" Background="#FFEDEDED" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="#FF000000"
                                FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalContentAlignment="Center" />
            </Grid>
            <Grid x:Name="FocusLayer" Opacity="0">
              <Border CornerRadius="15" Background="#FFEDEDED" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="#FF000000"
                                FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalContentAlignment="Center" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="CheckedLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="CheckedLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="CheckedLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="IndeterminatePointerOver" />
                <VisualState x:Name="IndeterminatePressed" />
                <VisualState x:Name="IndeterminateDisabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.12" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
