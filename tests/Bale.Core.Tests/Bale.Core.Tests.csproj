    <Compile Include="../../src/Bale.Xbox/Services/ProfilePreview.cs" Link="ProfilePreview.cs" />
    <Compile Include="../../src/Bale.Xbox/Services/DebugScreenText.cs" Link="DebugScreenText.cs" />
