<Page
    x:Class="Bale.Xbox.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SkylineBackground}">

  <!-- Placeholder for the Calendar root (TvCalendarScreen): upcoming episodes and releases come later. -->
  <StackPanel Margin="44,0,44,0" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="14">
    <FontIcon Glyph="&#xE787;" FontSize="24" Foreground="#80FFFFFF" VerticalAlignment="Top" Margin="0,2,0,0" />
    <StackPanel Spacing="4">
      <TextBlock Text="Calendar is coming to Bale" FontSize="17.2" FontWeight="SemiBold" />
      <TextBlock Text="Upcoming episodes and releases from your libraries will show here." FontSize="13" Foreground="{StaticResource SkylineSecondary}" />
    </StackPanel>
  </StackPanel>
</Page>
