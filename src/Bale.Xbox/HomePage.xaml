<Page
    x:Class="Bale.Xbox.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    Background="{StaticResource BaleBackground}">

  <Page.Resources>
    <DataTemplate x:Key="CardTemplate" x:DataType="views:CardView">
      <StackPanel Width="{x:Bind Width}" Spacing="6">
        <Grid Width="{x:Bind Width}" Height="{x:Bind Height}" CornerRadius="6" Background="#2A2720">
          <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind FallbackVisibility}" TextWrapping="Wrap" TextAlignment="Center"
                     VerticalAlignment="Center" Margin="8" Foreground="{StaticResource BaleMuted}" />
          <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
          <ProgressBar Value="{x:Bind ProgressPercent}" Maximum="100" Visibility="{x:Bind ProgressVisibility}"
                       VerticalAlignment="Bottom" Margin="8,0,8,8" Foreground="{StaticResource BaleStraw}" Background="#66000000" />
        </Grid>
        <StackPanel Visibility="{x:Bind ShowCaption}">
          <TextBlock Text="{x:Bind Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind Caption}" FontSize="12" Foreground="{StaticResource BaleMuted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <Style x:Key="CardItemStyle" TargetType="ListViewItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,16,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="FocusVisualMargin" Value="-4" />
      <Setter Property="FocusVisualPrimaryThickness" Value="3" />
      <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource BaleStraw}" />
      <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <DataTemplate x:Key="RowTemplate" x:DataType="views:RowView">
      <StackPanel Spacing="10" Margin="0,0,0,28">
        <TextBlock Text="{x:Bind Title}" FontSize="20" FontWeight="SemiBold" Margin="48,0,0,0" />
        <!-- One focusable list per row; the outer ItemsControl isn't focusable, so Up/Down lands on cards. -->
        <ListView ItemsSource="{x:Bind Cards}" ItemTemplate="{StaticResource CardTemplate}" ItemContainerStyle="{StaticResource CardItemStyle}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnCardClick" GotFocus="OnCardFocus"
                  Padding="48,6,48,6" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                  ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  XYFocusKeyboardNavigation="Enabled">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
        </ListView>
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="290" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Banner art fills the screen edge to edge and fades into the background under the rows. -->
    <Image x:Name="Backdrop" Grid.RowSpan="2" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Top" Height="400" Opacity="0">
      <Image.OpacityTransition>
        <ScalarTransition Duration="0:0:0.3" />
      </Image.OpacityTransition>
    </Image>
    <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#FF17150F" Offset="0.2" />
          <GradientStop Color="#0017150F" Offset="0.75" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle Grid.RowSpan="2" IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#0017150F" Offset="0.3" />
          <GradientStop Color="#FF17150F" Offset="0.62" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <!-- Banner: whatever card has focus. -->
    <StackPanel Grid.Row="0" Margin="48,40,48,0" MaxWidth="560" HorizontalAlignment="Left" Spacing="8">
      <Image x:Name="BannerLogo" MaxHeight="90" MaxWidth="360" HorizontalAlignment="Left" Stretch="Uniform" />
      <TextBlock x:Name="BannerTitle" FontSize="36" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="BannerMeta" FontSize="15" Foreground="{StaticResource BaleMuted}" />
      <TextBlock x:Name="BannerOverview" FontSize="15" TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis" />
    </StackPanel>

    <Button x:Name="ProfileButton" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,32,48,0"
            Background="#66000000" CornerRadius="18" Padding="14,6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <FontIcon Glyph="&#xE77B;" FontSize="16" />
        <TextBlock x:Name="ProfileName" FontSize="15" />
      </StackPanel>
      <Button.Flyout>
        <MenuFlyout Placement="BottomEdgeAlignedRight">
          <MenuFlyoutItem Text="Switch profile" Click="OnSwitchProfileClick" />
          <MenuFlyoutItem Text="Refresh" Click="OnRefreshClick" />
          <MenuFlyoutSeparator />
          <MenuFlyoutItem Text="Sign out" Click="OnSignOutClick" />
        </MenuFlyout>
      </Button.Flyout>
    </Button>

    <ScrollViewer x:Name="RowsScroller" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled"
                  Padding="0,0,0,27">
      <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource RowTemplate}" IsTabStop="False" />
    </ScrollViewer>

    <ProgressRing x:Name="Loading" Grid.RowSpan="2" Width="48" Height="48" IsActive="True" />
    <StackPanel x:Name="ErrorPanel" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" Visibility="Collapsed">
      <TextBlock x:Name="ErrorText" FontSize="20" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center" />
      <Button x:Name="RetryButton" Content="Try again" HorizontalAlignment="Center" Click="OnRefreshClick" />
    </StackPanel>
  </Grid>
</Page>
