    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontSize" Value="12.9" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="#FFEDEDED" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Row" CornerRadius="10" Background="Transparent" Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Row.Opacity" Value="0.38" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Row.Background" Value="#FFEDEDED" />
                    <Setter Target="Content.Foreground" Value="#FF0B0B0C" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Detail page Play pill (TvSquaredButtons.TvPrimaryPillButton, stableHero = true): a 38 high
    capsule, white @ 10% with a white label at rest, solid white with a black label on focus, no
    lift. Series pages fix its width at 170 so the round actions keep their places.
  -->
  <Style x:Key="SkylinePlayButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="27,0" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Pill" Background="#1AFFFFFF" CornerRadius="19" Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Pill.Opacity" Value="0.5" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Pill.Background" Value="#FFFFFFFF" />
                    <Setter Target="Content.Foreground" Value="#FF000000" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Round action beside Play (TvSquaredButtons.TvSquareToggleButton with titleOnFocus): a 38 circle,
    white @ 10% at rest; on focus it turns white and widens into a capsule that shows its title
    ("Watchlist", "More"). Content is an icon plus a TextBlock title; Services/ActionButton shows the
    title and recolors path icons, which a template can't reach.
  -->
  <Style x:Key="SkylineActionButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="{StaticResource SkylineDetailActionHeight}" />
    <Setter Property="MinWidth" Value="{StaticResource SkylineDetailActionHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="FontSize" Value="{StaticResource SkylineDetailActionFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Pill" Background="#1AFFFFFF" CornerRadius="19" Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="ActionExpansionStates">
                <VisualState x:Name="Expanded"><VisualState.Setters>
                  <Setter Target="Pill.Padding" Value="{StaticResource SkylineDetailActionExpandedPadding}" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="Collapsed" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Pill.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Pill.Background" Value="#FFFFFFFF" />
                    <Setter Target="Content.Foreground" Value="#FF000000" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                              FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Show / Season tab (TvSeasonPicker.TvSeriesModeTab): 26 high pill; white @ 5% with a white @ 30%
    hairline at rest, white @ 20% with a white @ 70% ring when selected (Checked), white with a
    black label and an outward white ring on focus. Content must be a string.
  -->
  <Style x:Key="SkylineChipStyle" TargetType="ToggleButton">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="FocusRing" Margin="-2.75" CornerRadius="15.75" BorderBrush="#FAFFFFFF" BorderThickness="1.25" Opacity="0" />
            <Border x:Name="Rest" CornerRadius="13" Background="#0DFFFFFF" BorderBrush="#4DFFFFFF" BorderThickness="0.75" />
            <Border x:Name="Selected" CornerRadius="13" Background="#33FFFFFF" BorderBrush="#B3FFFFFF" BorderThickness="1" Opacity="0" />
            <Border x:Name="FocusFill" CornerRadius="13" Background="#FFFFFFFF" Opacity="0" />
            <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalContentAlignment="Center" />
            <ContentPresenter x:Name="FocusedLabel" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="#FF000000"
                              FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalContentAlignment="Center" Opacity="0" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="Selected.Opacity" Value="1" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                    <Setter Target="FocusedLabel.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="Selected.Opacity" Value="1" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                    <Setter Target="FocusedLabel.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="Selected.Opacity" Value="1" />
                    <Setter Target="Label.FontWeight" Value="SemiBold" />
                    <Setter Target="FocusedLabel.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="IndeterminatePointerOver" />
                <VisualState x:Name="IndeterminatePressed" />
                <VisualState x:Name="IndeterminateDisabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusFill.Opacity" Value="1" />
                    <Setter Target="FocusRing.Opacity" Value="1" />
                    <Setter Target="Label.Opacity" Value="0" />
                    <Setter Target="FocusedLabel.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!--
    Filter chip (TvChip.TvFilterChip): a 30 high pill; transparent with a white @ 12% hairline and a
    white @ 82% label at rest, solid #EDEDED with a black label when selected (Checked) or focused,
    with a 1.02 lift on focus. Content must be a string.
  -->
  <Style x:Key="SkylineFilterChipStyle" TargetType="ToggleButton">
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="22,0" />
    <Setter Property="Foreground" Value="#D1FFFFFF" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <!-- Selected and focused are separate layers: setters from two state groups on one property undo each other. -->
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
              <ScaleTransform x:Name="Lift" />
            </Grid.RenderTransform>
            <Border CornerRadius="15" BorderBrush="#1FFFFFFF" BorderThickness="1" />
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalContentAlignment="Center" />
            <Grid x:Name="CheckedLayer" Opacity="0">
              <Border CornerRadius="15" Background="#FFEDEDED" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="#FF000000"
                                FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalContentAlignment="Center" />
            </Grid>
            <Grid x:Name="FocusLayer" Opacity="0">
              <Border CornerRadius="15" Background="#FFEDEDED" />
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="#FF000000"
                                FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" VerticalContentAlignment="Center" />
            </Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="CheckedLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="CheckedLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="CheckedLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="IndeterminatePointerOver" />
                <VisualState x:Name="IndeterminatePressed" />
                <VisualState x:Name="IndeterminateDisabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusLayer.Opacity" Value="1" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.12" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Profile picker status: TvProfileSelectionScreen.kt / components/StatusViews.kt.
       TvErrorScreen pads 48dp and spaces every child by 24dp, including its extra 8dp spacer. -->
  <x:Double x:Key="SkylineProfileErrorSpacer">8</x:Double>
  <Style x:Key="SkylineProfileLoadingStyle" TargetType="ProgressRing">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="64" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
  </Style>
  <Style x:Key="SkylineProfileErrorScreenStyle" TargetType="Grid">
    <Setter Property="Padding" Value="48" />
  </Style>
  <Style x:Key="SkylineProfileErrorContentStyle" TargetType="StackPanel">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Spacing" Value="24" />
  </Style>
  <!-- theme/Type.kt headlineSmall: SemiBold 22/28sp, mapped by Theme.kt's TvUiFontScale 0.86. -->
  <Style x:Key="SkylineProfileErrorMessageStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SkylineFont}" />
    <Setter Property="FontSize" Value="18.92" />
    <Setter Property="LineHeight" Value="24.08" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <!-- TvProfileSelectionScreen.kt: 14sp, MarqueeColors.Error (MarqueeBackdrop.kt), top padding 18dp. -->
  <Style x:Key="SkylineProfileInlineErrorStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SkylineFont}" />
    <Setter Property="FontSize" Value="12.04" />
    <Setter Property="Foreground" Value="#FFFF6961" />
    <Setter Property="Margin" Value="0,18,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <!-- StatusViews.kt: TV Material Button with 32/12dp content padding, Type.kt labelLarge 18/22sp.
       ButtonDefaults.kt supplies a capsule, surfaceVariant/onSurface at 80%, and focused scale 1.1;
       ColorDarkTokens.kt / PaletteTokens.kt inverseOnSurface is Neutral20 (#313033). -->
  <Style x:Key="SkylineProfileRetryStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource SkylineFont}" />
    <Setter Property="FontSize" Value="15.48" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="#CC0E0F12" />
    <Setter Property="Foreground" Value="#CCEDEDED" />
    <Setter Property="Padding" Value="32,12" />
    <Setter Property="Height" Value="42.92" />
    <Setter Property="CornerRadius" Value="21.46" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Capsule" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Lift" /></Border.RenderTransform>
            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                       LineHeight="18.92" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Pressed" /><VisualState x:Name="Disabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Background" Value="{StaticResource SkylinePrimary}" />
                    <Setter Target="Label.Foreground" Value="#FF313033" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.12" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused" /><VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Profile picker utilities: TvProfileSelectionScreen.kt uses TvMarquee.kt Glass + compact.
       38dp * 0.8 height, 20dp * 0.7 padding, 14.5sp * 0.85 * 0.86 text; 14dp icon with 7dp gap.
       MarqueeBackdrop.kt supplies GlassFill (white 8%), Hairline (white 14%) and Ink (#EDEDED). -->
  <Style x:Key="SkylineMarqueeCompactGlassStyle" TargetType="Button">
    <Setter Property="Height" Value="30.4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="15.2" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="BorderBrush" Value="#24FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="FontFamily" Value="{StaticResource SkylineFont}" />
    <Setter Property="FontSize" Value="10.5995" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="services:SurfaceShadow.Elevation" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="Lift" /></Grid.RenderTransform>
            <Border x:Name="ShadowHost" Opacity="0" IsHitTestVisible="False">
              <Rectangle x:Name="ShadowMask" RadiusX="15.2" RadiusY="15.2" Fill="Black" />
            </Border>
            <Border x:Name="Capsule" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Content.Opacity" Value="0.45" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Background" Value="{StaticResource SkylinePrimary}" />
                    <Setter Target="Capsule.BorderThickness" Value="0" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylineBackground}" />
                    <Setter Target="ShadowHost.Opacity" Value="1" />
                  </VisualState.Setters>
                  <!-- TvMarquee.kt lifts the entire compact capsule 1.06, without changing its layout slot. -->
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.12" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused" /><VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SkylineMarqueeCompactContentStyle" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="7" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="SkylineMarqueeCompactIconStyle" TargetType="Viewbox">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Sign-out confirmation: components/TvSignOutDialog.kt widens TvDialog.kt's card to 640dp.
       TvDialog.kt: scrim 78%, radius 22dp, 1dp PanelStroke, 30dp elevation; content 32/30/32/28dp,
       message top 8dp, actions top 24dp / gap 12dp. Colors/type come from TvPlayerChrome.kt. -->
  <SolidColorBrush x:Key="SkylineDialogScrim" Color="#C7000000" />
  <x:Double x:Key="SkylineDialogActionGap">12</x:Double>
  <Style x:Key="SkylineSignOutDialogCardStyle" TargetType="Grid">
    <Setter Property="Width" Value="640" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="services:SurfaceShadow.Elevation" Value="30" />
  </Style>
  <Style x:Key="SkylineDialogShadowMaskStyle" TargetType="Rectangle">
    <Setter Property="RadiusX" Value="22" /><Setter Property="RadiusY" Value="22" />
    <Setter Property="Fill" Value="Black" />
  </Style>
  <Style x:Key="SkylineDialogSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="#FF17181B" />
    <Setter Property="BorderBrush" Value="#1AFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="22" />
  </Style>
  <Style x:Key="SkylineDialogContentStyle" TargetType="StackPanel">
    <Setter Property="Margin" Value="32,30,32,28" />
  </Style>
  <!-- TvPlayerChrome.kt TvPlayerType.ConfirmTitle: Bold 24/30sp, -0.015em tracking, scaled 0.86. -->
  <Style x:Key="SkylineDialogTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SkylineFont}" />
    <Setter Property="FontSize" Value="20.64" /><Setter Property="LineHeight" Value="25.8" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="Bold" /><Setter Property="CharacterSpacing" Value="-15" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
  </Style>
  <!-- TvPlayerChrome.kt TvPlayerType.Body: Normal 15/22sp, Graphite = Paper at 60%. -->
  <Style x:Key="SkylineDialogMessageStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource SkylineFont}" />
    <Setter Property="FontSize" Value="12.9" /><Setter Property="LineHeight" Value="18.92" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="#99EDEDED" />
    <Setter Property="Margin" Value="0,8,0,0" /><Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SkylineDialogActionsStyle" TargetType="ItemsControl">
    <Setter Property="Margin" Value="0,24,0,0" />
  </Style>
  <!-- TvDialog.kt TvDialogButton: 44dp capsule, 26dp horizontal padding, no scale; focus elevation 12dp.
       TvPlayerChrome.kt Button is SemiBold 15/19sp; Default rests white 8%, focus Paper/Ink. -->
  <Style x:Key="SkylineDialogButtonStyle" TargetType="Button">
    <Setter Property="Height" Value="44" /><Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="22" /><Setter Property="Padding" Value="26,0" />
    <Setter Property="FontFamily" Value="{StaticResource SkylineFont}" />
    <Setter Property="FontSize" Value="12.9" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="#14FFFFFF" /><Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="services:SurfaceShadow.Elevation" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
