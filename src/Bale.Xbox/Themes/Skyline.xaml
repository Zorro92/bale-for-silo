              <StackPanel Spacing="3" VerticalAlignment="Center">
                <ContentPresenter Content="{TemplateBinding Content}" FontSize="12.04" Foreground="{StaticResource SkylineBackground}"
                                  Opacity="0.7" HorizontalAlignment="Center" />
