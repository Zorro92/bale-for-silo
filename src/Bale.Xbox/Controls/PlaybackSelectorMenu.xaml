<UserControl
    x:Class="Bale.Xbox.Controls.PlaybackSelectorMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bale.Xbox.Controls"
    xmlns:views="using:Bale.Xbox.Views"
    FontFamily="{StaticResource SkylineFont}">
  <!-- TvAnchoredSelectorMenu.kt: an anchored Skyline dropdown, not More Actions' centered dialog.
       No scrim; the transparent full-window layer captures outside clicks and modal focus. -->
  <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="Transparent" TabFocusNavigation="Cycle"
        Tapped="OnBackgroundTapped" PreviewKeyDown="OnMenuPreviewKeyDown">
    <controls:SkylinePanel x:Name="MenuPanel" Style="{StaticResource SkylinePlaybackSelectorPanelStyle}" SizeChanged="OnPanelSizeChanged">
      <StackPanel>
        <TextBlock x:Name="Header" Style="{StaticResource SkylinePlaybackSelectorHeaderStyle}" />
        <Grid>
          <ScrollViewer x:Name="Scroller" MaxHeight="{StaticResource SkylinePlaybackSelectorListHeight}"
                        VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" IsTabStop="False" ViewChanged="OnScrollChanged">
            <ItemsControl x:Name="Options" IsTabStop="False" HorizontalContentAlignment="Stretch">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="views:PlaybackOptionView">
                  <ToggleButton Style="{StaticResource SkylinePlaybackSelectorRowStyle}" IsChecked="{x:Bind Option.IsSelected}"
                                Click="OnOptionClick" GotFocus="OnOptionFocus" AutomationProperties.Name="{x:Bind AutomationName}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource SkylinePlaybackSelectorCheckSlot}" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Viewbox Style="{StaticResource SkylinePlaybackSelectorCheckStyle}" Visibility="{x:Bind CheckVisibility}">
                        <Path Width="{StaticResource SkylineMaterialIconCanvas}" Height="{StaticResource SkylineMaterialIconCanvas}"
                              Fill="{Binding Foreground, ElementName=OptionTitle}"
                              Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z" />
                      </Viewbox>
                      <StackPanel Grid.Column="1">
                        <TextBlock x:Name="OptionTitle" Text="{x:Bind Option.Title}" Style="{StaticResource SkylinePlaybackSelectorTitleStyle}" />
                        <TextBlock Text="{x:Bind Option.Detail}" Style="{StaticResource SkylinePlaybackSelectorDetailStyle}" Visibility="{x:Bind DetailVisibility}" />
                      </StackPanel>
                    </Grid>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Viewbox x:Name="TopOverflow" Style="{StaticResource SkylinePlaybackSelectorOverflowStyle}" VerticalAlignment="Top" Visibility="Collapsed">
            <Path Width="{StaticResource SkylineMaterialIconCanvas}" Height="{StaticResource SkylineMaterialIconCanvas}"
                  Fill="{StaticResource SkylineTertiary}" Data="M7.41,15.41 L12,10.83 L16.59,15.41 L18,14 L12,8 L6,14 Z" />
          </Viewbox>
          <Viewbox x:Name="BottomOverflow" Style="{StaticResource SkylinePlaybackSelectorOverflowStyle}" VerticalAlignment="Bottom" Visibility="Collapsed">
            <Path Width="{StaticResource SkylineMaterialIconCanvas}" Height="{StaticResource SkylineMaterialIconCanvas}"
                  Fill="{StaticResource SkylineTertiary}" Data="M7.41,8.59 L12,13.17 L16.59,8.59 L18,10 L12,16 L6,10 Z" />
          </Viewbox>
        </Grid>
      </StackPanel>
    </controls:SkylinePanel>
  </Grid>
</UserControl>
