    <None Include="../../src/Bale.Xbox/Bale.Xbox.csproj" Link="Bale.Xbox.csproj.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Bale.Xbox/Package.appxmanifest" Link="Package.appxmanifest" CopyToOutputDirectory="PreserveNewest" />
