<UserControl
    x:Class="Bale.Xbox.Controls.CardActionMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource SkylineFont}" IsTabStop="False" IsHitTestVisible="False">
  <Grid>
    <!-- TvMediaCardActions.kt's card-anchored popup, with the same surface/rows as Detail More Actions. -->
    <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="#C7000000" TabFocusNavigation="Cycle" Tapped="OnBackgroundTapped">
      <Border x:Name="MenuPanel" Width="276" Padding="8" CornerRadius="14" HorizontalAlignment="Left" VerticalAlignment="Top"
              Style="{StaticResource SkylineDetailDialogPanelStyle}" AutomationProperties.Name="Card actions">
        <StackPanel x:Name="Options" Spacing="3">
          <Button x:Name="PlayItem" Style="{StaticResource SkylineDetailMenuRowStyle}" Click="OnPlayClick" GotFocus="OnRowFocus" LostFocus="OnRowBlur">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Viewbox Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Path Width="24" Height="24" Fill="#FFEDEDED" Data="M8,5 L8,19 L19,12 Z" />
              </Viewbox>
              <TextBlock x:Name="PlayLabel" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>
          </Button>
          <Button x:Name="WatchedItem" Style="{StaticResource SkylineDetailMenuRowStyle}" Click="OnWatchedClick" GotFocus="OnRowFocus" LostFocus="OnRowBlur">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Viewbox Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid Width="24" Height="24">
                  <Path x:Name="CheckIcon" Fill="#FFEDEDED" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z" />
                  <Path x:Name="UnwatchedIcon" Fill="#FFEDEDED" Visibility="Collapsed"
                        Data="M12,6 C15.79,6 19.17,8.13 20.82,11.5 C20.23,12.72 19.4,13.77 18.41,14.62 L19.83,16.04 C21.21,14.81 22.31,13.26 23,11.5 C21.27,7.11 17,4 12,4 C10.6,4 9.26,4.25 8.01,4.7 L9.66,6.35 C10.41,6.13 11.19,6 12,6 Z M2.71,2.29 L1.29,3.71 L4.08,6.5 C2.62,7.77 1.48,9.39 1,11.5 C2.73,15.89 7,19 12,19 C13.55,19 15.03,18.7 16.38,18.16 L20.29,22.07 L21.71,20.66 Z M12,17 C8.21,17 4.83,14.87 3.18,11.5 C3.77,10.28 4.6,9.23 5.59,8.38 L7.73,10.52 C7.58,11 7.5,11.49 7.5,12 C7.5,14.49 9.51,16.5 12,16.5 C12.51,16.5 13,16.42 13.48,16.27 L14.76,17.55 C13.88,17.84 12.96,18 12,18 Z" />
                </Grid>
              </Viewbox>
              <TextBlock x:Name="WatchedLabel" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>
          </Button>
          <Button x:Name="FavoriteItem" Style="{StaticResource SkylineDetailMenuRowStyle}" Click="OnFavoriteClick" GotFocus="OnRowFocus" LostFocus="OnRowBlur">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Viewbox Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid Width="24" Height="24">
                  <Path x:Name="FavoriteIcon" Fill="#FFEDEDED" Visibility="Collapsed"
                        Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 Z" />
                  <Path x:Name="FavoriteBorderIcon" Fill="#FFEDEDED"
                        Data="M16.5,3 C14.76,3 13.09,3.81 12,5.09 C10.91,3.81 9.24,3 7.5,3 C4.42,3 2,5.42 2,8.5 C2,12.28 5.4,15.36 10.55,20.03 L12,21.35 L13.45,20.03 C18.6,15.36 22,12.28 22,8.5 C22,5.42 19.58,3 16.5,3 Z M12.1,18.55 L12,18.65 L11.9,18.55 C7.14,14.24 4,11.39 4,8.5 C4,6.5 5.5,5 7.5,5 C9.04,5 10.54,5.99 11.07,7.36 L12.93,7.36 C13.46,5.99 14.96,5 16.5,5 C18.5,5 20,6.5 20,8.5 C20,11.39 16.86,14.24 12.1,18.55 Z" />
                </Grid>
              </Viewbox>
              <TextBlock x:Name="FavoriteLabel" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>
          </Button>
          <Button x:Name="WatchlistItem" Style="{StaticResource SkylineDetailMenuRowStyle}" Click="OnWatchlistClick" GotFocus="OnRowFocus" LostFocus="OnRowBlur">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Viewbox Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Grid Width="24" Height="24">
                  <Path x:Name="BookmarkAddIcon" Fill="#FFEDEDED"
                        Data="M17,3 L7,3 C5.9,3 5,3.9 5,5 L5,21 L12,18 L19,21 L19,5 C19,3.9 18.1,3 17,3 Z M17,18 L12,15.82 L7,18 L7,5 L17,5 Z M11,7 L11,9 L9,9 L9,11 L11,11 L11,13 L13,13 L13,11 L15,11 L15,9 L13,9 L13,7 Z" />
                  <Path x:Name="BookmarkRemoveIcon" Fill="#FFEDEDED" Visibility="Collapsed"
                        Data="M17,3 L7,3 C5.9,3 5,3.9 5,5 L5,21 L12,18 L19,21 L19,5 C19,3.9 18.1,3 17,3 Z M17,18 L12,15.82 L7,18 L7,5 L17,5 Z M9,9 L15,9 L15,11 L9,11 Z" />
                </Grid>
              </Viewbox>
              <TextBlock x:Name="WatchlistLabel" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>
          </Button>
          <Button x:Name="RemoveItem" Style="{StaticResource SkylineDetailMenuRowStyle}" Click="OnRemoveClick" GotFocus="OnRowFocus" LostFocus="OnRowBlur">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Viewbox Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Path Width="24" Height="24" Fill="#FFEDEDED"
                      Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z" />
              </Viewbox>
              <TextBlock x:Name="RemoveLabel" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
    <!-- A failed optimistic write is announced without stealing the card's restored focus. -->
    <Border x:Name="StatusPanel" Style="{StaticResource SkylineDetailDialogPanelStyle}" Visibility="Collapsed" IsHitTestVisible="False"
            VerticalAlignment="Bottom" Margin="24" Padding="16,10" MaxWidth="560" AutomationProperties.LiveSetting="Assertive">
      <TextBlock x:Name="StatusText" FontSize="12" Foreground="#FFEDEDED" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
