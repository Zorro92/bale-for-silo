<Page
    x:Class="Bale.Xbox.ServerListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bale.Xbox.Controls"
    NavigationCacheMode="Required"
    FontFamily="{StaticResource SkylineFont}"
    Background="{StaticResource SkylineBackground}">
  <!-- TvAccountsScreen.kt (Settings › Accounts, the TvRoute.ServerList route): the settings pane header, then per
       server its accounts, Add an account on it and Remove Server; then Add a server and the footer. -->
  <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Style="{StaticResource SkylineSettingsLayoutStyle}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Style="{StaticResource SkylineSettingsPaneHeaderStyle}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource SkylineSettingsPaneTileStyle}">
          <Viewbox Style="{StaticResource SkylineSettingsPaneGlyphStyle}">
            <Path Style="{StaticResource SkylineSettingsGlyphStyle}" Data="M20,3 H4 C2.9,3 2,3.9 2,5 V9 C2,10.1 2.9,11 4,11 H20 C21.1,11 22,10.1 22,9 V5 C22,3.9 21.1,3 20,3 Z M20,9 H4 V5 H20 Z M6,6 H8 V8 H6 Z M20,13 H4 C2.9,13 2,13.9 2,15 V19 C2,20.1 2.9,21 4,21 H20 C21.1,21 22,20.1 22,19 V15 C22,13.9 21.1,13 20,13 Z M20,19 H4 V15 H20 Z M6,16 H8 V18 H6 Z" />
          </Viewbox>
        </Border>
        <StackPanel Grid.Column="1" Style="{StaticResource SkylineSettingsPaneHeaderTextStyle}">
          <TextBlock Text="Accounts" Style="{StaticResource SkylineSettingsPaneTitleStyle}" />
          <TextBlock Text="Servers and the accounts signed in to them on this TV." Style="{StaticResource SkylineSettingsPaneBlurbStyle}" />
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="Scroller" Grid.Row="1" Style="{StaticResource SkylineSettingsDetailScrollerStyle}">
        <StackPanel Style="{StaticResource SkylineSettingsGroupsStyle}">
          <StackPanel x:Name="Rows" Style="{StaticResource SkylineSettingsGroupStyle}" />
          <TextBlock x:Name="ErrorText" Style="{StaticResource SkylineSettingsErrorStyle}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <controls:ConnectionDialog x:Name="RemovePrompt" />
    <controls:SignOutDialog x:Name="SignOutPrompt" />
  </Grid>
</Page>
