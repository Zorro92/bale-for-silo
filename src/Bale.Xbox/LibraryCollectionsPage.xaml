<Page
    x:Class="Bale.Xbox.LibraryCollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    FontFamily="{StaticResource SkylineFont}"
    Background="{StaticResource SkylineBackground}">
  <Page.Resources>
    <!-- screens/library/TvLibraryDetailScreen.kt TvCollectionCard: 2:3 art, VideoLibrary fallback,
         8dp corners and a single 15.5/18.5sp caption 11dp below the poster. -->
    <DataTemplate x:Key="CollectionTemplate" x:DataType="views:LibraryCollectionCardView">
      <StackPanel Width="{x:Bind Poster.Width, Mode=OneWay}" Margin="{x:Bind Poster.GridHeadroom, Mode=OneWay}" Spacing="{StaticResource SkylineCatalogCaptionGap}">
        <Grid x:Name="Art" Width="{x:Bind Poster.Width, Mode=OneWay}" Height="{x:Bind Poster.Height, Mode=OneWay}">
          <Grid CornerRadius="{StaticResource SkylineCardRadius}" Background="{StaticResource SkylineCollectionPlaceholder}">
            <Viewbox Style="{StaticResource SkylineCollectionFallbackStyle}" Visibility="{x:Bind Poster.FallbackVisibility, Mode=OneWay}">
              <Path Style="{StaticResource SkylineCollectionFallbackGlyphStyle}" Data="M4,6 H2 V20 C2,21.1 2.9,22 4,22 H18 V20 H4 Z M20,2 H8 C6.9,2 6,2.9 6,4 V16 C6,17.1 6.9,18 8,18 H20 C21.1,18 22,17.1 22,16 V4 C22,2.9 21.1,2 20,2 Z M12,14.5 V5.5 L18,10 Z" />
            </Viewbox>
            <Image Source="{x:Bind Poster.Image, Mode=OneWay}" Stretch="UniformToFill" />
          </Grid>
          <Border x:Name="FocusGlow" Style="{StaticResource SkylineDetailPosterGlowStyle}" />
          <Border x:Name="FocusRing" Style="{StaticResource SkylineDetailPosterRingStyle}" />
        </Grid>
        <Grid>
          <TextBlock Text="{x:Bind Poster.Title}" Style="{StaticResource SkylineCatalogCardTitleStyle}" />
          <TextBlock x:Name="FocusCaption" Text="{x:Bind Poster.Title}" Style="{StaticResource SkylineCatalogCardTitleStyle}"
                     Foreground="{StaticResource SkylineFocusRing}" Opacity="0" IsHitTestVisible="False" />
        </Grid>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="CollectionHeaderTemplate" x:DataType="views:LibraryCollectionRowView">
      <TextBlock Text="{x:Bind Header}" Style="{StaticResource SkylineCollectionsGroupHeaderStyle}">
        <TextBlock.RenderTransform><TranslateTransform Y="{StaticResource SkylineCollectionsHeaderNudge}" /></TextBlock.RenderTransform>
      </TextBlock>
    </DataTemplate>
    <DataTemplate x:Key="CollectionCardsTemplate" x:DataType="views:LibraryCollectionRowView">
      <!-- Each visual row is a wrapping vertical grid, not a horizontally scrolling card rail. -->
      <GridView ItemsSource="{x:Bind Cards}" ItemTemplate="{StaticResource CollectionTemplate}"
                Style="{StaticResource SkylineCollectionsRowStyle}" ItemContainerStyle="{StaticResource SkylineCatalogGridItemStyle}"
                ItemClick="OnCollectionClick" GotFocus="OnCollectionFocus" LostFocus="OnCollectionBlur">
        <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" /></ItemsPanelTemplate></GridView.ItemsPanel>
      </GridView>
    </DataTemplate>
    <views:LibraryCollectionRowTemplateSelector x:Key="CollectionRowsTemplate" HeaderTemplate="{StaticResource CollectionHeaderTemplate}" CardsTemplate="{StaticResource CollectionCardsTemplate}" />
  </Page.Resources>

  <!-- screens/library/TvLibraryDetailScreen.kt CollectionsTab: full-span headers, six columns,
       20/30dp gaps, content below the shell's 94dp inset, and no title or Browse toolbar. -->
  <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
    <ScrollViewer x:Name="Scroller" Style="{StaticResource SkylineCollectionsScrollerStyle}">
      <Grid>
        <ItemsControl x:Name="Rows" IsTabStop="False" ItemTemplateSelector="{StaticResource CollectionRowsTemplate}" PreviewKeyDown="OnGridPreviewKeyDown" />
        <ProgressRing x:Name="LoadingRing" Style="{StaticResource SkylineCollectionsLoadingStyle}" Visibility="Collapsed" IsActive="False" />
        <TextBlock x:Name="EmptyMessage" Text="No collections in this library." Style="{StaticResource SkylineCollectionsEmptyStyle}" Visibility="Collapsed" />
        <StackPanel x:Name="ErrorPanel" Style="{StaticResource SkylineCollectionsErrorStyle}" Visibility="Collapsed">
          <TextBlock x:Name="ErrorMessage" Style="{StaticResource SkylineCollectionsErrorTextStyle}" />
          <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource SkylineCollectionRetryStyle}" Click="OnRetryClick" />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Page>
