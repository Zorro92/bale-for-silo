<Frame
    x:Class="Bale.Xbox.Services.PageFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Frame.Template>
    <ControlTemplate TargetType="Frame">
      <Grid Background="{TemplateBinding Background}">
        <!-- PageFrame puts pages in these Borders itself (not TemplateBinding) so the outgoing page
             stays loaded until its fade ends. Borders, because AOT can't cast a ContentPresenter. -->
        <Border x:Name="FirstPresenter" />
        <Border x:Name="SecondPresenter" />
      </Grid>
    </ControlTemplate>
  </Frame.Template>
</Frame>
