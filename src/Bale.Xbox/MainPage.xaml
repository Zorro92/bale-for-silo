<Page
    x:Class="Bale.Xbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SkylineBackground}">

  <!-- Full-screen auth flow: no top bar (guide §3), same wordmark position as the shell. -->
  <Grid>
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="44,28,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
      <TextBlock Text="BALE" FontSize="{StaticResource SkylineWordmarkSize}" FontWeight="ExtraBold" CharacterSpacing="340" VerticalAlignment="Center" />
      <TextBlock Text="a client for Silo" FontSize="9" Foreground="{StaticResource SkylineTertiary}" VerticalAlignment="Center" />
    </StackPanel>

    <!-- Step 1: which server -->
    <StackPanel x:Name="ServerPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Spacing="12">
      <TextBlock Text="Connect to your Silo server" FontSize="{StaticResource SkylineScreenTitleSize}" FontWeight="Bold" />
      <TextBox x:Name="ServerBox" PlaceholderText="silo.example.com" InputScope="Url" KeyDown="OnServerBoxKeyDown" Style="{StaticResource SkylineTextBoxStyle}" />
      <Button x:Name="ConnectButton" Content="Continue" Click="OnConnectClick" HorizontalAlignment="Stretch" Style="{StaticResource SkylineButtonStyle}" />
      <TextBlock x:Name="ServerError" FontSize="{StaticResource SkylineBodySize}" Foreground="{StaticResource SkylineError}" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>

    <!-- Step 2: show the pairing code -->
    <StackPanel x:Name="CodePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Visibility="Collapsed">
      <TextBlock Text="On your phone or computer, go to" FontSize="{StaticResource SkylineBodySize}" Foreground="{StaticResource SkylineSecondary}" HorizontalAlignment="Center" />
      <TextBlock x:Name="ActivateText" FontSize="{StaticResource SkylineScreenTitleSize}" FontWeight="Bold" HorizontalAlignment="Center" />
      <TextBlock Text="and enter the code" FontSize="{StaticResource SkylineBodySize}" Foreground="{StaticResource SkylineSecondary}" HorizontalAlignment="Center" Margin="0,8,0,0" />
      <TextBlock x:Name="CodeText" FontSize="{StaticResource SkylineMarqueeTitleSize}" FontWeight="ExtraBold" CharacterSpacing="160" HorizontalAlignment="Center" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
        <ProgressRing IsActive="True" Width="12" Height="12" Foreground="{StaticResource SkylineSecondary}" />
        <TextBlock x:Name="PairingStatus" Text="Waiting for approval" FontSize="{StaticResource SkylineBodySize}" Foreground="{StaticResource SkylineSecondary}" />
      </StackPanel>
      <Button x:Name="CancelPairingButton" Content="Use a Different Server" Click="OnCancelPairingClick" HorizontalAlignment="Center"
              Margin="0,16,0,0" Style="{StaticResource SkylineButtonStyle}" />
    </StackPanel>

    <ProgressRing x:Name="BusyRing" Width="32" Height="32" Foreground="{StaticResource SkylinePrimary}" Visibility="Collapsed" />
  </Grid>
</Page>
