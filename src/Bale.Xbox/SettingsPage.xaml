<Page
    x:Class="Bale.Xbox.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bale.Xbox.Controls"
    NavigationCacheMode="Required"
    FontFamily="{StaticResource SkylineFont}"
    Background="{StaticResource SkylineBackground}">
  <!-- TvSettingsScreen.kt: this is an outer-frame route, not content beneath the top menu. -->
  <Grid x:Name="Root" PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp">
    <Grid Style="{StaticResource SkylineSettingsLayoutStyle}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid x:Name="CategoryRail" Style="{StaticResource SkylineSettingsRailStyle}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Style="{StaticResource SkylineSettingsRailTopStyle}">
          <TextBlock Text="Settings" Style="{StaticResource SkylineSettingsTitleStyle}" />
          <Button x:Name="AccountButton" Style="{StaticResource SkylineSettingsAccountButtonStyle}" Click="OnAccountClick" AutomationProperties.Name="Switch Profile">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Grid Style="{StaticResource SkylineSettingsAvatarStyle}">
                <Ellipse Style="{StaticResource SkylineSettingsAvatarFillStyle}" />
                <TextBlock x:Name="AvatarInitial" Style="{StaticResource SkylineSettingsAvatarInitialStyle}" />
                <Ellipse x:Name="AvatarPicture" Visibility="Collapsed" />
              </Grid>
              <StackPanel Grid.Column="1" Style="{StaticResource SkylineSettingsAccountTextStyle}">
                <TextBlock x:Name="AccountName" Style="{StaticResource SkylineSettingsAccountNameStyle}" />
                <TextBlock x:Name="AccountSubtitle" Style="{StaticResource SkylineSettingsAccountSubtitleStyle}" />
              </StackPanel>
            </Grid>
          </Button>
          <StackPanel Style="{StaticResource SkylineSettingsCategoriesStyle}">
            <ToggleButton x:Name="GeneralCategory" Content="General" Tag="App and navigation" Style="{StaticResource SkylineSettingsCategoryStyle}" GotFocus="OnCategoryFocus" Click="OnCategoryClick" />
            <ToggleButton x:Name="PlaybackCategory" Content="Playback" Tag="Quality and episodes" Style="{StaticResource SkylineSettingsCategoryStyle}" GotFocus="OnCategoryFocus" Click="OnCategoryClick" />
            <ToggleButton x:Name="ServerCategory" Content="Server" Tag="Connection and version" Style="{StaticResource SkylineSettingsCategoryStyle}" GotFocus="OnCategoryFocus" Click="OnCategoryClick" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="SignOutButton" Content="Sign Out" Style="{StaticResource SkylineSettingsSignOutStyle}" Click="OnSignOutClick" GotFocus="OnSignOutFocus" />
          <TextBlock x:Name="RailVersion" Style="{StaticResource SkylineSettingsVersionStyle}" />
        </StackPanel>
      </Grid>
      <Grid x:Name="DetailPane" Grid.Column="1" Style="{StaticResource SkylineSettingsPaneStyle}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Style="{StaticResource SkylineSettingsPaneHeaderStyle}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource SkylineSettingsPaneTileStyle}">
            <Viewbox Style="{StaticResource SkylineSettingsPaneGlyphStyle}">
              <Grid>
                <Path x:Name="GeneralHeaderIcon" Style="{StaticResource SkylineSettingsGlyphStyle}" Data="M19.43,12.98 C19.47,12.66 19.5,12.34 19.5,12 C19.5,11.66 19.47,11.34 19.43,11.02 L21.54,9.37 L19.54,5.91 L17.05,6.91 C16.54,6.52 15.98,6.19 15.37,5.94 L15,3 H9 L8.63,5.94 C8.02,6.19 7.46,6.52 6.95,6.91 L4.46,5.91 L2.46,9.37 L4.57,11.02 C4.53,11.34 4.5,11.66 4.5,12 C4.5,12.34 4.53,12.66 4.57,12.98 L2.46,14.63 L4.46,18.09 L6.95,17.09 C7.46,17.48 8.02,17.81 8.63,18.06 L9,21 H15 L15.37,18.06 C15.98,17.81 16.54,17.48 17.05,17.09 L19.54,18.09 L21.54,14.63 Z M12,15.5 C10.07,15.5 8.5,13.93 8.5,12 C8.5,10.07 10.07,8.5 12,8.5 C13.93,8.5 15.5,10.07 15.5,12 C15.5,13.93 13.93,15.5 12,15.5 Z" />
                <Path x:Name="PlaybackHeaderIcon" Style="{StaticResource SkylineSettingsGlyphStyle}" Visibility="Collapsed" Data="M20,4 H4 C2.9,4 2,4.9 2,6 V18 C2,19.1 2.9,20 4,20 H20 C21.1,20 22,19.1 22,18 V6 C22,4.9 21.1,4 20,4 Z M20,18 H4 V6 H20 Z M9.5,16.5 V7.5 L16.5,12 Z" />
                <Path x:Name="ServerHeaderIcon" Style="{StaticResource SkylineSettingsGlyphStyle}" Visibility="Collapsed" Data="M20,3 H4 C2.9,3 2,3.9 2,5 V9 C2,10.1 2.9,11 4,11 H20 C21.1,11 22,10.1 22,9 V5 C22,3.9 21.1,3 20,3 Z M20,9 H4 V5 H20 Z M6,6 H8 V8 H6 Z M20,13 H4 C2.9,13 2,13.9 2,15 V19 C2,20.1 2.9,21 4,21 H20 C21.1,21 22,20.1 22,19 V15 C22,13.9 21.1,13 20,13 Z M20,19 H4 V15 H20 Z M6,16 H8 V18 H6 Z" />
              </Grid>
            </Viewbox>
          </Border>
          <StackPanel Grid.Column="1" Style="{StaticResource SkylineSettingsPaneHeaderTextStyle}">
            <TextBlock x:Name="PaneTitle" Style="{StaticResource SkylineSettingsPaneTitleStyle}" />
            <TextBlock x:Name="PaneBlurb" Style="{StaticResource SkylineSettingsPaneBlurbStyle}" />
          </StackPanel>
        </Grid>
        <ScrollViewer x:Name="DetailScroller" Grid.Row="1" Style="{StaticResource SkylineSettingsDetailScrollerStyle}">
          <Grid>
            <StackPanel x:Name="GeneralPane" Style="{StaticResource SkylineSettingsGroupsStyle}">
              <StackPanel Style="{StaticResource SkylineSettingsGroupStyle}">
                <TextBlock Text="PROFILE AT LAUNCH" Style="{StaticResource SkylineSettingsGroupHeaderStyle}" />
                <Button x:Name="ProfileSelectionButton" Style="{StaticResource SkylineSettingsValueRowStyle}" Click="OnProfileSelectionClick">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Profile Selection" Style="{StaticResource SkylineSettingsRowTextStyle}" />
                    <TextBlock x:Name="ProfileSelectionValue" Grid.Column="1" Style="{StaticResource SkylineSettingsValueTextStyle}" />
                  </Grid>
                </Button>
                <TextBlock x:Name="ProfileSelectionDescription" Style="{StaticResource SkylineSettingsFooterStyle}" />
              </StackPanel>
              <StackPanel Style="{StaticResource SkylineSettingsGroupStyle}">
                <TextBlock Text="HOME SECTIONS" Style="{StaticResource SkylineSettingsGroupHeaderStyle}" />
                <Button x:Name="HomeSectionsButton" Style="{StaticResource SkylineSettingsValueRowStyle}" Click="OnHomeSectionsClick">
                  <TextBlock Text="Home Sections" Style="{StaticResource SkylineSettingsRowTextStyle}" />
                </Button>
                <TextBlock Text="Choose which Home rows are visible and edit the order in which they appear on this Xbox." Style="{StaticResource SkylineSettingsFooterStyle}" />
              </StackPanel>
              <TextBlock x:Name="SettingsError" Style="{StaticResource SkylineSettingsErrorStyle}" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="PlaybackPane" Style="{StaticResource SkylineSettingsGroupsStyle}" Visibility="Collapsed">
              <!-- TvSettingsScreen.kt "Streaming": only the rows Bale honors (buffering quality and the learned limit). -->
              <StackPanel x:Name="StreamingGroup" Style="{StaticResource SkylineSettingsGroupStyle}" Visibility="Collapsed">
                <TextBlock Text="STREAMING" Style="{StaticResource SkylineSettingsGroupHeaderStyle}" />
                <Button x:Name="BufferingQualityButton" Style="{StaticResource SkylineSettingsValueRowStyle}" Click="OnBufferingQualityClick" Visibility="Collapsed">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="BufferingQualityLabel" Style="{StaticResource SkylineSettingsRowTextStyle}" />
                    <TextBlock x:Name="BufferingQualityValue" Grid.Column="1" Style="{StaticResource SkylineSettingsValueTextStyle}" />
                  </Grid>
                </Button>
                <TextBlock x:Name="BufferingQualityDescription" Style="{StaticResource SkylineSettingsFooterStyle}" Visibility="Collapsed" />
                <Button x:Name="LearnedLimitButton" Style="{StaticResource SkylineSettingsValueRowStyle}" Click="OnLearnedLimitResetClick" Visibility="Collapsed">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LearnedLimitLabel" Style="{StaticResource SkylineSettingsRowTextStyle}" />
                    <TextBlock x:Name="LearnedLimitValue" Grid.Column="1" Style="{StaticResource SkylineSettingsValueTextStyle}" />
                  </Grid>
                </Button>
                <TextBlock x:Name="LearnedLimitError" Style="{StaticResource SkylineSettingsFooterStyle}" Visibility="Collapsed" />
              </StackPanel>
              <!-- TvConnectionSettings.kt: shown only while the server measures speed; a metered link gets the note instead. -->
              <StackPanel x:Name="ConnectionGroup" Style="{StaticResource SkylineSettingsGroupStyle}" Visibility="Collapsed">
                <TextBlock Text="CONNECTION" Style="{StaticResource SkylineSettingsGroupHeaderStyle}" />
                <Button x:Name="ConnectionSpeedButton" Style="{StaticResource SkylineSettingsValueRowStyle}" Click="OnTestSpeedClick">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="ConnectionSpeedLabel" Style="{StaticResource SkylineSettingsRowTextStyle}" />
                    <TextBlock x:Name="ConnectionSpeedValue" Grid.Column="1" Style="{StaticResource SkylineSettingsValueTextStyle}" />
                  </Grid>
                </Button>
                <Border x:Name="ConnectionSpeedInfoRow" Style="{StaticResource SkylineSettingsInfoRowStyle}" Visibility="Collapsed">
                  <TextBlock x:Name="ConnectionSpeedInfoLabel" Style="{StaticResource SkylineSettingsInfoLabelStyle}" />
                </Border>
                <TextBlock x:Name="ConnectionSkipped" Style="{StaticResource SkylineSettingsFooterStyle}" Visibility="Collapsed" />
                <TextBlock x:Name="ConnectionSpeedLine" Style="{StaticResource SkylineSettingsFooterStyle}" Visibility="Collapsed" />
                <TextBlock x:Name="ConnectionNotice" Style="{StaticResource SkylineSettingsFooterStyle}" Visibility="Collapsed" />
                <TextBlock x:Name="ConnectionBudget" Style="{StaticResource SkylineSettingsFooterStyle}" Visibility="Collapsed" />
              </StackPanel>
              <StackPanel Style="{StaticResource SkylineSettingsGroupStyle}">
                <TextBlock Text="EPISODES" Style="{StaticResource SkylineSettingsGroupHeaderStyle}" />
                <Button x:Name="AutoPlayButton" Style="{StaticResource SkylineSettingsValueRowStyle}" Click="OnAutoPlayClick">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Auto-Play Next Episode" Style="{StaticResource SkylineSettingsRowTextStyle}" />
                    <TextBlock x:Name="AutoPlayValue" Grid.Column="1" Style="{StaticResource SkylineSettingsValueTextStyle}" />
                  </Grid>
                </Button>
                <Button x:Name="AutoPlayProfileButton" Style="{StaticResource SkylineSettingsValueRowStyle}" Click="OnAutoPlayProfileClick" Visibility="Collapsed"
                        AutomationProperties.Name="Use profile setting for Auto-Play Next Episode">
                  <TextBlock Text="Use Profile Setting" Style="{StaticResource SkylineSettingsRowTextStyle}" />
                </Button>
                <TextBlock x:Name="AutoPlayDescription" Style="{StaticResource SkylineSettingsFooterStyle}" />
              </StackPanel>
              <!-- Owner-requested deviation from the official Silo apps (they never tone-map on the device): the SDR white of
                   the console tone map (Bale's stage and rav1g's display pass), a value row and picker like Buffering Quality's. -->
              <StackPanel Style="{StaticResource SkylineSettingsGroupStyle}">
                <TextBlock Text="HDR ON SDR TVS" Style="{StaticResource SkylineSettingsGroupHeaderStyle}" />
                <Button x:Name="SdrBrightnessButton" Style="{StaticResource SkylineSettingsValueRowStyle}" Click="OnSdrBrightnessClick">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="SDR Brightness" Style="{StaticResource SkylineSettingsRowTextStyle}" />
                    <TextBlock x:Name="SdrBrightnessValue" Grid.Column="1" Style="{StaticResource SkylineSettingsValueTextStyle}" />
                  </Grid>
                </Button>
                <TextBlock Text="How bright HDR video looks when this Xbox tone-maps it for an SDR TV. Higher is brighter; Default matches the reference white of 100 nits." Style="{StaticResource SkylineSettingsFooterStyle}" />
              </StackPanel>
              <!-- Owner-requested deviation from the official Silo apps: opt-in GPU grain for the AV1 fallback. -->
              <StackPanel Style="{StaticResource SkylineSettingsGroupStyle}">
                <TextBlock Text="EXPERIMENTAL" Style="{StaticResource SkylineSettingsGroupHeaderStyle}" />
                <Button x:Name="Dav1dGpuFilmGrainButton" Style="{StaticResource SkylineSettingsValueRowStyle}" Click="OnDav1dGpuFilmGrainClick">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="GPU film grain (AV1 fallback)" Style="{StaticResource SkylineSettingsRowTextStyle}" />
                    <TextBlock x:Name="Dav1dGpuFilmGrainValue" Grid.Column="1" Style="{StaticResource SkylineSettingsValueTextStyle}" />
                  </Grid>
                </Button>
                <TextBlock Text="Applies AV1 film grain on the GPU when the software decoder plays. May help slower consoles." Style="{StaticResource SkylineSettingsFooterStyle}" />
              </StackPanel>
              <TextBlock x:Name="PlaybackError" Style="{StaticResource SkylineSettingsErrorStyle}" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="ServerPane" Style="{StaticResource SkylineSettingsGroupsStyle}" Visibility="Collapsed">
              <StackPanel Style="{StaticResource SkylineSettingsGroupStyle}">
                <TextBlock Text="ACTIVE SERVER" Style="{StaticResource SkylineSettingsGroupHeaderStyle}" />
                <Border Style="{StaticResource SkylineSettingsInfoRowStyle}">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Server" Style="{StaticResource SkylineSettingsInfoLabelStyle}" />
                    <TextBlock x:Name="ServerName" Grid.Column="1" Style="{StaticResource SkylineSettingsInfoValueStyle}" />
                  </Grid>
                </Border>
                <Border Style="{StaticResource SkylineSettingsAddressRowStyle}">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Address" Style="{StaticResource SkylineSettingsInfoLabelStyle}" />
                    <TextBlock x:Name="ServerAddress" Grid.Column="1" Style="{StaticResource SkylineSettingsAddressStyle}" />
                  </Grid>
                </Border>
                <!-- TvSettingsScreen.kt: Settings › Accounts, every saved server and its accounts, where the server list was. -->
                <Button x:Name="AccountsButton" Style="{StaticResource SkylineSettingsValueRowStyle}" Click="OnAccountsClick">
                  <TextBlock Text="Accounts" Style="{StaticResource SkylineSettingsRowTextStyle}" />
                </Button>
              </StackPanel>
              <StackPanel Style="{StaticResource SkylineSettingsGroupStyle}">
                <TextBlock Text="ABOUT" Style="{StaticResource SkylineSettingsGroupHeaderStyle}" />
                <Border Style="{StaticResource SkylineSettingsInfoRowStyle}">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="App Version" Style="{StaticResource SkylineSettingsInfoLabelStyle}" />
                    <TextBlock x:Name="AppVersion" Grid.Column="1" Style="{StaticResource SkylineSettingsInfoValueStyle}" />
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Grid>
    </Grid>
    <!-- TvSettingsPickerSheet: only policies Bale actually honors at launch are offered. -->
    <Grid x:Name="ProfilePicker" Visibility="Collapsed" Background="{StaticResource SkylineSettingsPickerScrim}">
      <Border Style="{StaticResource SkylineSettingsPickerCardStyle}">
        <StackPanel>
          <Grid Style="{StaticResource SkylineSettingsPickerHeaderStyle}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource SkylineSettingsPickerTitleStyle}">
              <TextBlock Text="Profile Selection" Style="{StaticResource SkylineSettingsPaneTitleStyle}" />
              <TextBlock Text="Choose an option" Style="{StaticResource SkylineSettingsPickerHintTextStyle}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource SkylineSettingsPickerHintStyle}">
              <StackPanel Style="{StaticResource SkylineSettingsPickerHintContentStyle}">
                <Viewbox Style="{StaticResource SkylineSettingsPickerHintIconStyle}"><Path Style="{StaticResource SkylineSettingsGlyphStyle}" Opacity="{StaticResource SkylineSettingsHintOpacity}" Data="M12.5,8 C9.85,8 7.45,8.99 5.6,10.6 L2,7 V16 H11 L7.38,12.38 C8.77,11.22 10.54,10.5 12.5,10.5 C16.04,10.5 19.05,12.81 20.1,16 L22.47,15.22 C21.08,11.03 17.15,8 12.5,8 Z" /></Viewbox>
                <TextBlock Text="Back to close" Style="{StaticResource SkylineSettingsPickerHintTextStyle}" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource SkylineSettingsPickerDividerStyle}" />
          <StackPanel Style="{StaticResource SkylineSettingsPickerOptionsStyle}">
            <Button x:Name="AutomaticButton" Tag="automatic" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnPolicyClick">
              <StackPanel><TextBlock Text="Automatic" Style="{StaticResource SkylineSettingsRowTextStyle}" /><TextBlock Text="Use the last selected profile when Bale launches. A protected profile can reopen without its PIN." Style="{StaticResource SkylineSettingsPickerDetailStyle}" /></StackPanel>
            </Button>
            <Button x:Name="EveryTimeButton" Tag="askEveryLaunch" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnPolicyClick">
              <StackPanel><TextBlock Text="Every Time" Style="{StaticResource SkylineSettingsRowTextStyle}" /><TextBlock Text="Show Who's Watching each time Bale launches." Style="{StaticResource SkylineSettingsPickerDetailStyle}" /></StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <!-- TvSettingsScreen.kt PlaybackPicker.BufferingQualityMode: "Use profile setting" leads, then the modes. -->
    <Grid x:Name="BufferingPicker" Visibility="Collapsed" Background="{StaticResource SkylineSettingsPickerScrim}">
      <Border Style="{StaticResource SkylineSettingsPickerCardStyle}">
        <StackPanel>
          <Grid Style="{StaticResource SkylineSettingsPickerHeaderStyle}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource SkylineSettingsPickerTitleStyle}">
              <TextBlock x:Name="BufferingPickerTitle" Style="{StaticResource SkylineSettingsPaneTitleStyle}" />
              <TextBlock Text="Choose an option" Style="{StaticResource SkylineSettingsPickerHintTextStyle}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource SkylineSettingsPickerHintStyle}">
              <StackPanel Style="{StaticResource SkylineSettingsPickerHintContentStyle}">
                <Viewbox Style="{StaticResource SkylineSettingsPickerHintIconStyle}"><Path Style="{StaticResource SkylineSettingsGlyphStyle}" Opacity="{StaticResource SkylineSettingsHintOpacity}" Data="M12.5,8 C9.85,8 7.45,8.99 5.6,10.6 L2,7 V16 H11 L7.38,12.38 C8.77,11.22 10.54,10.5 12.5,10.5 C16.04,10.5 19.05,12.81 20.1,16 L22.47,15.22 C21.08,11.03 17.15,8 12.5,8 Z" /></Viewbox>
                <TextBlock Text="Back to close" Style="{StaticResource SkylineSettingsPickerHintTextStyle}" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource SkylineSettingsPickerDividerStyle}" />
          <StackPanel Style="{StaticResource SkylineSettingsPickerOptionsStyle}">
            <Button x:Name="BufferingProfileOption" Tag="profile" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnBufferingOptionClick">
              <TextBlock x:Name="BufferingProfileOptionText" Style="{StaticResource SkylineSettingsRowTextStyle}" />
            </Button>
            <Button x:Name="BufferingNeverOption" Tag="never" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnBufferingOptionClick">
              <TextBlock x:Name="BufferingNeverOptionText" Style="{StaticResource SkylineSettingsRowTextStyle}" />
            </Button>
            <Button x:Name="BufferingAskOption" Tag="ask" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnBufferingOptionClick">
              <TextBlock x:Name="BufferingAskOptionText" Style="{StaticResource SkylineSettingsRowTextStyle}" />
            </Button>
            <Button x:Name="BufferingAlwaysOption" Tag="always" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnBufferingOptionClick">
              <TextBlock x:Name="BufferingAlwaysOptionText" Style="{StaticResource SkylineSettingsRowTextStyle}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <!-- SDR Brightness (owner's deviation): the same TvSettingsPickerSheet; Default leads, then dimmer to brighter
         (SdrBrightness.Choices). Each Tag is the option's SDR white in nits. -->
    <Grid x:Name="SdrBrightnessPicker" Visibility="Collapsed" Background="{StaticResource SkylineSettingsPickerScrim}">
      <Border Style="{StaticResource SkylineSettingsPickerCardStyle}">
        <StackPanel>
          <Grid Style="{StaticResource SkylineSettingsPickerHeaderStyle}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Style="{StaticResource SkylineSettingsPickerTitleStyle}">
              <TextBlock Text="SDR Brightness" Style="{StaticResource SkylineSettingsPaneTitleStyle}" />
              <TextBlock Text="Choose an option" Style="{StaticResource SkylineSettingsPickerHintTextStyle}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource SkylineSettingsPickerHintStyle}">
              <StackPanel Style="{StaticResource SkylineSettingsPickerHintContentStyle}">
                <Viewbox Style="{StaticResource SkylineSettingsPickerHintIconStyle}"><Path Style="{StaticResource SkylineSettingsGlyphStyle}" Opacity="{StaticResource SkylineSettingsHintOpacity}" Data="M12.5,8 C9.85,8 7.45,8.99 5.6,10.6 L2,7 V16 H11 L7.38,12.38 C8.77,11.22 10.54,10.5 12.5,10.5 C16.04,10.5 19.05,12.81 20.1,16 L22.47,15.22 C21.08,11.03 17.15,8 12.5,8 Z" /></Viewbox>
                <TextBlock Text="Back to close" Style="{StaticResource SkylineSettingsPickerHintTextStyle}" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource SkylineSettingsPickerDividerStyle}" />
          <StackPanel Style="{StaticResource SkylineSettingsPickerOptionsStyle}">
            <Button x:Name="SdrBrightnessDefaultOption" Tag="100" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnSdrBrightnessOptionClick">
              <TextBlock x:Name="SdrBrightnessDefaultOptionText" Style="{StaticResource SkylineSettingsRowTextStyle}" />
            </Button>
            <Button x:Name="SdrBrightness80Option" Tag="80" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnSdrBrightnessOptionClick">
              <TextBlock x:Name="SdrBrightness80OptionText" Style="{StaticResource SkylineSettingsRowTextStyle}" />
            </Button>
            <Button x:Name="SdrBrightness120Option" Tag="120" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnSdrBrightnessOptionClick">
              <TextBlock x:Name="SdrBrightness120OptionText" Style="{StaticResource SkylineSettingsRowTextStyle}" />
            </Button>
            <Button x:Name="SdrBrightness150Option" Tag="150" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnSdrBrightnessOptionClick">
              <TextBlock x:Name="SdrBrightness150OptionText" Style="{StaticResource SkylineSettingsRowTextStyle}" />
            </Button>
            <Button x:Name="SdrBrightness200Option" Tag="200" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnSdrBrightnessOptionClick">
              <TextBlock x:Name="SdrBrightness200OptionText" Style="{StaticResource SkylineSettingsRowTextStyle}" />
            </Button>
            <Button x:Name="SdrBrightness250Option" Tag="250" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnSdrBrightnessOptionClick">
              <TextBlock x:Name="SdrBrightness250OptionText" Style="{StaticResource SkylineSettingsRowTextStyle}" />
            </Button>
            <Button x:Name="SdrBrightness300Option" Tag="300" Style="{StaticResource SkylineSettingsPickerOptionStyle}" Click="OnSdrBrightnessOptionClick">
              <TextBlock x:Name="SdrBrightness300OptionText" Style="{StaticResource SkylineSettingsRowTextStyle}" />
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <controls:SignOutDialog x:Name="SignOutPrompt" />
  </Grid>
</Page>
