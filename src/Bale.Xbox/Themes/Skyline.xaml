    <Setter Property="FontSize" Value="13.76" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="#9EEDEDED" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="16,0" />
