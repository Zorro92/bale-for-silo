<Page
    x:Class="Bale.Xbox.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Bale.Xbox.Controls"
    Background="Black"
    NavigationCacheMode="Disabled"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

  <Grid Background="Black">
    <!-- Recreated on mount; teardown removes the native video presenter as well as its player. -->
    <Border x:Name="VideoHost" />
    <!-- Bale draws subtitles itself (Services/SubtitleOverlay.cs): above the video, below every player panel.
         Empty and deviceless until a track loads. -->
    <SwapChainPanel x:Name="SubtitleLayer" IsHitTestVisible="False" />
    <!-- TvSkipSeekIndicator.kt / TvPlayerScrubber.kt: passive feedback, never a focus surface.
         Keep the resting scrubber's geometry, reserving the official transport row below for later. -->
    <Grid x:Name="TransportFeedback" Visibility="Collapsed" IsHitTestVisible="False">
      <Border Style="{StaticResource SkylinePlayerTransportScrimStyle}" />
      <Grid Style="{StaticResource SkylinePlayerTransportStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource SkylinePlayerSkipChipStyle}">
          <Grid ColumnSpacing="{StaticResource SkylinePlayerSkipChipGap}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SkipDelta" Style="{StaticResource SkylinePlayerSkipDeltaStyle}" />
            <TextBlock x:Name="SkipLanding" Grid.Column="1" Style="{StaticResource SkylinePlayerSkipLandingStyle}" />
          </Grid>
        </Border>
        <Grid Grid.Row="1" Style="{StaticResource SkylinePlayerTrackHostStyle}">
          <Grid x:Name="TransportTrack" Style="{StaticResource SkylinePlayerTrackStyle}" SizeChanged="OnTransportSizeChanged">
            <Border Style="{StaticResource SkylinePlayerTrackRailStyle}" />
            <Border x:Name="TransportPlayed" Style="{StaticResource SkylinePlayerTrackPlayedStyle}" Width="0" />
          </Grid>
        </Grid>
        <Grid Grid.Row="2" Style="{StaticResource SkylinePlayerClockRowStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TransportElapsed" Style="{StaticResource SkylinePlayerTimeStyle}" Typography.NumeralAlignment="Tabular" />
          <TextBlock x:Name="TransportRemaining" Grid.Column="1" Style="{StaticResource SkylinePlayerRemainingStyle}" Typography.NumeralAlignment="Tabular" />
        </Grid>
      </Grid>
    </Grid>
    <!-- On-screen controls (TvPlayerScreen.kt TvPlayerIdleOverlay, TvPlayerScrubber.kt, TvPlayerTransportCluster.kt).
         Shown by the D-pad or by A pausing, hidden after 5 s without input (PlaybackControlsState). -->
    <Grid x:Name="TransportControls" Visibility="Collapsed" PreviewKeyDown="OnControlsKeyDown">
      <Border Style="{StaticResource SkylinePlayerTransportScrimStyle}" IsHitTestVisible="False" />
      <StackPanel Style="{StaticResource SkylinePlayerControlsStyle}">
        <TextBlock x:Name="ControlsEyebrow" Style="{StaticResource SkylinePlayerEyebrowStyle}" />
        <TextBlock x:Name="ControlsTitle" Style="{StaticResource SkylinePlayerTitleStyle}" />
        <Button x:Name="ScrubberButton" Style="{StaticResource SkylinePlayerScrubberStyle}" AutomationProperties.Name="Timeline"
                Click="OnScrubberClick" GotFocus="OnScrubberFocus" LostFocus="OnScrubberFocus">
          <Grid Height="28">
            <Grid x:Name="ScrubberTrack" Height="4" VerticalAlignment="Center" SizeChanged="OnScrubberSizeChanged">
              <Border CornerRadius="3.5" Background="#38FFFFFF" />
              <Border x:Name="ScrubberPlayed" CornerRadius="3.5" Background="#FFEDEDED" HorizontalAlignment="Left" Width="0" />
              <!-- TvPlayerScrubber.kt: chapter starts are 2 px gaps in the bar. -->
              <Canvas x:Name="ScrubberChapters" IsHitTestVisible="False" />
            </Grid>
            <!-- Outside the 4 px track so it is not clipped to the track's height. -->
            <Ellipse x:Name="ScrubberPuck" Width="15" Height="15" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Center">
              <Ellipse.RenderTransform><TranslateTransform x:Name="ScrubberPuckShift" /></Ellipse.RenderTransform>
            </Ellipse>
          </Grid>
        </Button>
        <Grid Style="{StaticResource SkylinePlayerClockRowStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ControlsElapsed" Style="{StaticResource SkylinePlayerTimeStyle}" Typography.NumeralAlignment="Tabular" />
          <TextBlock x:Name="ControlsRemaining" Grid.Column="1" Style="{StaticResource SkylinePlayerRemainingStyle}" Typography.NumeralAlignment="Tabular" />
        </Grid>
        <Grid Style="{StaticResource SkylinePlayerTransportRowStyle}">
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
            <Button x:Name="SkipBackButton" Style="{StaticResource SkylinePlayerTransportButtonStyle}" AutomationProperties.Name="Skip back 10 seconds"
                    Click="OnSkipBackClick">
              <Grid Width="20" Height="20">
                <Viewbox><Path Width="24" Height="24" Fill="#FFEDEDED" Data="M12,5 V1 L7,6 L12,11 V7 C15.31,7 18,9.69 18,13 C18,16.31 15.31,19 12,19 C8.69,19 6,16.31 6,13 H4 C4,17.42 7.58,21 12,21 C16.42,21 20,17.42 20,13 C20,8.58 16.42,5 12,5 Z" /></Viewbox>
                <TextBlock Text="10" FontSize="6.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" />
              </Grid>
            </Button>
            <Button x:Name="PlayPauseButton" Style="{StaticResource SkylinePlayerTransportButtonStyle}" AutomationProperties.Name="Pause"
                    Click="OnPlayPauseClick">
              <Grid Width="22" Height="22">
                <Viewbox x:Name="PauseGlyph"><Path Width="24" Height="24" Fill="#FFEDEDED" Data="M6,19 H10 V5 H6 Z M14,5 V19 H18 V5 Z" /></Viewbox>
                <Viewbox x:Name="PlayGlyph" Visibility="Collapsed"><Path Width="24" Height="24" Fill="#FFEDEDED" Data="M8,5 V19 L19,12 Z" /></Viewbox>
              </Grid>
            </Button>
            <Button x:Name="SkipForwardButton" Style="{StaticResource SkylinePlayerTransportButtonStyle}" AutomationProperties.Name="Skip forward 30 seconds"
                    Click="OnSkipForwardClick">
              <Grid Width="20" Height="20">
                <Viewbox RenderTransformOrigin="0.5,0.5"><Viewbox.RenderTransform><ScaleTransform ScaleX="-1" /></Viewbox.RenderTransform>
                  <Path Width="24" Height="24" Fill="#FFEDEDED" Data="M12,5 V1 L7,6 L12,11 V7 C15.31,7 18,9.69 18,13 C18,16.31 15.31,19 12,19 C8.69,19 6,16.31 6,13 H4 C4,17.42 7.58,21 12,21 C16.42,21 20,17.42 20,13 C20,8.58 16.42,5 12,5 Z" /></Viewbox>
                <TextBlock Text="30" FontSize="6.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0" />
              </Grid>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <!-- TvPlayerTransportCluster.kt: secondary buttons widen into "Label · value" pills on focus. -->
            <!-- TvPlayerTransportCluster.kt onUpNext: only while a next episode exists and its card is not up. -->
            <Button x:Name="UpNextButton" Style="{StaticResource SkylinePlayerTransportButtonStyle}" AutomationProperties.Name="Up Next"
                    Click="OnUpNextButtonClick" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Style="{StaticResource SkylinePlayerGlyphStyle}"><Path Width="24" Height="24" Fill="#FFEDEDED"
                  Data="M6,18 L14.5,12 L6,6 Z M16,6 V18 H18 V6 Z" /></Viewbox>
                <TextBlock Text="Up next" VerticalAlignment="Center" Visibility="Collapsed" />
              </StackPanel>
            </Button>
            <Button x:Name="AudioButton" Style="{StaticResource SkylinePlayerTransportButtonStyle}" AutomationProperties.Name="Audio" Click="OnAudioClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Style="{StaticResource SkylinePlayerGlyphStyle}"><Path Width="24" Height="24" Fill="#FFEDEDED"
                  Data="M3,9 V15 H7 L12,20 V4 L7,9 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V16.02 C15.48,15.29 16.5,13.77 16.5,12 Z M14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 C19,15.17 16.89,17.85 14,18.71 V20.77 C18.01,19.86 21,16.28 21,12 C21,7.72 18.01,4.14 14,3.23 Z" /></Viewbox>
                <TextBlock Text="Audio" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="AudioValue" VerticalAlignment="Center" Opacity="0.58" FontWeight="Medium" Visibility="Collapsed" />
              </StackPanel>
            </Button>
            <Button x:Name="SubtitlesButton" Style="{StaticResource SkylinePlayerTransportButtonStyle}" AutomationProperties.Name="Subtitles" Click="OnSubtitlesClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Style="{StaticResource SkylinePlayerGlyphStyle}"><Path Width="24" Height="24" Fill="#FFEDEDED"
                  Data="M20,4 H4 C2.9,4 2,4.9 2,6 V18 C2,19.1 2.9,20 4,20 H20 C21.1,20 22,19.1 22,18 V6 C22,4.9 21.1,4 20,4 Z M4,12 H8 V14 H4 Z M14,18 H4 V16 H14 Z M20,18 H16 V16 H20 Z M20,14 H10 V12 H20 Z" /></Viewbox>
                <TextBlock Text="Subtitles" VerticalAlignment="Center" Visibility="Collapsed" />
                <TextBlock x:Name="SubtitlesValue" VerticalAlignment="Center" Opacity="0.58" FontWeight="Medium" Visibility="Collapsed" />
              </StackPanel>
            </Button>
            <Button x:Name="OptionsButton" Style="{StaticResource SkylinePlayerTransportButtonStyle}" AutomationProperties.Name="Options" Click="OnOptionsClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Style="{StaticResource SkylinePlayerGlyphStyle}"><Path Width="24" Height="24" Fill="#FFEDEDED"
                  Data="M3,17 V19 H9 V17 Z M3,5 V7 H13 V5 Z M13,21 V19 H21 V17 H13 V15 H11 V21 Z M7,9 V11 H3 V13 H7 V15 H9 V9 Z M21,13 V11 H11 V13 Z M15,9 H17 V7 H21 V5 H17 V3 H15 Z" /></Viewbox>
                <TextBlock Text="Options" VerticalAlignment="Center" Visibility="Collapsed" />
              </StackPanel>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource SkylinePlayerTransportButtonStyle}" AutomationProperties.Name="Close"
                    Click="OnCloseClick">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Viewbox Style="{StaticResource SkylinePlayerGlyphStyle}"><Path Width="24" Height="24" Fill="#FFEDEDED"
                  Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z" /></Viewbox>
                <TextBlock Text="Close" VerticalAlignment="Center" Visibility="Collapsed" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>
    <!-- TvPlayerNoticeOverlay.kt: top-start, passive informational pill; never takes focus.
         Keep it above the default-on development stats panel so the notice is still readable. -->
    <Border x:Name="VersionNotice" Style="{StaticResource SkylinePlayerNoticeStyle}"
            Visibility="Collapsed" IsHitTestVisible="False" Canvas.ZIndex="1">
      <Border.RenderTransform>
        <TranslateTransform x:Name="VersionNoticeSlide" />
      </Border.RenderTransform>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
          <Path Fill="White" Width="24" Height="24"
                Data="M11,17 L13,17 L13,11 L11,11 Z M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M12,20 C7.59,20 4,16.41 4,12 C4,7.59 7.59,4 12,4 C16.41,4 20,7.59 20,12 C20,16.41 16.41,20 12,20 Z M11,9 L13,9 L13,7 L11,7 Z" />
        </Viewbox>
        <TextBlock x:Name="VersionNoticeText" Grid.Column="1" Style="{StaticResource SkylinePlayerNoticeTextStyle}" />
      </Grid>
    </Border>
    <!-- Only DEBUG_SERVER code makes this visible. Read-only: it must never take player focus. -->
    <Border x:Name="StatsPanel" Style="{StaticResource SkylinePlayerStatsPanelStyle}"
            Visibility="Collapsed" IsHitTestVisible="False">
      <!-- Long values wrap; the right stick (keyboard U/N) scrolls when the pane is taller than the screen. -->
      <ScrollViewer x:Name="StatsScroller" IsTabStop="False" VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
      <Grid ColumnSpacing="{StaticResource SkylinePlayerStatsColumnGap}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="StatsLeftRows" />
        <StackPanel x:Name="StatsRightRows" Grid.Column="1" />
        <!-- Copy these XAML-assigned Styles, not resource dictionary entries: Native AOT safe. -->
        <Grid x:Name="StatsRowStyleSource" Style="{StaticResource SkylinePlayerStatsRowStyle}" Visibility="Collapsed">
          <TextBlock x:Name="StatsLabelStyleSource" Style="{StaticResource SkylinePlayerStatsLabelStyle}" />
          <TextBlock x:Name="StatsValueStyleSource" Style="{StaticResource SkylinePlayerStatsValueStyle}" />
        </Grid>
      </Grid>
      </ScrollViewer>
    </Border>
    <!-- TvPlayerScreen.kt TvPlayerLoadingSpinner: one plain, centered 64dp paper spinner. -->
    <ProgressRing x:Name="LoadingRing" Style="{StaticResource SkylinePlayerLoadingStyle}"
                  AutomationProperties.Name="Loading" Visibility="Collapsed" IsActive="False" />
    <!-- StatusViews.kt TvErrorScreen: keep the shared 24dp arrangement around its 8dp spacer. -->
    <Grid x:Name="ErrorPanel" Style="{StaticResource SkylineProfileErrorScreenStyle}" Visibility="Collapsed">
      <StackPanel Style="{StaticResource SkylineProfileErrorContentStyle}">
        <TextBlock x:Name="ErrorText" Style="{StaticResource SkylineProfileErrorMessageStyle}" />
        <Border Height="{StaticResource SkylineProfileErrorSpacer}" />
        <Button x:Name="RetryButton" Content="Retry" Click="OnRetryClick" Style="{StaticResource SkylineProfileRetryStyle}" />
      </StackPanel>
    </Grid>
    <!-- Options (TvPlayerHud.kt): a top-centre card over the picture, tabs that follow focus. Info shows what is
         playing and how; Stats the playback readout; Video holds the automation rows (auto-play); Audio and Subtitles list the
         tracks and switch them; Chapters lists the file's chapters and seeks. Back closes it. -->
    <Border x:Name="OptionsPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0"
            Width="736" Padding="20,16" CornerRadius="16" Background="#F4131417" BorderBrush="#1AFFFFFF" BorderThickness="1"
            PreviewKeyDown="OnOptionsKeyDown">
      <StackPanel Spacing="14">
        <StackPanel x:Name="OptionsTabs" Orientation="Horizontal" Spacing="8">
          <ToggleButton x:Name="InfoTab" Content="Info" Style="{StaticResource SkylineChipStyle}" GotFocus="OnOptionsTabFocus" Click="OnOptionsTabFocus" />
          <ToggleButton x:Name="StatsTab" Content="Stats" Style="{StaticResource SkylineChipStyle}" GotFocus="OnOptionsTabFocus" Click="OnOptionsTabFocus" />
          <ToggleButton x:Name="VideoTab" Content="Video" Style="{StaticResource SkylineChipStyle}" GotFocus="OnOptionsTabFocus" Click="OnOptionsTabFocus" />
          <ToggleButton x:Name="AudioTab" Content="Audio" Style="{StaticResource SkylineChipStyle}" GotFocus="OnOptionsTabFocus" Click="OnOptionsTabFocus" />
          <ToggleButton x:Name="SubtitlesTab" Content="Subtitles" Style="{StaticResource SkylineChipStyle}" GotFocus="OnOptionsTabFocus" Click="OnOptionsTabFocus" />
          <ToggleButton x:Name="ChaptersTab" Content="Chapters" Style="{StaticResource SkylineChipStyle}" GotFocus="OnOptionsTabFocus" Click="OnOptionsTabFocus" />
        </StackPanel>
        <Grid x:Name="InfoPane" ColumnSpacing="26">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Spacing="4">
            <TextBlock Text="TITLE" Style="{StaticResource SkylinePlayerEyebrowStyle}" />
            <TextBlock x:Name="OptionsEpisode" Style="{StaticResource SkylinePlayerEyebrowStyle}" />
            <TextBlock x:Name="OptionsTitle" FontFamily="{StaticResource SkylineFont}" FontSize="17.2" FontWeight="Bold" Foreground="#FFEDEDED"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="OptionsDuration" Style="{StaticResource SkylinePlayerTimeStyle}" Typography.NumeralAlignment="Tabular" />
            <StackPanel x:Name="OptionsBadges" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="STREAM" Style="{StaticResource SkylinePlayerEyebrowStyle}" />
            <StackPanel x:Name="OptionsStreamRows" Spacing="6" />
          </StackPanel>
        </Grid>
        <!-- TvPlayerHud.kt HudStatsPane: read-only label/value rows, filled top-to-bottom then across. -->
        <Grid x:Name="StatsPane" Visibility="Collapsed" ColumnSpacing="{StaticResource SkylinePlayerStatsColumnGap}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="StatsPaneLeftRows" />
          <StackPanel x:Name="StatsPaneRightRows" Grid.Column="1" />
        </Grid>
        <StackPanel x:Name="VideoPane" Visibility="Collapsed" Spacing="6">
          <TextBlock Text="AUTOMATION" Style="{StaticResource SkylinePlayerEyebrowStyle}" />
          <Button x:Name="AutoPlayRow" Style="{StaticResource SkylinePanelRowStyle}" Click="OnAutoPlayRowClick" AutomationProperties.Name="Auto-play next">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Auto-play next" VerticalAlignment="Center" />
              <TextBlock x:Name="AutoPlayRowValue" Grid.Column="1" Opacity="0.6" VerticalAlignment="Center" />
            </Grid>
          </Button>
        </StackPanel>
        <!-- TVPlayerInfoHUD.swift AudioPane / SubtitlesPane: every track as a row, the playing one checked; Select switches. -->
        <StackPanel x:Name="AudioPane" Visibility="Collapsed" Spacing="6">
          <TextBlock x:Name="AudioTracksHeader" Text="TRACKS" Style="{StaticResource SkylinePlayerEyebrowStyle}" />
          <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Hidden" IsTabStop="False">
            <StackPanel x:Name="AudioRows" Spacing="2" />
          </ScrollViewer>
        </StackPanel>
        <StackPanel x:Name="SubtitlesPane" Visibility="Collapsed" Spacing="6">
          <TextBlock x:Name="SubtitleTracksHeader" Text="TRACKS" Style="{StaticResource SkylinePlayerEyebrowStyle}" />
          <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Hidden" IsTabStop="False">
            <StackPanel x:Name="SubtitleRows" Spacing="2" />
          </ScrollViewer>
        </StackPanel>
        <ScrollViewer x:Name="ChaptersPane" Visibility="Collapsed" MaxHeight="250" VerticalScrollBarVisibility="Hidden" IsTabStop="False">
          <StackPanel x:Name="ChapterRows" Spacing="2" />
        </ScrollViewer>
      </StackPanel>
    </Border>
    <!-- Up Next (TvPlayerViewModel.kt showNextUp): raised at the credits or at the end, Play Now focused. -->
    <Border x:Name="UpNextCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,26"
            Width="340" Padding="14" CornerRadius="14" Background="#F3131417" BorderBrush="#1AFFFFFF" BorderThickness="1">
      <StackPanel Spacing="10">
        <TextBlock Text="UP NEXT" Style="{StaticResource SkylinePlayerEyebrowStyle}" />
        <Border CornerRadius="8" Height="176" Background="#14FFFFFF">
          <Image x:Name="UpNextStill" Stretch="UniformToFill" />
        </Border>
        <TextBlock x:Name="UpNextTitle" FontFamily="{StaticResource SkylineFont}" FontSize="14.2" FontWeight="SemiBold"
                   Foreground="#FFEDEDED" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="UpNextCountdown" FontFamily="{StaticResource SkylineFont}" FontSize="12.04" Foreground="#99EDEDED" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Button x:Name="UpNextPlayButton" Content="Play Now" Style="{StaticResource SkylineButtonStyle}" Click="OnUpNextPlayClick" />
          <Button x:Name="UpNextHideButton" Content="Hide" Style="{StaticResource SkylineButtonStyle}" Click="OnUpNextHideClick" />
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- Audio / Subtitles track lists, the Detail page's anchored menu (TvAnchoredSelectorMenu.kt). -->
    <controls:PlaybackSelectorMenu x:Name="TrackMenu" IsHitTestVisible="False"
                                   AnchorGap="{StaticResource SkylinePlaybackSelectorGap}" WindowInset="{StaticResource SkylinePlaybackSelectorWindowInset}" />
  </Grid>
</Page>
