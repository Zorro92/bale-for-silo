<UserControl
    x:Class="Bale.Xbox.Controls.CardActionMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource SkylineFont}" IsTabStop="False" IsHitTestVisible="False">
  <Grid>
    <!-- TvMediaCardActions.kt uses a focusable Popup, without a window scrim or enter/exit animation. -->
    <Grid x:Name="ModalLayer" Visibility="Collapsed" Background="Transparent" TabFocusNavigation="Cycle" Tapped="OnBackgroundTapped">
      <Border x:Name="MenuPanel" Style="{StaticResource SkylineCardMenuPanelStyle}" AutomationProperties.Name="Card actions">
        <Grid>
          <StackPanel x:Name="Options" Style="{StaticResource SkylineCardMenuOptionsStyle}">
            <Button x:Name="PlayItem" Style="{StaticResource SkylineCardMenuRowStyle}" Click="OnPlayClick" GotFocus="OnRowFocus" LostFocus="OnRowBlur">
              <Grid Style="{StaticResource SkylineCardMenuContentStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Viewbox Style="{StaticResource SkylineCardMenuIconStyle}">
                  <Path Width="24" Height="24" Fill="#FFFFFFFF" Data="M8,5 L8,19 L19,12 Z" />
                </Viewbox>
                <TextBlock x:Name="PlayLabel" Grid.Column="1" Style="{StaticResource SkylineCardMenuLabelStyle}" />
              </Grid>
            </Button>
            <Button x:Name="WatchedItem" Style="{StaticResource SkylineCardMenuRowStyle}" Click="OnWatchedClick" GotFocus="OnRowFocus" LostFocus="OnRowBlur">
              <Grid Style="{StaticResource SkylineCardMenuContentStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Viewbox Style="{StaticResource SkylineCardMenuIconStyle}">
                  <Grid Width="24" Height="24">
                    <Path x:Name="CheckIcon" Fill="#FFFFFFFF" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z" />
                    <Path x:Name="UnwatchedIcon" Fill="#FFFFFFFF" Visibility="Collapsed"
                          Data="M12,7 C14.76,7 17,9.24 17,12 C17,12.65 16.87,13.26 16.64,13.83 L19.56,16.75 C21.07,15.49 22.26,13.86 22.99,12 C21.26,7.61 16.99,4.5 11.99,4.5 C10.59,4.5 9.25,4.75 8.01,5.2 L10.17,7.36 C10.74,7.13 11.35,7 12,7 Z M2,4.27 L4.28,6.55 L4.74,7.01 C3.08,8.3 1.78,10.02 1,12 C2.73,16.39 7,19.5 12,19.5 C13.55,19.5 15.03,19.2 16.38,18.66 L16.8,19.08 L19.73,22 L21,20.73 L3.27,3 Z M7.53,9.8 L9.08,11.35 C9.03,11.56 9,11.78 9,12 C9,13.66 10.34,15 12,15 C12.22,15 12.44,14.97 12.65,14.92 L14.2,16.47 C13.53,16.8 12.79,17 12,17 C9.24,17 7,14.76 7,12 C7,11.21 7.2,10.47 7.53,9.8 Z M11.84,9.02 L14.99,12.17 L15.01,12.01 C15.01,10.35 13.67,9.01 12.01,9.01 Z" />
                  </Grid>
                </Viewbox>
                <TextBlock x:Name="WatchedLabel" Grid.Column="1" Style="{StaticResource SkylineCardMenuLabelStyle}" />
              </Grid>
            </Button>
            <Button x:Name="FavoriteItem" Style="{StaticResource SkylineCardMenuRowStyle}" Click="OnFavoriteClick" GotFocus="OnRowFocus" LostFocus="OnRowBlur">
              <Grid Style="{StaticResource SkylineCardMenuContentStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Viewbox Style="{StaticResource SkylineCardMenuIconStyle}">
                  <Grid Width="24" Height="24">
                    <Path x:Name="FavoriteIcon" Fill="#FFFFFFFF" Visibility="Collapsed"
                          Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 Z" />
                    <Path x:Name="FavoriteBorderIcon" Fill="#FFFFFFFF"
                          Data="M16.5,3 C14.76,3 13.09,3.81 12,5.09 C10.91,3.81 9.24,3 7.5,3 C4.42,3 2,5.42 2,8.5 C2,12.28 5.4,15.36 10.55,20.04 L12,21.35 L13.45,20.03 C18.6,15.36 22,12.28 22,8.5 C22,5.42 19.58,3 16.5,3 Z M12.1,18.55 L12,18.65 L11.9,18.55 C7.14,14.24 4,11.39 4,8.5 C4,6.5 5.5,5 7.5,5 C9.04,5 10.54,5.99 11.07,7.36 L12.94,7.36 C13.46,5.99 14.96,5 16.5,5 C18.5,5 20,6.5 20,8.5 C20,11.39 16.86,14.24 12.1,18.55 Z" />
                  </Grid>
                </Viewbox>
                <TextBlock x:Name="FavoriteLabel" Grid.Column="1" Style="{StaticResource SkylineCardMenuLabelStyle}" />
              </Grid>
            </Button>
            <Button x:Name="WatchlistItem" Style="{StaticResource SkylineCardMenuRowStyle}" Click="OnWatchlistClick" GotFocus="OnRowFocus" LostFocus="OnRowBlur">
              <Grid Style="{StaticResource SkylineCardMenuContentStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Viewbox Style="{StaticResource SkylineCardMenuIconStyle}">
                  <Grid Width="24" Height="24">
                    <!-- Icons.Default.BookmarkAdd/BookmarkRemove are filled, with the sign at the top-right. -->
                    <Path x:Name="BookmarkAddIcon" Fill="#FFFFFFFF"
                          Data="M21,7 L19,7 L19,9 L17,9 L17,7 L15,7 L15,5 L17,5 L17,3 L19,3 L19,5 L21,5 Z M19,21 L12,18 L5,21 L5,5 C5,3.9 5.9,3 7,3 L14,3 C13.37,3.84 13,4.87 13,6 C13,8.76 15.24,11 18,11 C18.34,11 18.68,10.97 19,10.9 Z" />
                    <Path x:Name="BookmarkRemoveIcon" Fill="#FFFFFFFF" Visibility="Collapsed"
                          Data="M21,7 L15,7 L15,5 L21,5 Z M19,10.9 C18.68,10.97 18.34,11 18,11 C15.24,11 13,8.76 13,6 C13,4.87 13.37,3.84 14,3 L7,3 C5.9,3 5,3.9 5,5 L5,21 L12,18 L19,21 Z" />
                  </Grid>
                </Viewbox>
                <TextBlock x:Name="WatchlistLabel" Grid.Column="1" Style="{StaticResource SkylineCardMenuLabelStyle}" />
              </Grid>
            </Button>
            <Button x:Name="RemoveItem" Style="{StaticResource SkylineCardMenuRowStyle}" Click="OnRemoveClick" GotFocus="OnRowFocus" LostFocus="OnRowBlur">
              <Grid Style="{StaticResource SkylineCardMenuContentStyle}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Viewbox Style="{StaticResource SkylineCardMenuIconStyle}">
                  <Path Width="24" Height="24" Fill="#FFFFFFFF"
                        Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z" />
                </Viewbox>
                <TextBlock x:Name="RemoveLabel" Grid.Column="1" Style="{StaticResource SkylineCardMenuLabelStyle}" />
              </Grid>
            </Button>
          </StackPanel>
          <Border Style="{StaticResource SkylineCardMenuOutlineStyle}" />
        </Grid>
      </Border>
    </Grid>
    <!-- A failed optimistic write is announced without stealing the card's restored focus. -->
    <Border x:Name="StatusPanel" Style="{StaticResource SkylineDetailDialogPanelStyle}" Visibility="Collapsed" IsHitTestVisible="False"
            VerticalAlignment="Bottom" Margin="24" Padding="16,10" MaxWidth="560" AutomationProperties.LiveSetting="Assertive">
      <TextBlock x:Name="StatusText" FontSize="12" Foreground="#FFEDEDED" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
