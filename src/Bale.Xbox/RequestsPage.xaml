<Page
    x:Class="Bale.Xbox.RequestsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    xmlns:controls="using:Bale.Xbox.Controls"
    Background="{StaticResource SkylineBackground}">
  <Page.Resources>
    <DataTemplate x:Key="CardTemplate" x:DataType="views:RequestCardView"><controls:RequestPoster /></DataTemplate>
    <DataTemplate x:Key="RowTemplate" x:DataType="views:RequestRowView">
      <StackPanel Style="{StaticResource SkylineBrowseRowStyle}">
        <Grid Style="{StaticResource SkylineBrowseHeaderStyle}">
          <StackPanel>
            <TextBlock Text="{x:Bind Eyebrow, Mode=OneWay}" Visibility="{x:Bind EyebrowVisibility, Mode=OneWay}" Style="{StaticResource SkylineRequestEyebrowStyle}" />
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SkylineBrowseHeaderTitleStyle}" />
          </StackPanel>
        </Grid>
        <ListView ItemsSource="{x:Bind Cards}" ItemTemplate="{StaticResource CardTemplate}" Style="{StaticResource SkylineRequestRailStyle}"
                  Loaded="OnRailLoaded" ItemClick="OnCardClick" GotFocus="OnCardFocus" LostFocus="OnCardBlur" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>
  <Grid>
    <Rectangle x:Name="Wash" IsHitTestVisible="False" />
    <Grid x:Name="ArtBox" Style="{StaticResource SkylineRequestArtBoxStyle}" />
    <Grid x:Name="MarqueeRegion" Style="{StaticResource SkylineRequestMarqueeRegionStyle}" Visibility="Collapsed">
      <StackPanel Style="{StaticResource SkylineRequestMarqueeStyle}">
        <TextBlock x:Name="MarqueeTitle" Style="{StaticResource SkylineRequestMarqueeTitleStyle}" />
        <TextBlock x:Name="MarqueeFacts" Style="{StaticResource SkylineRequestFactsStyle}" />
        <TextBlock x:Name="MarqueeOverview" Style="{StaticResource SkylineRequestOverviewStyle}" />
        <controls:RequestStatusView x:Name="PreviewStatus" HorizontalAlignment="Left" />
        <controls:RequestStatusView x:Name="PreviewTrack" Width="{StaticResource SkylineRequestPreviewTrackWidth}" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
    <ScrollViewer x:Name="RowsScroller" Style="{StaticResource SkylineRequestRowsScrollerStyle}" Visibility="Collapsed">
      <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource RowTemplate}" Style="{StaticResource SkylineRequestRowsStyle}" />
    </ScrollViewer>
    <!-- TvRequestsLoadingView: skeleton uses the same preview and lower-band geometry as content. -->
    <Button x:Name="StateOwner" Style="{StaticResource SkylineRequestPlaceholderStyle}" AutomationProperties.Name="Loading requests">
      <Grid>
        <Grid x:Name="LoadingPanel">
          <Grid Style="{StaticResource SkylineRequestMarqueeRegionStyle}">
            <StackPanel Style="{StaticResource SkylineRequestPreviewSkeletonStyle}">
              <Border Style="{StaticResource SkylineRequestSkeletonTitleStyle}" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Border Width="59" Height="11" Style="{StaticResource SkylineRequestSkeletonStyle}" />
                <Border Width="41" Height="11" Style="{StaticResource SkylineRequestSkeletonStyle}" />
                <Border Width="75" Height="11" Style="{StaticResource SkylineRequestSkeletonStyle}" />
              </StackPanel>
              <Border Width="360" Height="9" Style="{StaticResource SkylineRequestSkeletonStyle}" />
              <Border Width="305" Height="9" Style="{StaticResource SkylineRequestSkeletonStyle}" />
              <TextBlock Text="Loading Requests" Style="{StaticResource SkylineRequestSecondaryStyle}" />
            </StackPanel>
          </Grid>
          <StackPanel Style="{StaticResource SkylineRequestSkeletonRowStyle}">
            <Border Style="{StaticResource SkylineRequestSkeletonHeaderStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SkylineRequestItemSpacing}">
              <Border Style="{StaticResource SkylineRequestSkeletonPosterStyle}" /><Border Style="{StaticResource SkylineRequestSkeletonPosterStyle}" />
              <Border Style="{StaticResource SkylineRequestSkeletonPosterStyle}" /><Border Style="{StaticResource SkylineRequestSkeletonPosterStyle}" />
              <Border Style="{StaticResource SkylineRequestSkeletonPosterStyle}" /><Border Style="{StaticResource SkylineRequestSkeletonPosterStyle}" />
              <Border Style="{StaticResource SkylineRequestSkeletonPosterStyle}" /><Border Style="{StaticResource SkylineRequestSkeletonPosterStyle}" />
            </StackPanel>
          </StackPanel>
        </Grid>
        <StackPanel x:Name="EmptyPanel" Style="{StaticResource SkylineRequestEmptyStyle}" Visibility="Collapsed">
          <Viewbox Style="{StaticResource SkylineRequestEmptyIconStyle}"><Path Style="{StaticResource SkylineRequestEmptyGlyphStyle}" Data="M19,3 H4.99 C3.88,3 3.01,3.9 3.01,5 L3,19 C3,20.1 3.88,21 4.99,21 H19 C20.1,21 21,20.1 21,19 V5 C21,3.9 20.1,3 19,3 Z M19,15 H15 C15,16.66 13.65,18 12,18 C10.35,18 9,16.66 9,15 H5 V5 H19 Z" /></Viewbox>
          <TextBlock Text="Nothing here yet" Style="{StaticResource SkylineRequestEmptyTitleStyle}" />
          <TextBlock Text="Use Search to find a movie or series to request" Style="{StaticResource SkylineRequestEmptyCopyStyle}" />
        </StackPanel>
      </Grid>
    </Button>
    <StackPanel x:Name="ErrorPanel" Style="{StaticResource SkylineHomeErrorStyle}" Visibility="Collapsed">
      <TextBlock x:Name="ErrorText" Style="{StaticResource SkylineHomeStateTitleStyle}" />
      <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource SkylineHomeErrorActionStyle}" Click="OnRetryClick" />
    </StackPanel>
    <Border x:Name="Toast" Style="{StaticResource SkylineRequestToastStyle}" Visibility="Collapsed" IsHitTestVisible="False">
      <TextBlock x:Name="ToastText" Style="{StaticResource SkylineRequestNoticeStyle}" />
    </Border>
    <controls:RequestDialog x:Name="ActionDialog" />
  </Grid>
</Page>
