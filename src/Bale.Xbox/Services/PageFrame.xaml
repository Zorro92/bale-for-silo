<Frame
    x:Class="Bale.Xbox.Services.PageFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Frame.Template>
    <ControlTemplate TargetType="Frame">
      <Grid Background="{TemplateBinding Background}">
        <!-- PageFrame replaces FirstPresenter's TemplateBinding with explicit content so the outgoing
             page stays loaded until its fade ends; the binding is only the no-fade fallback. -->
        <ContentPresenter x:Name="FirstPresenter" Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        <ContentPresenter x:Name="SecondPresenter" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Grid>
    </ControlTemplate>
  </Frame.Template>
</Frame>
