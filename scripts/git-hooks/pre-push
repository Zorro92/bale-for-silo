#!/usr/bin/env bash
# Bale pre-push check: what Linux can verify before CI. Lints every Rust crate exactly as CI does
# (cargo fmt --check, cargo clippy --all-targets -D warnings, which also lints test code; bale-gpu a
# second time for the Windows target when that target is installed), rebuilds the Rust core the tests load
# (a stale libbale_core.so makes tests run old logic), then builds and runs the .NET tests with
# warnings as errors (Directory.Build.props). The Xbox package itself needs Windows, so CI stays
# the only check for XAML; scripts/check-cswinrt.sh runs when C# inputs changed and catches CsWinRT errors. Skip once with `git push --no-verify`.
# Enable with: scripts/install-git-hooks.sh
set -euo pipefail
root=$(git rev-parse --show-toplevel)
cd "$root"
export PATH="$HOME/.cargo/bin:$PATH"

# Pushing only deletions or tags: nothing to check.
needed=0 cswinrt=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  needed=1
  # CsWinRT pre-check only when the pushed commits touch C# app inputs (or the remote ref is new).
  if [[ "$remote_sha" =~ ^0+$ ]] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null ||
     git diff --name-only "$remote_sha" "$local_sha" | grep -qE '^(src/|Directory\.Build\.|NuGet\.Config|global\.json|scripts/check-cswinrt\.sh)'; then
    cswinrt=1
  fi
done
[[ $needed -eq 1 ]] || exit 0

# Same Rust lint as CI (.github/workflows/ci.yml), for every crate under native/.
for crate in native/*/; do
  [[ -f "$crate/Cargo.toml" ]] || continue
  echo "pre-push: linting ${crate%/} (fmt, clippy --all-targets)..." >&2
  if ! (cd "$crate" && cargo fmt --check && cargo clippy --all-targets --locked -q -- -D warnings); then
    echo "pre-push: Rust lint failed in ${crate%/}; push stopped (git push --no-verify to override)." >&2
    exit 1
  fi
done
if rustup target list --installed 2>/dev/null | grep -qx x86_64-pc-windows-msvc; then
  echo "pre-push: linting native/bale-gpu for x86_64-pc-windows-msvc..." >&2
  if ! (cd native/bale-gpu && cargo clippy --all-targets --locked -q --target x86_64-pc-windows-msvc -- -D warnings); then
    echo "pre-push: Windows-target Rust lint failed in native/bale-gpu; push stopped." >&2
    exit 1
  fi
else
  echo "pre-push: x86_64-pc-windows-msvc target not installed; Windows-target lint left to CI." >&2
fi

echo "pre-push: building Rust core..." >&2
(cd native/bale-core && cargo build --release --locked -q)

echo "pre-push: running .NET tests..." >&2
log=$(mktemp)
trap 'rm -f "$log"' EXIT
if ! dotnet test tests/Bale.Core.Tests --nologo >"$log" 2>&1; then
  grep -E "error|Failed |Failed!|warning" "$log" | grep -vE "https?://|token|api_key" | head -40 >&2
  echo "pre-push: tests or build failed; push stopped (git push --no-verify to override)." >&2
  exit 1
fi
grep -E "Passed!" "$log" >&2 || true

# CsWinRT analyzer errors (e.g. CsWinRT1028) fail CI's Windows MSIX build; scripts/check-cswinrt.sh sees them
# on Linux. Exit 1 = errors (stop), 2 = setup problem such as no network/gh (warn, leave it to CI).
if [[ $cswinrt -eq 1 ]]; then
  echo "pre-push: CsWinRT pre-check (scripts/check-cswinrt.sh)..." >&2
  set +e; scripts/check-cswinrt.sh >&2; rc=$?; set -e
  if [[ $rc -eq 1 ]]; then
    echo "pre-push: CsWinRT errors would fail CI's Xbox build; push stopped (git push --no-verify to override)." >&2
    exit 1
  elif [[ $rc -ne 0 ]]; then
    echo "pre-push: CsWinRT pre-check could not run (exit $rc); left to CI." >&2
  fi
fi
