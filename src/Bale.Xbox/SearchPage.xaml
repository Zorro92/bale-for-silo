<Page
    x:Class="Bale.Xbox.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    Background="{StaticResource SkylineBackground}">

  <Page.Resources>
    <!-- Same card overlay badges as Home (CardOverlays, Classic preset). -->
    <DataTemplate x:Key="BadgeTemplate" x:DataType="views:BadgeView">
      <Border Background="#99000000" BorderBrush="#26FFFFFF" BorderThickness="{x:Bind Border}" CornerRadius="{x:Bind Radius}"
              Padding="{x:Bind Padding}" HorizontalAlignment="Left" Margin="0,0,0,1">
        <TextBlock Text="{x:Bind Text}" FontSize="{x:Bind FontSize}" FontWeight="SemiBold" CharacterSpacing="55" Foreground="#FFFFFFFF" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="FilterTemplate" x:DataType="views:SearchFilterView">
      <ToggleButton Content="{x:Bind Label}" IsChecked="{x:Bind Selected, Mode=OneWay}" Margin="0,0,12,0"
                    Style="{StaticResource SkylineFilterChipStyle}" Click="OnFilterClick" />
    </DataTemplate>
    <!-- TvSearchPeopleRow.kt reuses TvCastCard: circular 100px portraits, 22px gaps. -->
    <DataTemplate x:Key="PersonTemplate" x:DataType="views:SearchPersonView">
      <StackPanel Width="100">
        <Grid x:Name="Art" Width="100" Height="100">
          <Ellipse Fill="{StaticResource SkylineSurfaceElevated}" />
          <FontIcon Glyph="&#xE77B;" FontSize="40" Foreground="#99FFFFFF" Visibility="{x:Bind PlaceholderVisibility}" />
          <Ellipse>
            <Ellipse.Fill>
              <ImageBrush ImageSource="{x:Bind Photo}" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse x:Name="FocusGlow" Margin="-6" Stroke="{StaticResource SkylineFocusGlow}" StrokeThickness="3" Opacity="0" IsHitTestVisible="False" />
          <Ellipse x:Name="FocusRing" Margin="-3" Stroke="{StaticResource SkylineFocusRing}" StrokeThickness="2" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <TextBlock x:Name="PersonName" Text="{x:Bind Name}" Margin="0,8,0,0" Style="{StaticResource SkylineSearchPersonNameStyle}" />
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <!--
    TvSearchScreen.kt: field, library-derived chips, people, status, then the title grid.
    The field, chips, people and count scroll as one under the top bar, like TvSearchScreen.
    The grid spans the page so a focused poster's lift and ring are never clipped.
  -->
  <Grid>
    <GridView x:Name="Results" Padding="40,2,8,40" SelectionMode="None" IsItemClickEnabled="True" ScrollViewer.VerticalScrollBarVisibility="Hidden"
              ItemClick="OnResultClick" GotFocus="OnResultFocus" LostFocus="OnResultBlur">
      <GridView.Header>
        <StackPanel Margin="0,90,0,0">
          <!-- Focus alone never raises the on-screen keyboard; A/Select on the field does (TvSearchScreen: the field is read-only until Select). The page focuses this box from code on open and on Up from the chips. -->
          <TextBox x:Name="QueryBox" HorizontalAlignment="Left" PlaceholderText="Search movies and series"
                   Style="{StaticResource SkylineSearchTextBoxStyle}" TextChanged="OnQueryChanged" InputScope="Search" PreventKeyboardDisplayOnProgrammaticFocus="True" />

          <!-- rail-layout: non-card — Search filter pills. -->
          <ItemsControl x:Name="Filters" Margin="0,8,0,0" ItemTemplate="{StaticResource FilterTemplate}" XYFocusKeyboardNavigation="Enabled">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <StackPanel x:Name="PeopleSection" Margin="-40,12,-8,0" Visibility="Collapsed" Spacing="4">
            <TextBlock Text="People" Margin="40,0,40,4" FontSize="15.5" LineHeight="18.9" FontWeight="SemiBold" Foreground="White" />
            <ListView x:Name="People" ItemTemplate="{StaticResource PersonTemplate}" Style="{StaticResource SkylineSearchPeopleRailStyle}"
                      ItemClick="OnPersonClick" GotFocus="OnPersonFocus" LostFocus="OnPersonBlur">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource SkylineCardItemStyle}">
                  <Setter Property="Margin" Value="0,0,22,0" />
                </Style>
              </ListView.ItemContainerStyle>
            </ListView>
          </StackPanel>

          <TextBlock x:Name="Status" Margin="0,8,0,8" Style="{StaticResource SkylineSearchStatusStyle}" />

          <!-- TvSearchScreen.kt SearchFeedbackMessage: the same Material Search icon for blank,
               no-match and error states. The star column wraps messages within the page gutter. -->
          <Grid x:Name="EmptyState" Style="{StaticResource SkylineSearchFeedbackStyle}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Viewbox Style="{StaticResource SkylineSearchFeedbackIconStyle}" IsHitTestVisible="False">
              <Path Style="{StaticResource SkylineSearchFeedbackIconPathStyle}"
                    Data="M15.5,14 L14.71,14 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 C5.91,3 3,5.91 3,9.5 C3,13.09 5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 L14,15.5 L19,20.49 L20.49,19 L15.5,14 Z M9.5,14 C7.01,14 5,11.99 5,9.5 C5,7.01 7.01,5 9.5,5 C11.99,5 14,7.01 14,9.5 C14,11.99 11.99,14 9.5,14 Z" />
            </Viewbox>
            <StackPanel Grid.Column="1" Style="{StaticResource SkylineSearchFeedbackContentStyle}">
              <TextBlock x:Name="EmptyTitle" Text="Search your library" Style="{StaticResource SkylineSearchFeedbackTitleStyle}" />
              <TextBlock x:Name="EmptyBody" Text="Find movies and series in one place." Style="{StaticResource SkylineSearchFeedbackBodyStyle}" />
              <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource SkylineSearchRetryStyle}" Visibility="Collapsed"
                      Click="OnRetryClick" GotFocus="OnFeedbackFocus" PreviewKeyDown="OnFeedbackPreviewKeyDown" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </GridView.Header>
      <!--
        Use the shared focus envelope inside each grid item too (TvSearchScreen.kt).
        Preserve the existing minimum inset, expanding it only when the art's zoom/ring needs more.
        Bring-into-view therefore includes the focused poster's top when scrolling up.
      -->
      <GridView.ItemContainerStyle>
        <Style TargetType="GridViewItem" BasedOn="{StaticResource SkylineGridItemStyle}">
          <Setter Property="Margin" Value="0,0,14,8" />
        </Style>
      </GridView.ItemContainerStyle>
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="views:CardView">
          <StackPanel Width="{x:Bind Width}" Spacing="9" Margin="{x:Bind GridHeadroom}">
            <Grid x:Name="Art" Width="{x:Bind Width}" Height="{x:Bind Height}">
              <Grid CornerRadius="{StaticResource SkylineCardRadius}" Background="{StaticResource SkylineCardPlaceholder}">
                <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind FallbackVisibility}" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="{StaticResource SkylineCardSubtitleSize}" VerticalAlignment="Center" Margin="8" Foreground="{StaticResource SkylineSecondary}" />
                <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                <ItemsControl ItemsSource="{x:Bind CornerTop}" ItemTemplate="{StaticResource BadgeTemplate}" Margin="{x:Bind CornerInset}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="False" IsHitTestVisible="False" />
                <ItemsControl ItemsSource="{x:Bind CornerBottom}" ItemTemplate="{StaticResource BadgeTemplate}" Margin="{x:Bind CornerInset}"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom" IsTabStop="False" IsHitTestVisible="False" />
                <Border Visibility="{x:Bind WatchedVisibility, Mode=OneWay}" Width="{x:Bind WatchedSize, Mode=OneWay}" Height="{x:Bind WatchedSize, Mode=OneWay}"
                        CornerRadius="{x:Bind WatchedRadius, Mode=OneWay}" Margin="{x:Bind WatchedInset, Mode=OneWay}" Background="#FFFFFFFF"
                        HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" AutomationProperties.Name="Watched">
                  <Viewbox Width="{x:Bind WatchedIconSize, Mode=OneWay}" Height="{x:Bind WatchedIconSize, Mode=OneWay}">
                    <Path Width="24" Height="24" Fill="#FF000000" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z" />
                  </Viewbox>
                </Border>
              </Grid>
              <Border x:Name="FocusGlow" Margin="-6" CornerRadius="{StaticResource SkylineFocusGlowRadius}" BorderThickness="3"
                      BorderBrush="{StaticResource SkylineFocusGlow}" Opacity="0" IsHitTestVisible="False" />
              <Border x:Name="FocusRing" Margin="-3" CornerRadius="{StaticResource SkylineFocusRingRadius}" BorderThickness="2"
                      BorderBrush="{StaticResource SkylineFocusRing}" Opacity="0" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Spacing="1">
              <TextBlock Text="{x:Bind Title}" FontSize="{StaticResource SkylineCardTitleSize}" FontWeight="SemiBold"
                         Foreground="{StaticResource SkylineCaptionTitle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind Subtitle}" Visibility="{x:Bind SubtitleVisibility}" FontSize="{StaticResource SkylineCardSubtitleSize}"
                         Foreground="{StaticResource SkylineCaptionSubtitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </GridView.ItemTemplate>
      <GridView.Footer>
        <!-- TvCatalogGrid.kt reserves the grid spinner for pagination, not reset searches. -->
        <ProgressRing x:Name="LoadingMoreRing" Width="32" Height="32" Margin="24" HorizontalAlignment="Center"
                      IsActive="False" Visibility="Collapsed" Foreground="{StaticResource SkylinePrimary}" />
      </GridView.Footer>
    </GridView>
  </Grid>
</Page>
