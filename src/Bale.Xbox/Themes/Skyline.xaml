  <!-- TvSearchScreen.kt: TV Material Button, 24/10dp padding, Type.kt labelLarge 18/22sp.
       ButtonDefaults.kt: minimum height 40dp, surfaceVariant/onSurface at 80%, no border,
       onSurface/inverseOnSurface on focus and 1.1 scale; not SkylineButtonStyle's glass button. -->
  <Style x:Key="SkylineSearchRetryStyle" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource SkylineFont}" />
    <Setter Property="FontSize" Value="15.5" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="#CC0E0F12" /><Setter Property="Foreground" Value="#CCEDEDED" />
    <Setter Property="MinWidth" Value="58" /><Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" /><Setter Property="Padding" Value="24,10" />
    <Setter Property="Margin" Value="0,8,0,0" /><Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Capsule" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Lift" /></Border.RenderTransform>
            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"
                       LineHeight="18.9" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" /><VisualState x:Name="Disabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Background" Value="{StaticResource SkylinePrimary}" />
                    <Setter Target="Label.Foreground" Value="#FF313033" />
                  </VisualState.Setters>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.12" />
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.12" />
                  </Storyboard>
                </VisualState>
                <VisualState x:Name="PointerFocused" /><VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
