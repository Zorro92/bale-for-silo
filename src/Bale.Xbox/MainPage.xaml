<Page
    x:Class="Bale.Xbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource SkylineAurora}">

  <!-- TvMarquee.kt: 45dp safe sides, left copy and a 320dp card, no signed-in shell chrome. -->
  <Grid Style="{StaticResource SkylineAuthLayoutStyle}">
    <Grid.RowDefinitions>
      <RowDefinition Height="{StaticResource SkylineAuthHeaderRow}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
      <TextBlock Text="BALE" FontSize="{StaticResource SkylineWordmarkSize}" FontWeight="Black" CharacterSpacing="340" VerticalAlignment="Center" />
      <TextBlock Text="a client for Silo" FontSize="{StaticResource SkylineCardSubtitleSize}" Foreground="{StaticResource SkylineTertiary}" VerticalAlignment="Center" />
    </StackPanel>

    <!-- TvServerSetupScreen.kt AddressEntryScreen: manual-entry copy and Connect / plain Back.
         Phone setup, discovery and advanced connection options remain separate backlog work. -->
    <StackPanel x:Name="ServerPanel" Grid.Row="1" Style="{StaticResource SkylineServerEntryStyle}">
      <TextBlock Text="Enter your&#x0A;server address" Style="{StaticResource SkylineServerEntryTitleStyle}" />
      <TextBlock Text="Type the address you use for Silo." Style="{StaticResource SkylineServerEntryCaptionStyle}" />
      <TextBox x:Name="ServerBox" PlaceholderText="media.example.com" InputScope="Url" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
               TextChanged="OnServerTextChanged" KeyDown="OnServerBoxKeyDown" Style="{StaticResource SkylineServerAddressStyle}" />
      <TextBlock x:Name="ServerError" Visibility="Collapsed" Style="{StaticResource SkylineServerEntryErrorStyle}" AutomationProperties.LiveSetting="Polite" />
      <TextBlock x:Name="ServerSecurityHint" Text="Secure HTTPS is tried automatically." Style="{StaticResource SkylineServerEntryHintStyle}" />
      <!-- rail-layout: non-card — TvServerSetupScreen.kt manual server-entry actions. -->
      <ItemsControl x:Name="ServerActions" Style="{StaticResource SkylineServerEntryActionsStyle}" PreviewKeyDown="OnServerActionsPreviewKeyDown">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource SkylineAuthActionGap}" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClick" Style="{StaticResource SkylineAuthButtonStyle}" />
        <Button x:Name="ServerBackButton" Content="Back" Click="OnServerBackClick" Style="{StaticResource SkylineAuthPlainButtonStyle}" />
      </ItemsControl>
    </StackPanel>

    <!-- TvLoginScreen.kt / TvMarquee.kt: server context and copy opposite a single QR/code/status card. -->
    <Grid x:Name="CodePanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource SkylineAuthCopyColumn}" />
        <ColumnDefinition Width="*" MinWidth="{StaticResource SkylineAuthColumnGap}" />
        <ColumnDefinition Width="{StaticResource SkylineAuthCardColumn}" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <!-- TvLoginScreen.kt notices: a polite status chip ABOVE the server card, not an error on it. -->
        <Border x:Name="SessionNotice" Visibility="Collapsed" Style="{StaticResource SkylineSessionNoticeStyle}">
          <StackPanel Style="{StaticResource SkylineSessionNoticeContentStyle}">
            <Viewbox Style="{StaticResource SkylineSessionNoticeIconStyle}">
              <Path Data="M11,15H13V17H11M11,7H13V13H11M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z" Fill="{StaticResource SkylineAuthSecondary}" />
            </Viewbox>
            <TextBlock x:Name="SessionNoticeText" Style="{StaticResource SkylineSessionNoticeTextStyle}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SkylineLoginServerCardStyle}">
          <StackPanel Orientation="Horizontal">
            <!-- MarqueeServerMark.kt: branded mark over a serif initial, or a plain dark tile. -->
            <Grid>
              <Border Style="{StaticResource SkylineLoginEmptyServerMarkStyle}" />
              <Border x:Name="ServerInitialMark" Style="{StaticResource SkylineLoginServerMarkStyle}">
                <TextBlock x:Name="ServerInitialText" Style="{StaticResource SkylineLoginServerInitialStyle}" />
              </Border>
              <Border x:Name="ServerImageMark" Visibility="Collapsed" Style="{StaticResource SkylineLoginServerMarkStyle}">
                <Border.Background><ImageBrush x:Name="ServerMarkBrush" Stretch="UniformToFill" /></Border.Background>
              </Border>
            </Grid>
            <StackPanel Style="{StaticResource SkylineLoginServerLabelsStyle}">
              <TextBlock x:Name="ServerNameText" Style="{StaticResource SkylineLoginServerNameStyle}" />
              <TextBlock x:Name="ServerAddressText" Style="{StaticResource SkylineLoginServerAddressStyle}" />
            </StackPanel>
            <Border x:Name="SecureBadge" Style="{StaticResource SkylineLoginSecureBadgeStyle}">
              <TextBlock Text="SECURE" Style="{StaticResource SkylineLoginSecurityTextStyle}" />
            </Border>
            <Border x:Name="HttpBadge" Visibility="Collapsed" Style="{StaticResource SkylineLoginHttpBadgeStyle}">
              <TextBlock Text="HTTP" Foreground="{StaticResource SkylineAuthWarning}" Style="{StaticResource SkylineLoginSecurityTextStyle}" />
            </Border>
          </StackPanel>
        </Border>
        <TextBlock x:Name="SignInTitle" Style="{StaticResource SkylineLoginTitleStyle}" />
        <TextBlock x:Name="SignInInstructions" Style="{StaticResource SkylineLoginInstructionsStyle}" />
        <StackPanel Style="{StaticResource SkylineLoginHintRowStyle}">
          <Viewbox Style="{StaticResource SkylineLoginPhoneIconStyle}">
            <Path Data="M17,1H7A2,2 0 0,0 5,3V21A2,2 0 0,0 7,23H17A2,2 0 0,0 19,21V3A2,2 0 0,0 17,1M17,19H7V5H17M13,22H11V20H13Z" Fill="{StaticResource SkylineAuthTertiary}" />
          </Viewbox>
          <TextBlock Text="Have Silo on your phone? Open it on the same Wi‑Fi to sign in this TV." Style="{StaticResource SkylineLoginHintStyle}" />
        </StackPanel>
        <!-- rail-layout: non-card — TvLoginScreen.kt CodeActions; password sign-in is a later backlog item. -->
        <ItemsControl x:Name="CodeActions" Style="{StaticResource SkylineLoginActionsStyle}" PreviewKeyDown="OnCodeActionsPreviewKeyDown">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource SkylineAuthActionGap}" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <Button x:Name="NewCodeButton" Content="Show a new code" Click="OnNewCodeClick" Visibility="Collapsed" Style="{StaticResource SkylineAuthButtonStyle}" />
          <Button x:Name="ChangeServerButton" Content="Change server" Click="OnChangeServerClick" Style="{StaticResource SkylineAuthPlainButtonStyle}" />
        </ItemsControl>
      </StackPanel>
      <Border Grid.Column="2" Style="{StaticResource SkylineLoginCardStyle}">
        <StackPanel HorizontalAlignment="Center">
          <StackPanel x:Name="CodeDetails">
            <Border Style="{StaticResource SkylineLoginQrFrameStyle}">
              <Grid>
                <Image x:Name="QrImage" Style="{StaticResource SkylineLoginQrImageStyle}" AutomationProperties.Name="Scan to sign in on your phone" />
                <ProgressRing x:Name="CodeLoadingRing" IsActive="True" Style="{StaticResource SkylineLoginLoadingRingStyle}" />
                <TextBlock x:Name="QrFallback" Text="Use the address&#x0A;and code below" Visibility="Collapsed" Style="{StaticResource SkylineLoginQrFallbackStyle}" />
              </Grid>
            </Border>
            <!-- TvMarqueeCodeTiles: grouped tabular digits, shrinking long codes to fit. -->
            <Viewbox Style="{StaticResource SkylineLoginCodeBoxStyle}">
              <TextBlock x:Name="CodeText" Style="{StaticResource SkylineLoginCodeStyle}" Typography.NumeralAlignment="Tabular" Typography.SlashedZero="True" />
            </Viewbox>
            <TextBlock x:Name="ActivateText" Style="{StaticResource SkylineLoginActivateStyle}" />
          </StackPanel>
          <Viewbox x:Name="CodeProblemIcon" Visibility="Collapsed" Style="{StaticResource SkylineLoginProblemSymbolStyle}">
            <Path Data="M11,15H13V17H11M11,7H13V13H11M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z" Fill="{StaticResource SkylineAuthWarning}" />
          </Viewbox>
          <Viewbox x:Name="CodeApprovedIcon" Visibility="Collapsed" Style="{StaticResource SkylineLoginApprovedSymbolStyle}">
            <Path Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59Z" Fill="{StaticResource SkylineAuthLive}" />
          </Viewbox>
          <!-- TvLoginScreen.kt CodeCard: Opened replaces Waiting with Continue on your phone. -->
          <StackPanel Style="{StaticResource SkylineLoginStatusRowStyle}">
            <ProgressRing x:Name="PairingRing" IsActive="True" Style="{StaticResource SkylineLoginStatusRingStyle}" />
            <TextBlock x:Name="PairingStatus" Text="Getting a sign-in code…" Style="{StaticResource SkylineLoginStatusStyle}" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="PairingError" Visibility="Collapsed" Style="{StaticResource SkylineLoginErrorStatusStyle}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Page>
