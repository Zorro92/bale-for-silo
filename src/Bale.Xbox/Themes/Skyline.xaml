<!--
  Silo TV design, as Silo's Android TV app draws it (silo-android androidTvApp ui/theme and
  ui/components). Navigation follows Skyline (silo-apple docs/skyline-design-guide.md); sizes and
  look follow the Android TV code. Xbox lays out at 960x540 effective pixels, the same canvas as
  Android TV's dp, so geometry maps 1:1 and text is the Android sp value x 0.86 (TvUiFontScale).
  Keep this file the only place sizes and colors are defined, and never look these resources up
  from code: under Native AOT that throws, so pages reference them from XAML only.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:Bale.Xbox.Services">

  <!-- Typeface: Inter, as bundled by the Android apps (OFL, see THIRD_PARTY_NOTICES.md). -->
  <FontFamily x:Key="SkylineFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
  <FontFamily x:Key="SkylineMono">Consolas</FontFamily>

  <!-- Colors (Color.kt). Monochrome white-at-opacity; the page tint comes from the focused art. -->
  <SolidColorBrush x:Key="SkylineBackground" Color="#FF000000" />
  <SolidColorBrush x:Key="SkylineSurfaceElevated" Color="#FF15171C" />
  <SolidColorBrush x:Key="SkylinePrimary" Color="#FFEDEDED" />
  <SolidColorBrush x:Key="SkylineSecondary" Color="#BFEDEDED" />
  <SolidColorBrush x:Key="SkylineTertiary" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="SkylineCaptionTitle" Color="#C7FFFFFF" />
  <SolidColorBrush x:Key="SkylineCaptionSubtitle" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="SkylineHairline" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="SkylineChromeSelected" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="SkylineChromeSelectedBorder" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="SkylineChromeResting" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="SkylineTabResting" Color="#9EEDEDED" />
  <SolidColorBrush x:Key="SkylineGlassStrong" Color="#DB16171B" />
  <SolidColorBrush x:Key="SkylineScrimDropdown" Color="#8C000000" />
  <SolidColorBrush x:Key="SkylineCardPlaceholder" Color="#FF15171C" />
  <SolidColorBrush x:Key="SkylineProgressTrack" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="SkylineFocusRing" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="SkylineFocusGlow" Color="#47FFFFFF" />
  <SolidColorBrush x:Key="SkylineBadgeFill" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="SkylineBadgeBorder" Color="#3DFFFFFF" />
  <SolidColorBrush x:Key="SkylineBadgeText" Color="#EBFFFFFF" />
  <SolidColorBrush x:Key="SkylineError" Color="#FFFF8A80" />

  <!-- First-run screens: the "plum night" Aurora backdrop (TvAuroraBackdrop.kt). -->
  <LinearGradientBrush x:Key="SkylineAurora" StartPoint="0.5,0" EndPoint="0.5,1">
    <GradientStop Color="#FF1C1329" Offset="0" />
    <GradientStop Color="#FF0D0A17" Offset="0.55" />
    <GradientStop Color="#FF070509" Offset="1" />
  </LinearGradientBrush>

  <!-- Geometry (Spacing.kt, RowDimens, TvSkyline). -->
  <CornerRadius x:Key="SkylineCardRadius">8</CornerRadius>
  <CornerRadius x:Key="SkylineFocusRingRadius">11</CornerRadius>
  <CornerRadius x:Key="SkylineFocusGlowRadius">14</CornerRadius>
  <CornerRadius x:Key="SkylinePanelRadius">12</CornerRadius>
  <CornerRadius x:Key="SkylineRowRadius">8</CornerRadius>
  <CornerRadius x:Key="SkylineBadgeRadius">3</CornerRadius>
  <!-- Pills need radius = half the height exactly: UWP turns larger radii into ovals, it doesn't clamp. -->
  <x:Double x:Key="SkylineTabHeight">30</x:Double>
  <CornerRadius x:Key="SkylineTabPill">15</CornerRadius>
  <x:Double x:Key="SkylineButtonHeight">32</x:Double>
  <CornerRadius x:Key="SkylineButtonPill">16</CornerRadius>
  <x:Double x:Key="SkylineSubPillHeight">24</x:Double>
  <CornerRadius x:Key="SkylineSubPill">12</CornerRadius>

  <!-- Type (Type.kt and component sizes, x 0.86). -->
  <x:Double x:Key="SkylineWordmarkSize">13</x:Double>
  <x:Double x:Key="SkylineTabSize">12.9</x:Double>
  <x:Double x:Key="SkylinePillSize">11.2</x:Double>
  <x:Double x:Key="SkylineMarqueeTitleSize">37.8</x:Double>
  <x:Double x:Key="SkylineMarqueeTitleLine">43.5</x:Double>
  <x:Double x:Key="SkylineMarqueeTitleCompactSize">30</x:Double>
  <x:Double x:Key="SkylineMetaSize">12</x:Double>
  <x:Double x:Key="SkylineSynopsisSize">13.8</x:Double>
  <x:Double x:Key="SkylineSynopsisLine">18.6</x:Double>
  <x:Double x:Key="SkylineBadgeSize">9</x:Double>
  <x:Double x:Key="SkylineRowTitleSize">15.5</x:Double>
  <x:Double x:Key="SkylineCardTitleSize">13.3</x:Double>
  <x:Double x:Key="SkylineCardSubtitleSize">12</x:Double>
  <x:Double x:Key="SkylineCardOverlaySize">11.5</x:Double>
  <x:Double x:Key="SkylineDropdownRowSize">13</x:Double>
  <x:Double x:Key="SkylineDropdownHeaderSize">9</x:Double>
  <x:Double x:Key="SkylineScreenTitleSize">31</x:Double>
  <x:Double x:Key="SkylineBodySize">13.8</x:Double>
  <x:Double x:Key="SkylineButtonSize">13</x:Double>

  <!--
    Capsule control for buttons and pills. Focused inverts to a white capsule with a black label.
    No system focus rectangle: the inversion is the focus cue. No implicit transitions inside
    templates: on the console they crashed the first layout.
  -->
  <Style x:Key="SkylineCapsuleStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource SkylineTabResting}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14.5,6" />
    <Setter Property="FontSize" Value="{StaticResource SkylineTabSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Height" Value="{StaticResource SkylineTabHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylineTabPill}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Capsule" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Opacity" Value="0.85" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Capsule.Background" Value="{StaticResource SkylinePrimary}" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylineBackground}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    TvTopMenuBar.kt: resting labels are Medium at 62%; selected/focused labels are SemiBold.
    Checked = the selected destination (chrome.selected capsule, full-white label); Focused =
    inverted white capsule, black label. Content must be a string, never an element: the template
    shows it in two presenters.
  -->
  <Style x:Key="SkylineTabStyle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{StaticResource SkylineTabResting}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Height" Value="{StaticResource SkylineTabHeight}" />
    <Setter Property="Padding" Value="14.5,0" />
    <Setter Property="FontSize" Value="{StaticResource SkylineTabSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="SelectedFill" CornerRadius="{StaticResource SkylineTabPill}" Background="{StaticResource SkylineChromeSelected}"
                    BorderBrush="{StaticResource SkylineChromeSelectedBorder}" BorderThickness="1" Opacity="0" />
            <Border x:Name="FocusFill" CornerRadius="{StaticResource SkylineTabPill}" Background="{StaticResource SkylinePrimary}" Opacity="0" />
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                              FontFamily="{TemplateBinding FontFamily}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <ContentPresenter x:Name="FocusedContent" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                              Foreground="{StaticResource SkylineBackground}" FontSize="{TemplateBinding FontSize}" FontWeight="SemiBold"
                              FontFamily="{TemplateBinding FontFamily}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Opacity="0" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
                <VisualState x:Name="Checked">
                  <VisualState.Setters>
                    <Setter Target="SelectedFill.Opacity" Value="1" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylinePrimary}" />
                    <Setter Target="Content.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPointerOver">
                  <VisualState.Setters>
                    <Setter Target="SelectedFill.Opacity" Value="1" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylinePrimary}" />
                    <Setter Target="Content.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedPressed">
                  <VisualState.Setters>
                    <Setter Target="SelectedFill.Opacity" Value="1" />
                    <Setter Target="Content.Foreground" Value="{StaticResource SkylinePrimary}" />
                    <Setter Target="Content.FontWeight" Value="SemiBold" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CheckedDisabled" />
                <VisualState x:Name="Indeterminate" />
                <VisualState x:Name="IndeterminatePointerOver" />
                <VisualState x:Name="IndeterminatePressed" />
                <VisualState x:Name="IndeterminateDisabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusFill.Opacity" Value="1" />
                    <Setter Target="Content.Opacity" Value="0" />
                    <Setter Target="FocusedContent.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- TvTopMenuBar.kt: the avatar keeps its 18% white fill; only its ring changes on focus. -->
  <Style x:Key="SkylineAvatarStyle" TargetType="Button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse Fill="#2EFFFFFF" />
            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Ellipse x:Name="Ring" Stroke="#2EFFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Ring.Stroke" Value="{StaticResource SkylinePrimary}" />
                    <Setter Target="Ring.StrokeThickness" Value="2" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons on full screens (sign-in): resting white @ 8% with a hairline, inverts on focus. -->
  <Style x:Key="SkylineButtonStyle" TargetType="Button" BasedOn="{StaticResource SkylineCapsuleStyle}">
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="Background" Value="{StaticResource SkylineChromeResting}" />
    <Setter Property="BorderBrush" Value="{StaticResource SkylineHairline}" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="Height" Value="{StaticResource SkylineButtonHeight}" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylineButtonPill}" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="FontSize" Value="{StaticResource SkylineButtonSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Rows in anchored panels (library panel, profile dropdown): left-aligned, invert on focus. -->
  <Style x:Key="SkylinePanelRowStyle" TargetType="Button" BasedOn="{StaticResource SkylineCapsuleStyle}">
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylineRowRadius}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="{StaticResource SkylineDropdownRowSize}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <!--
    Card containers. Focus is drawn by the card template's FocusRing/FocusGlow (2 px white ring
    and soft glow, rounded like the card) and a 1.05 lift of the art only, captions stay put (CardFocus).
  -->
  <Style x:Key="SkylineCardItemStyle" TargetType="ListViewItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,20,0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!--
    Every horizontal card rail derives from this style (TvMediaRow.kt). RailLayout computes
    ceil(cardSize * (focusScale - 1) / 2 + scaled ring/glow outset + 1) on each axis.
    ListView's native template puts Padding on the ItemsPresenter inside the ScrollViewer,
    so focus stays inside the viewport clip. ContentInset preserves resting geometry; the
    helper compensates extra vertical headroom with outer margins, never by disabling clipping.
  -->
  <Style x:Key="SkylineCardRailStyle" TargetType="ListView">
    <Setter Property="services:RailLayout.IsEnabled" Value="True" />
    <Setter Property="SelectionMode" Value="None" />
    <Setter Property="IsItemClickEnabled" Value="True" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource SkylineCardItemStyle}" />
    <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Enabled" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
    <Setter Property="ScrollViewer.VerticalScrollMode" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Insets are the existing resting layout, not focus headroom. Browse binds the active
       poster/thumb dimensions so a refreshed row also recalculates its viewport. -->
  <Style x:Key="SkylineBrowseRailStyle" TargetType="ListView" BasedOn="{StaticResource SkylineCardRailStyle}">
    <Setter Property="services:RailLayout.ContentInset" Value="44,7,40,7" />
  </Style>
  <Style x:Key="SkylineSearchPeopleRailStyle" TargetType="ListView" BasedOn="{StaticResource SkylineCardRailStyle}">
    <Setter Property="services:RailLayout.CardWidth" Value="100" />
    <Setter Property="services:RailLayout.CardHeight" Value="100" />
    <Setter Property="services:RailLayout.ContentInset" Value="40,12,40,4" />
  </Style>
  <Style x:Key="SkylineDetailEpisodeRailStyle" TargetType="ListView" BasedOn="{StaticResource SkylineCardRailStyle}">
    <Setter Property="services:RailLayout.CardWidth" Value="180" />
    <Setter Property="services:RailLayout.CardHeight" Value="101" />
    <Setter Property="services:RailLayout.FocusVisual" Value="Episode" />
    <Setter Property="services:RailLayout.ContentInset" Value="50,10,0,6" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>
  <Style x:Key="SkylineDetailCastRailStyle" TargetType="ListView" BasedOn="{StaticResource SkylineCardRailStyle}">
    <Setter Property="services:RailLayout.CardWidth" Value="100" />
    <Setter Property="services:RailLayout.CardHeight" Value="100" />
    <Setter Property="services:RailLayout.ContentInset" Value="50,12,0,12" />
    <Setter Property="IsTabStop" Value="False" />
  </Style>

  <Style x:Key="SkylineGridItemStyle" TargetType="GridViewItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,20,16" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style x:Key="SkylineTextBoxStyle" TargetType="TextBox">
    <Setter Property="FontSize" Value="{StaticResource SkylineBodySize}" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylineRowRadius}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource SkylinePrimary}" />
  </Style>

  <!--
    Search only (TvSearchScreen.kt / Color.kt / Type.kt). Keep this separate from the shared
    TextBox style: the 20sp text, leading icon and ElevatedSurface @ 80% belong to SearchStage.
    ContentElement and PlaceholderTextContentPresenter are TextBox's native template parts.
  -->
  <Style x:Key="SkylineSearchTextBoxStyle" TargetType="TextBox">
    <Setter Property="Width" Value="520" />
    <Setter Property="Height" Value="52" />
    <Setter Property="FontSize" Value="17.2" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
    <Setter Property="Background" Value="#0EFFFFFF" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="0,0,16,0" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Field.Background" Value="#CC15171C" />
                    <Setter Target="Field.BorderBrush" Value="#F0FFFFFF" />
                    <Setter Target="Field.BorderThickness" Value="2" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters>
                    <Setter Target="Field.Opacity" Value="0.4" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="#B8FFFFFF" IsHitTestVisible="False" />
              <ScrollViewer x:Name="ContentElement" Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                            HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                            ZoomMode="Disabled" IsTabStop="False" />
              <ContentControl x:Name="PlaceholderTextContentPresenter" Grid.Column="1" Padding="{TemplateBinding Padding}"
                              Content="{TemplateBinding PlaceholderText}" Foreground="#8FFFFFFF" FontSize="15.5"
                              FontFamily="{TemplateBinding FontFamily}" VerticalAlignment="Center"
                              IsTabStop="False" IsHitTestVisible="False" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SkylineSearchStatusStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.8" />
    <Setter Property="LineHeight" Value="18.9" />
    <Setter Property="MinHeight" Value="18.9" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="#9EFFFFFF" />
  </Style>
  <Style x:Key="SkylineSearchFeedbackTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="18.9" />
    <Setter Property="LineHeight" Value="24.1" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SkylineSearchFeedbackBodyStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15.5" />
    <Setter Property="LineHeight" Value="20.6" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="Foreground" Value="#9EFFFFFF" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SkylineSearchRetryStyle" TargetType="Button" BasedOn="{StaticResource SkylineButtonStyle}">
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="24,0" />
    <Setter Property="FontSize" Value="15.5" />
  </Style>
  <!-- Outlined marquee badge (TvFocusMarquee.MarqueeBadge): "4K", "HDR", "EAC3", "TV-MA". -->
  <Style x:Key="SkylineBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SkylineBadgeFill}" />
    <Setter Property="BorderBrush" Value="{StaticResource SkylineBadgeBorder}" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="CornerRadius" Value="{StaticResource SkylineBadgeRadius}" />
    <Setter Property="Padding" Value="6,2.5" />
  </Style>

  <!--
    Top bar icon (TvTopMenuBar.TvTopMenuIconButton): a 28 circle, bare at rest with the glyph at
    62%, solid white with a black glyph on focus. Content must be a glyph string.
  -->
  <Style x:Key="SkylineBarIconStyle" TargetType="Button">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Foreground" Value="#9EEDEDED" />
    <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Ellipse x:Name="Disc" Fill="Transparent" />
            <ContentPresenter x:Name="Glyph" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="Disc.Fill" Value="{StaticResource SkylinePrimary}" />
                    <Setter Target="Glyph.Foreground" Value="{StaticResource SkylineBackground}" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="PointerFocused" />
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
