<Project Sdk="Microsoft.NET.Sdk">

  <!-- UWP on modern .NET with Native AOT. Builds on Windows only (XAML compiler + MSIX tooling);
       CI does this on a GitHub-hosted Windows runner. Everything testable lives in Bale.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Bale.Xbox</RootNamespace>
    <AssemblyName>Bale</AssemblyName>
    <UseUwp>true</UseUwp>
    <UseUwpTools>true</UseUwpTools>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Auto: also generate WinRT vtables for generic collections handed to XAML (ItemsSource = List<T>), which AOT can't do at runtime. -->
    <CsWinRTAotOptimizerEnabled>Auto</CsWinRTAotOptimizerEnabled>
    <!-- The generated vtables use unsafe code; without this CsWinRT silently skips them (CsWinRT1030). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <!-- Development control channel (Services/DebugServer.cs). Build with -p:BaleDebugServer=false for anything shipped. -->
    <BaleDebugServer Condition="'$(BaleDebugServer)' == ''">true</BaleDebugServer>
    <DefineConstants Condition="'$(BaleDebugServer)' == 'true'">$(DefineConstants);DEBUG_SERVER</DefineConstants>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\Fonts\InterVariable.ttf" />
    <Content Include="Assets\Fonts\InterTight-Black.ttf" />
    <Content Include="Assets\Fonts\Inter-OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bale.Core\Bale.Core.csproj" />
  </ItemGroup>

  <!-- Debug-server builds only: WinUI 2 for the WebView2 input-idle comparison (Services/DebugServer.WebViewTest.cs).
       Shipped builds (BaleDebugServer=false) never reference it. -->
  <ItemGroup Condition="'$(BaleDebugServer)' == 'true'">
    <PackageReference Include="Microsoft.UI.Xaml" Version="[2.8.7]" />
  </ItemGroup>

  <!-- Production fallback: native decoders, activation and license texts ship in every build. -->
  <PropertyGroup>
    <!-- Same directory cargo links libass from (BALE_LIBASS_DIR); the build script's default output otherwise. -->
    <BaleLibassDir>$(BALE_LIBASS_DIR)</BaleLibassDir>
    <BaleLibassDir Condition="'$(BaleLibassDir)' == ''">$(MSBuildThisFileDirectory)..\..\.libass</BaleLibassDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFmpegInteropX.UWP.Lib" Version="[2.1.0-bale.21]" GeneratePathProperty="true" />
    <PackageReference Include="FFmpegInteropX.UWP.FFmpeg" Version="[8.1.2-bale.dav1d.1.5.4.p1]" GeneratePathProperty="true" />
    <Content Include="$(PkgFFmpegInteropX_UWP_FFmpeg)\licenses\*.txt" Link="Licenses\FFmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgFFmpegInteropX_UWP_FFmpeg)\SOURCES.txt" Link="Licenses\FFmpeg\SOURCES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(PkgFFmpegInteropX_UWP_Lib)\SOURCES.txt" Link="Licenses\FFmpegInteropX\SOURCES.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Rust GPU/media layer (native/bale-gpu), built by CI with cargo before msbuild. -->
    <Content Include="..\..\native\bale-gpu\target\x86_64-pc-windows-msvc\release\bale_gpu.dll" Link="bale_gpu.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\FFmpegInteropX-LICENSE.txt" Link="Licenses\FFmpegInteropX.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- libass, FreeType, FriBidi, HarfBuzz: static in bale_gpu.dll, built by scripts/build-libass-native.ps1. -->
    <Content Include="$(BaleLibassDir)\licenses\*.txt" Link="Licenses\libass\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(BaleLibassDir)\SOURCES.txt" Link="Licenses\libass\SOURCES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The net6 CsWinRT projection does not register the native component with UWP packaging.
       Transform the stamped manifest in every build, preserving its identity. -->
  <Target Name="PrepareFFmpegManifest" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_FFmpegManifest>$(IntermediateOutputPath)ffmpeg\Package.appxmanifest</_FFmpegManifest>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)ffmpeg" />
    <XslTransformation XmlInputPaths="Package.appxmanifest" XslInputPath="Build\FFmpegManifest.xslt" OutputPaths="$(_FFmpegManifest)" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(_FFmpegManifest)" />
      <FileWrites Include="$(_FFmpegManifest)" />
    </ItemGroup>
  </Target>

</Project>
