<Page
    x:Class="Bale.Xbox.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    Background="{StaticResource SkylineBackground}">

  <Page.Resources>
    <!-- Same card overlay badges as Home (CardOverlays, Classic preset). -->
    <DataTemplate x:Key="BadgeTemplate" x:DataType="views:BadgeView">
      <Border Background="#99000000" BorderBrush="#26FFFFFF" BorderThickness="{x:Bind Border}" CornerRadius="{x:Bind Radius}"
              Padding="{x:Bind Padding}" HorizontalAlignment="Left" Margin="0,0,0,1">
        <TextBlock Text="{x:Bind Text}" FontSize="{x:Bind FontSize}" FontWeight="SemiBold" CharacterSpacing="55" Foreground="#FFFFFFFF" />
      </Border>
    </DataTemplate>
  </Page.Resources>

  <!--
    Search as Silo's Android TV TvSearchScreen lays it out: a 520 x 52 field at the safe area, the
    All / Movies / Series filter chips, a result count, then a grid of 138 x 207 posters with 14 / 20
    gaps. The grid spans the page so a focused poster's lift and ring are never clipped.
  -->
  <Grid Margin="0,90,0,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBox x:Name="QueryBox" Margin="40,0,0,0" Width="520" Height="52" Padding="18,15,18,0" HorizontalAlignment="Left" PlaceholderText="Search movies and series"
             Style="{StaticResource SkylineTextBoxStyle}" TextChanged="OnQueryChanged" InputScope="Search" />

    <StackPanel x:Name="Filters" Grid.Row="1" Margin="40,8,0,0" Orientation="Horizontal" Spacing="12" XYFocusKeyboardNavigation="Enabled">
      <ToggleButton x:Name="AllFilter" Content="All" Tag="" Style="{StaticResource SkylineFilterChipStyle}" IsChecked="True" Click="OnFilterClick" />
      <ToggleButton x:Name="MoviesFilter" Content="Movies" Tag="movie" Style="{StaticResource SkylineFilterChipStyle}" Click="OnFilterClick" />
      <ToggleButton x:Name="SeriesFilter" Content="Series" Tag="series" Style="{StaticResource SkylineFilterChipStyle}" Click="OnFilterClick" />
    </StackPanel>

    <TextBlock x:Name="Status" Grid.Row="2" Margin="40,8,0,0" FontSize="11.2" Foreground="#9EFFFFFF" />

    <!-- Empty state (TvSearchScreen): an icon, a title and one line. -->
    <StackPanel x:Name="EmptyState" Grid.Row="3" Margin="40,60,0,0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Top">
      <FontIcon Glyph="&#xE721;" FontSize="24" Foreground="#80FFFFFF" VerticalAlignment="Top" Margin="0,2,0,0" />
      <StackPanel Spacing="4">
        <TextBlock x:Name="EmptyTitle" Text="Search your library" FontSize="17.2" FontWeight="SemiBold" />
        <TextBlock x:Name="EmptyBody" Text="Find movies and series in one place." FontSize="13" Foreground="{StaticResource SkylineSecondary}" />
      </StackPanel>
    </StackPanel>

    <GridView x:Name="Results" Grid.Row="3" Padding="40,2,8,40" SelectionMode="None" IsItemClickEnabled="True"
              ItemClick="OnResultClick" GotFocus="OnResultFocus" LostFocus="OnResultBlur">
      <!--
        Keep 12px headroom inside each result container; the row gap stays 20 (TvSearchScreen.kt).
        The grid scrolls only enough to show the container, so this includes the focused poster's
        lift and ring when scrolling up.
      -->
      <GridView.ItemContainerStyle>
        <Style TargetType="GridViewItem" BasedOn="{StaticResource SkylineGridItemStyle}">
          <Setter Property="Margin" Value="0,0,14,8" />
        </Style>
      </GridView.ItemContainerStyle>
      <GridView.ItemTemplate>
        <DataTemplate x:DataType="views:CardView">
          <StackPanel Width="{x:Bind Width}" Spacing="9" Margin="0,12,0,0">
            <Grid x:Name="Art" Width="{x:Bind Width}" Height="{x:Bind Height}">
              <Grid CornerRadius="{StaticResource SkylineCardRadius}" Background="{StaticResource SkylineCardPlaceholder}">
                <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind FallbackVisibility}" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="{StaticResource SkylineCardSubtitleSize}" VerticalAlignment="Center" Margin="8" Foreground="{StaticResource SkylineSecondary}" />
                <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
                <ItemsControl ItemsSource="{x:Bind CornerTop}" ItemTemplate="{StaticResource BadgeTemplate}" Margin="{x:Bind CornerInset}"
                              HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="False" IsHitTestVisible="False" />
                <ItemsControl ItemsSource="{x:Bind CornerBottom}" ItemTemplate="{StaticResource BadgeTemplate}" Margin="{x:Bind CornerInset}"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom" IsTabStop="False" IsHitTestVisible="False" />
              </Grid>
              <Border x:Name="FocusGlow" Margin="-6" CornerRadius="{StaticResource SkylineFocusGlowRadius}" BorderThickness="3"
                      BorderBrush="{StaticResource SkylineFocusGlow}" Opacity="0" IsHitTestVisible="False" />
              <Border x:Name="FocusRing" Margin="-3" CornerRadius="{StaticResource SkylineFocusRingRadius}" BorderThickness="2"
                      BorderBrush="{StaticResource SkylineFocusRing}" Opacity="0" IsHitTestVisible="False" />
            </Grid>
            <StackPanel Spacing="1">
              <TextBlock Text="{x:Bind Title}" FontSize="{StaticResource SkylineCardTitleSize}" FontWeight="SemiBold"
                         Foreground="{StaticResource SkylineCaptionTitle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{x:Bind Subtitle}" Visibility="{x:Bind SubtitleVisibility}" FontSize="{StaticResource SkylineCardSubtitleSize}"
                         Foreground="{StaticResource SkylineCaptionSubtitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
