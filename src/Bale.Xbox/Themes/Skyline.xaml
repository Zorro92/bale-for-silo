  <Style x:Key="SkylineCredentialFieldStyle" TargetType="TextBox" BasedOn="{StaticResource SkylineTextBoxStyle}">
    <Setter Property="Width" Value="380" />
    <Setter Property="Height" Value="42" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="FontSize" Value="12.9" />
    <Setter Property="Background" Value="#14FFFFFF" />
    <Setter Property="BorderBrush" Value="#1FFFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="15,0" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <!-- TvMarqueeField.kt: 16dp credential icon + 9dp gap; center the actual native editing parts,
         not VerticalContentAlignment, which the stock UWP TextBox template ignores. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><ScaleTransform x:Name="FieldLift" /></Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver" />
                <VisualState x:Name="Focused">
                  <VisualState.Setters>
                    <Setter Target="FocusedField.Opacity" Value="1" />
                    <Setter Target="ContentElement.Foreground" Value="Black" />
                    <Setter Target="PlaceholderTextContentPresenter.Foreground" Value="#66000000" />
                    <Setter Target="LanguageIcon.Fill" Value="#73000000" />
                    <Setter Target="FieldLift.ScaleX" Value="1.04" />
                    <Setter Target="FieldLift.ScaleY" Value="1.04" />
                  </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Disabled">
                  <VisualState.Setters><Setter Target="FieldContent.Opacity" Value="0.5" /></VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
              <!-- TvMarqueeField.kt: error glass is 6%; its 1.5dp error stroke survives focus. -->
              <VisualStateGroup x:Name="ValidationStates">
                <VisualState x:Name="Valid" />
                <VisualState x:Name="Invalid">
                  <VisualState.Setters>
                    <Setter Target="Field.Background" Value="#0FFFFFFF" />
                    <Setter Target="Field.BorderBrush" Value="Transparent" />
                    <Setter Target="FieldError.Opacity" Value="1" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" />
            <!-- TvMarqueeField.kt uses the same RoundedCornerShape for every fill/stroke.
                 Separate focus fill and error stroke keep validation independent of focus state. -->
            <Border x:Name="FocusedField" Background="{StaticResource SkylinePrimary}"
                    CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
            <Border x:Name="FieldError" BorderBrush="#BFFF6961" BorderThickness="1.5"
                    CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
            <Grid x:Name="FieldContent" Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                <Path x:Name="LanguageIcon" Fill="{StaticResource SkylineAuthTertiary}"
                      Data="M12,12A4,4 0 1,0 12,4A4,4 0 0,0 12,12M12,14C7.58,14 4,15.79 4,18V20H20V18C20,15.79 16.42,14 12,14Z" />
              </Viewbox>
              <ScrollViewer x:Name="ContentElement" Grid.Column="2" VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled" IsTabStop="False" />
              <ContentControl x:Name="PlaceholderTextContentPresenter" Grid.Column="2" VerticalAlignment="Center"
                              Content="{TemplateBinding PlaceholderText}" Foreground="{StaticResource SkylineAuthTertiary}"
                              FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                              IsTabStop="False" IsHitTestVisible="False" />
            </Grid>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
