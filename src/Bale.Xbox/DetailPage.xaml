<Page
    x:Class="Bale.Xbox.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    xmlns:controls="using:Bale.Xbox.Controls"
    FontFamily="{StaticResource SkylineFont}"
    Background="{StaticResource SkylineBackground}">

  <!-- TvItemDetailScreen.kt / TvDetailHero.kt: the primary series viewport stays still while
       focus moves between the hero, season tabs and episodes. Supporting sections anchor below it. -->
  <Page.Resources>
    <DataTemplate x:Key="EpisodeTemplate" x:DataType="views:EpisodeView">
      <StackPanel Style="{StaticResource SkylineDetailEpisodeCardStyle}">
        <Grid x:Name="Art" Width="{StaticResource SkylineDetailEpisodeWidth}" Height="{StaticResource SkylineDetailEpisodeHeight}">
          <Grid CornerRadius="8" Background="{StaticResource SkylineCardPlaceholder}">
            <Image Source="{x:Bind Still}" Stretch="UniformToFill" />
            <!-- TvDetailEpisodeRail.kt dims only the watched still, not its badge or caption. -->
            <Border Background="#59000000" Visibility="{x:Bind WatchedVisibility, Mode=OneWay}" />
            <Border Visibility="{x:Bind WatchedVisibility, Mode=OneWay}" Width="20" Height="20" CornerRadius="10" Background="#FFFFFFFF"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
              <FontIcon Glyph="&#xE73E;" FontSize="9" Foreground="#FF000000" />
            </Border>
            <Grid Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" VerticalAlignment="Bottom" Height="5" Background="#99000000">
              <Border Background="{StaticResource SkylinePrimary}" HorizontalAlignment="Left" Width="{x:Bind ProgressFillWidth, Mode=OneWay}" />
            </Grid>
          </Grid>
          <Border Visibility="{x:Bind CurrentVisibility, Mode=OneWay}" CornerRadius="8" BorderThickness="2" BorderBrush="#B3FFFFFF" IsHitTestVisible="False" />
          <!-- Episodes own an inside border and 1.04 art lift; never Home's outer ring/glow. -->
          <Border x:Name="EpisodeFocusRing" CornerRadius="8" BorderThickness="3" BorderBrush="#E6FFFFFF"
                  Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <StackPanel Style="{StaticResource SkylineDetailEpisodeCaptionStyle}">
          <TextBlock Text="{x:Bind Caption}" FontSize="9.9" LineHeight="{StaticResource SkylineDetailEpisodeTitleLineHeight}" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold"
                     Foreground="#EBEDEDED" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind CaptionMeta}" FontSize="9" LineHeight="{StaticResource SkylineDetailEpisodeMetadataLineHeight}" LineStackingStrategy="BlockLineHeight" FontWeight="Medium"
                     Foreground="#B3EDEDED" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CastTemplate" x:DataType="views:CastView">
      <StackPanel Width="100" Spacing="0">
        <Grid x:Name="Art" Width="100" Height="100">
          <Ellipse Fill="{StaticResource SkylineSurfaceElevated}" />
          <FontIcon Glyph="&#xE77B;" FontSize="40" Foreground="#99FFFFFF" Visibility="{x:Bind PlaceholderVisibility}" />
          <Ellipse>
            <Ellipse.Fill>
              <ImageBrush ImageSource="{x:Bind Photo}" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse x:Name="FocusGlow" Margin="-6" Stroke="{StaticResource SkylineFocusGlow}" StrokeThickness="3" Opacity="0" IsHitTestVisible="False" />
          <Ellipse x:Name="FocusRing" Margin="-3" Stroke="{StaticResource SkylineFocusRing}" StrokeThickness="2" Opacity="0" IsHitTestVisible="False" />
        </Grid>
        <TextBlock x:Name="CastName" Text="{x:Bind Name}" Margin="0,8,0,0" Style="{StaticResource SkylineDetailCastNameStyle}" />
        <TextBlock Text="{x:Bind Role}" Margin="0,2,0,0" Style="{StaticResource SkylineDetailCastRoleStyle}" Visibility="{x:Bind RoleVisibility}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="TrailerTemplate" x:DataType="views:TrailerView">
      <StackPanel Width="{StaticResource SkylineDetailTrailerWidth}" Spacing="{StaticResource SkylineDetailTrailerGapSize}">
        <Grid Width="{StaticResource SkylineDetailTrailerWidth}" Height="{StaticResource SkylineDetailTrailerHeight}">
          <Grid CornerRadius="{StaticResource SkylineDetailTrailerRadius}" Background="{StaticResource SkylineSurfaceElevated}">
            <FontIcon Glyph="&#xE8B2;" Style="{StaticResource SkylineDetailTrailerPlaceholderStyle}" Visibility="{x:Bind PlaceholderVisibility}" />
            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill" />
            <Border x:Name="PlayScrim" Style="{StaticResource SkylineDetailTrailerPlayStyle}" />
            <FontIcon Glyph="&#xF5B0;" Style="{StaticResource SkylineDetailTrailerPlayIconStyle}" />
          </Grid>
          <Border x:Name="TrailerFocusRing" Style="{StaticResource SkylineDetailTrailerRingStyle}" />
        </Grid>
        <TextBlock x:Name="TrailerTitle" Text="{x:Bind Title}" Style="{StaticResource SkylineDetailTrailerTitleStyle}" />
        <TextBlock Text="{x:Bind Secondary}" Visibility="{x:Bind SecondaryVisibility}" Style="{StaticResource SkylineDetailTrailerSecondaryStyle}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="DetailFactTemplate" x:DataType="views:DetailFactView">
      <StackPanel>
        <Border Style="{StaticResource SkylineDetailFactDividerStyle}" Visibility="{x:Bind DividerVisibility}" />
        <Grid Style="{StaticResource SkylineDetailFactRowStyle}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock Text="{x:Bind Label}" Style="{StaticResource SkylineDetailFactLabelStyle}" />
          <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource SkylineDetailFactValueStyle}" />
        </Grid>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="PosterBadgeTemplate" x:DataType="views:BadgeView">
      <Border Style="{StaticResource SkylineDetailPosterBadgeStyle}" BorderThickness="{x:Bind Border}" CornerRadius="{x:Bind Radius}" Padding="{x:Bind Padding}">
        <TextBlock Text="{x:Bind Text}" Style="{StaticResource SkylineDetailPosterBadgeTextStyle}" FontSize="{x:Bind FontSize}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="RelatedTemplate" x:DataType="views:CardView">
      <StackPanel Width="{StaticResource SkylineDetailRelatedWidth}" Spacing="{x:Bind CaptionSpacing}">
        <Grid x:Name="Art" Width="{StaticResource SkylineDetailRelatedWidth}" Height="{StaticResource SkylineDetailRelatedHeight}">
          <Grid CornerRadius="{StaticResource SkylineCardRadius}" Background="{StaticResource SkylineCardPlaceholder}">
            <TextBlock Text="{x:Bind Title}" Visibility="{x:Bind FallbackVisibility}" Style="{StaticResource SkylineDetailTrailerSecondaryStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <Image Source="{x:Bind Image}" Stretch="UniformToFill" />
            <ItemsControl ItemsSource="{x:Bind CornerTop}" ItemTemplate="{StaticResource PosterBadgeTemplate}" Margin="{x:Bind CornerInset}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="False" IsHitTestVisible="False" />
            <ItemsControl ItemsSource="{x:Bind CornerBottom}" ItemTemplate="{StaticResource PosterBadgeTemplate}" Margin="{x:Bind CornerInset}"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom" IsTabStop="False" IsHitTestVisible="False" />
            <Border Visibility="{x:Bind WatchedVisibility, Mode=OneWay}" Width="{x:Bind WatchedSize, Mode=OneWay}" Height="{x:Bind WatchedSize, Mode=OneWay}"
                    CornerRadius="{x:Bind WatchedRadius, Mode=OneWay}" Margin="{x:Bind WatchedInset, Mode=OneWay}" Background="#FFFFFFFF"
                    HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" AutomationProperties.Name="Watched">
              <Viewbox Width="{x:Bind WatchedIconSize, Mode=OneWay}" Height="{x:Bind WatchedIconSize, Mode=OneWay}">
                <Path Width="24" Height="24" Fill="#FF000000" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z" />
              </Viewbox>
            </Border>
          </Grid>
          <Border x:Name="FocusGlow" Style="{StaticResource SkylineDetailPosterGlowStyle}" />
          <Border x:Name="FocusRing" Style="{StaticResource SkylineDetailPosterRingStyle}" />
        </Grid>
        <StackPanel>
          <TextBlock Text="{x:Bind Title}" Style="{StaticResource SkylineDetailPosterTitleStyle}" />
          <TextBlock Text="{x:Bind Subtitle}" Visibility="{x:Bind SubtitleVisibility}" Style="{StaticResource SkylineDetailPosterSubtitleStyle}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="DetailBodyStates">
        <VisualState x:Name="LeafBody">
          <VisualState.Setters><Setter Target="SupportingSections.Margin" Value="{StaticResource SkylineDetailLeafBodyInset}" /></VisualState.Setters>
        </VisualState>
        <VisualState x:Name="SeriesBody">
          <VisualState.Setters><Setter Target="SupportingSections.Margin" Value="{StaticResource SkylineDetailSeriesBodyInset}" /></VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <!-- TvItemDetailScreen.kt composites one sampled tint over black into an opaque page surface. -->
    <Rectangle x:Name="Wash" Fill="#FF040D0F" IsHitTestVisible="False" />
    <Grid x:Name="ArtBox" Width="614" Height="378" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" />

    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" IsTabStop="False">
      <StackPanel x:Name="PageContent" Padding="0,0,0,70">
        <!-- TvDetailHero.kt reserves stable editorial slots for series episode focus changes. -->
        <StackPanel x:Name="Hero" Margin="50,58,50,0" HorizontalAlignment="Left">
          <Grid x:Name="TitleSlot" Height="80" MaxWidth="540" HorizontalAlignment="Left">
            <StackPanel x:Name="TextTitle" VerticalAlignment="Bottom" Spacing="2">
              <Grid>
                <Grid x:Name="TitleShadow" IsHitTestVisible="False" />
                <TextBlock x:Name="TitleText" Style="{StaticResource SkylineDetailTitleStyle}" />
              </Grid>
              <Grid x:Name="SubtitleSlot" Visibility="Collapsed">
                <Grid x:Name="SubtitleShadow" IsHitTestVisible="False" />
                <TextBlock x:Name="SubtitleText" Style="{StaticResource SkylineDetailSubtitleStyle}" />
              </Grid>
            </StackPanel>
            <Image x:Name="TitleLogo" MaxHeight="80" MaxWidth="325" HorizontalAlignment="Left" VerticalAlignment="Bottom" Stretch="Uniform" Opacity="0" />
          </Grid>
          <StackPanel x:Name="Metadata" Margin="0,7,0,0" Orientation="Horizontal" Spacing="7" Height="18" />
          <Button x:Name="SynopsisButton" Margin="0,4,0,0" Height="56" Width="540" HorizontalAlignment="Left"
                  Style="{StaticResource SkylineDetailSynopsisStyle}" Click="OnSynopsisClick">
            <TextBlock x:Name="Synopsis" FontSize="11.2" LineHeight="15.1" LineStackingStrategy="BlockLineHeight"
                       TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis" />
          </Button>
          <TextBlock x:Name="CreditLine" Margin="0,13,0,0" Height="14" FontSize="10.3" FontWeight="Medium" Foreground="#9EFFFFFF" TextTrimming="CharacterEllipsis" />
          <!-- TvDetailHero.kt keeps the quiet readout directly below the fixed credit line. -->
          <StackPanel x:Name="PlaybackSummary" Style="{StaticResource SkylineDetailPlaybackSummaryStyle}" Margin="0,4,0,0">
            <Grid Width="{StaticResource SkylineDetailPlaybackVersionWidth}" Style="{StaticResource SkylineDetailPlaybackItemStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="VERSION" Style="{StaticResource SkylineDetailPlaybackLabelStyle}" />
              <Grid x:Name="PlaybackVersionSlot" Grid.Column="1" SizeChanged="OnPlaybackValueSizeChanged">
                <TextBlock x:Name="PlaybackVersion" Style="{StaticResource SkylineDetailPlaybackValueStyle}" Visibility="Collapsed" />
                <Border x:Name="PlaybackVersionSkeleton" Style="{StaticResource SkylineDetailPlaybackSkeletonStyle}" />
              </Grid>
            </Grid>
            <Grid Width="{StaticResource SkylineDetailPlaybackAudioWidth}" Style="{StaticResource SkylineDetailPlaybackItemStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="AUDIO" Style="{StaticResource SkylineDetailPlaybackLabelStyle}" />
              <Grid x:Name="PlaybackAudioSlot" Grid.Column="1" SizeChanged="OnPlaybackValueSizeChanged">
                <TextBlock x:Name="PlaybackAudio" Style="{StaticResource SkylineDetailPlaybackValueStyle}" Visibility="Collapsed" />
                <Border x:Name="PlaybackAudioSkeleton" Style="{StaticResource SkylineDetailPlaybackSkeletonStyle}" />
              </Grid>
            </Grid>
            <Grid Width="{StaticResource SkylineDetailPlaybackSubtitleWidth}" Style="{StaticResource SkylineDetailPlaybackItemStyle}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <TextBlock Text="SUBTITLES" Style="{StaticResource SkylineDetailPlaybackLabelStyle}" />
              <Grid x:Name="PlaybackSubtitleSlot" Grid.Column="1" SizeChanged="OnPlaybackValueSizeChanged">
                <TextBlock x:Name="PlaybackSubtitle" Style="{StaticResource SkylineDetailPlaybackValueStyle}" Visibility="Collapsed" />
                <Border x:Name="PlaybackSubtitleSkeleton" Style="{StaticResource SkylineDetailPlaybackSkeletonStyle}" />
              </Grid>
            </Grid>
          </StackPanel>

          <!-- rail-layout: non-card — TvItemDetailScreen.kt's horizontal hero actions, not media cards. -->
          <ItemsControl x:Name="Actions" Margin="0,13,0,0" HorizontalAlignment="Left" IsTabStop="False" XYFocusKeyboardNavigation="Enabled">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource SkylineDetailActionGap}" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <Button x:Name="PlayButton" Style="{StaticResource SkylinePlayButtonStyle}" Click="OnPlayClick">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <FontIcon Glyph="&#xF5B0;" FontSize="18" />
                <TextBlock x:Name="PlayLabel" Text="Play" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="StartOverButton" Style="{StaticResource SkylineActionButtonStyle}" Click="OnStartOverClick"
                    AutomationProperties.Name="Start Over" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Glyph="&#xE892;" FontSize="19" />
                <TextBlock Text="Start Over" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- TvPlaybackActionSelectors: Movie, VolumeUp and Chat, in the utility-action order. -->
            <Button x:Name="VersionSelector" Style="{StaticResource SkylineActionButtonStyle}" Click="OnVersionSelectorClick" AutomationProperties.Name="Version">
              <StackPanel Style="{StaticResource SkylineDetailActionContentStyle}">
                <Viewbox Style="{StaticResource SkylineDetailActionIconStyle}">
                  <Path Width="{StaticResource SkylineMaterialIconCanvas}" Height="{StaticResource SkylineMaterialIconCanvas}" Fill="{StaticResource SkylineFocusRing}"
                        Data="M18,4 L20,8 H17 L15,4 H13 L15,8 H12 L10,4 H8 L10,8 H7 L5,4 H4 C2.9,4 2.01,4.9 2.01,6 L2,18 C2,19.1 2.9,20 4,20 H20 C21.1,20 22,19.1 22,18 V4 Z" />
                </Viewbox>
                <TextBlock Text="Version" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="AudioSelector" Style="{StaticResource SkylineActionButtonStyle}" Click="OnAudioSelectorClick" AutomationProperties.Name="Audio">
              <StackPanel Style="{StaticResource SkylineDetailActionContentStyle}">
                <Viewbox Style="{StaticResource SkylineDetailActionIconStyle}">
                  <Path Width="{StaticResource SkylineMaterialIconCanvas}" Height="{StaticResource SkylineMaterialIconCanvas}" Fill="{StaticResource SkylineFocusRing}"
                        Data="M3,9 V15 H7 L12,20 V4 L7,9 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V16.02 C15.48,15.29 16.5,13.77 16.5,12 Z M14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 C19,15.17 16.89,17.85 14,18.71 V20.77 C18.01,19.86 21,16.28 21,12 C21,7.72 18.01,4.14 14,3.23 Z" />
                </Viewbox>
                <TextBlock Text="Audio" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="SubtitleSelector" Style="{StaticResource SkylineActionButtonStyle}" Click="OnSubtitleSelectorClick" AutomationProperties.Name="Subtitles">
              <StackPanel Style="{StaticResource SkylineDetailActionContentStyle}">
                <Viewbox Style="{StaticResource SkylineDetailActionIconStyle}">
                  <Path Width="{StaticResource SkylineMaterialIconCanvas}" Height="{StaticResource SkylineMaterialIconCanvas}" Fill="{StaticResource SkylineFocusRing}"
                        Data="M20,2 H4 C2.9,2 2.01,2.9 2.01,4 L2,22 L6,18 H20 C21.1,18 22,17.1 22,16 V4 C22,2.9 21.1,2 20,2 Z M6,9 H18 V11 H6 Z M14,14 H6 V12 H14 Z M18,8 H6 V6 H18 Z" />
                </Viewbox>
                <TextBlock Text="Subtitles" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="WatchlistButton" Style="{StaticResource SkylineActionButtonStyle}" Click="OnWatchlistClick" AutomationProperties.Name="Watchlist">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Grid Width="19" Height="19">
                  <!-- Icons.Filled.BookmarkBorder / Bookmark, inside a 19dp icon box. -->
                  <Path x:Name="WatchlistIcon" Width="14.25" Height="19" Stretch="Fill" Stroke="#FFFFFFFF" StrokeThickness="1.6" StrokeLineJoin="Round"
                        Data="M 0,0 L 10,0 L 10,14 L 5,10.5 L 0,14 Z" />
                </Grid>
                <TextBlock Text="Watchlist" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="MoreButton" Style="{StaticResource SkylineActionButtonStyle}" Click="OnMoreClick" AutomationProperties.Name="More">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon Glyph="&#xE712;" FontSize="19" />
                <TextBlock Text="More" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </ItemsControl>
          <TextBlock x:Name="ActionStatus" Margin="0,6,0,0" FontSize="10.3" Foreground="{StaticResource SkylineCaptionSubtitle}" />
        </StackPanel>

        <StackPanel x:Name="EpisodesSection" Margin="0,8,0,0" Visibility="Collapsed">
          <!-- rail-layout: non-card — Show/season tabs, not media cards. -->
          <ItemsControl x:Name="Seasons" IsTabStop="False">
            <ItemsControl.Template>
              <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" IsTabStop="False">
                  <ItemsPresenter />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- TvSeasonPicker.kt: scroll to screen edges, with room for the outward focus ring. -->
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="50,4,50,4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="views:SeasonView">
                <ToggleButton Content="{x:Bind Title}" Style="{StaticResource SkylineChipStyle}" Click="OnSeasonClick" GotFocus="OnSeasonFocus" Loaded="OnTabLoaded" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- TvItemDetailScreen.kt keeps the rail footprint and tabs mounted on empty/failed loads. -->
          <Grid Height="{StaticResource SkylineDetailEpisodeRailHeight}">
            <ListView x:Name="Episodes" ItemTemplate="{StaticResource EpisodeTemplate}" Style="{StaticResource SkylineDetailEpisodeRailStyle}"
                      ItemClick="OnEpisodeClick" GotFocus="OnCardFocus" LostFocus="OnCardBlur">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource SkylineCardItemStyle}">
                  <Setter Property="Margin" Value="0,0,20,0" />
                </Style>
              </ListView.ItemContainerStyle>
            </ListView>
            <TextBlock x:Name="NoEpisodes" Text="No episodes available" Style="{StaticResource SkylineDetailNoEpisodesStyle}" Visibility="Collapsed" />
            <!-- TvDetailEpisodeRail.kt clips its five non-interactive skeleton cards to the rail,
                 not the page, so the last placeholder cannot spill into supporting sections. -->
            <Grid x:Name="EpisodesLoading" IsHitTestVisible="False" Visibility="Collapsed" SizeChanged="OnEpisodesLoadingSizeChanged">
              <StackPanel Style="{StaticResource SkylineDetailEpisodeSkeletonRailStyle}">
                <StackPanel Style="{StaticResource SkylineDetailEpisodeCardStyle}">
                  <Border Style="{StaticResource SkylineDetailEpisodeSkeletonStillStyle}" />
                  <StackPanel Style="{StaticResource SkylineDetailEpisodeCaptionStyle}">
                    <Border Style="{StaticResource SkylineDetailEpisodeSkeletonTitleStyle}" />
                    <Border Style="{StaticResource SkylineDetailEpisodeSkeletonMetadataStyle}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource SkylineDetailEpisodeCardStyle}">
                  <Border Style="{StaticResource SkylineDetailEpisodeSkeletonStillStyle}" />
                  <StackPanel Style="{StaticResource SkylineDetailEpisodeCaptionStyle}">
                    <Border Style="{StaticResource SkylineDetailEpisodeSkeletonTitleStyle}" />
                    <Border Style="{StaticResource SkylineDetailEpisodeSkeletonMetadataStyle}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource SkylineDetailEpisodeCardStyle}">
                  <Border Style="{StaticResource SkylineDetailEpisodeSkeletonStillStyle}" />
                  <StackPanel Style="{StaticResource SkylineDetailEpisodeCaptionStyle}">
                    <Border Style="{StaticResource SkylineDetailEpisodeSkeletonTitleStyle}" />
                    <Border Style="{StaticResource SkylineDetailEpisodeSkeletonMetadataStyle}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource SkylineDetailEpisodeCardStyle}">
                  <Border Style="{StaticResource SkylineDetailEpisodeSkeletonStillStyle}" />
                  <StackPanel Style="{StaticResource SkylineDetailEpisodeCaptionStyle}">
                    <Border Style="{StaticResource SkylineDetailEpisodeSkeletonTitleStyle}" />
                    <Border Style="{StaticResource SkylineDetailEpisodeSkeletonMetadataStyle}" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Style="{StaticResource SkylineDetailEpisodeCardStyle}">
                  <Border Style="{StaticResource SkylineDetailEpisodeSkeletonStillStyle}" />
                  <StackPanel Style="{StaticResource SkylineDetailEpisodeCaptionStyle}">
                    <Border Style="{StaticResource SkylineDetailEpisodeSkeletonTitleStyle}" />
                    <Border Style="{StaticResource SkylineDetailEpisodeSkeletonMetadataStyle}" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>
        </StackPanel>

        <StackPanel x:Name="SupportingSections" Margin="{StaticResource SkylineDetailLeafBodyInset}" Spacing="{StaticResource SkylineDetailSectionGap}">
          <StackPanel x:Name="CastSection" Spacing="14" Visibility="Collapsed">
            <TextBlock Text="Cast &amp; Crew" Margin="50,0,50,0" Style="{StaticResource SkylineDetailSectionHeaderStyle}" />
            <ListView x:Name="Cast" ItemTemplate="{StaticResource CastTemplate}" Style="{StaticResource SkylineDetailCastRailStyle}"
                      ItemClick="OnCastClick" GotFocus="OnCardFocus" LostFocus="OnCardBlur">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource SkylineCardItemStyle}">
                  <Setter Property="Margin" Value="0,0,22,0" />
                </Style>
              </ListView.ItemContainerStyle>
            </ListView>
          </StackPanel>

          <!-- TvItemDetailScreen.kt: Cast → Trailers → Related/Recommended → Details, omitting empty sections. -->
          <StackPanel x:Name="TrailersSection" Spacing="{StaticResource SkylineDetailTrailerGapSize}" Visibility="Collapsed">
            <TextBlock Text="Trailers &amp; More" Margin="{StaticResource SkylineDetailHeaderInset}" Style="{StaticResource SkylineDetailSectionHeaderStyle}" />
            <ListView x:Name="Trailers" Style="{StaticResource SkylineDetailExtraRailStyle}" ItemTemplate="{StaticResource TrailerTemplate}"
                      ItemClick="OnTrailerClick" GotFocus="OnCardFocus" LostFocus="OnCardBlur">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource SkylineCardItemStyle}">
                  <Setter Property="Margin" Value="{StaticResource SkylineDetailTrailerGap}" />
                </Style>
              </ListView.ItemContainerStyle>
            </ListView>
          </StackPanel>
          <StackPanel x:Name="SimilarSection" Spacing="{StaticResource SkylineDetailRelatedGapSize}" Visibility="Collapsed">
            <TextBlock x:Name="SimilarHeader" Margin="{StaticResource SkylineDetailHeaderInset}" Style="{StaticResource SkylineDetailSectionHeaderStyle}" />
            <ListView x:Name="Similar" Style="{StaticResource SkylineDetailRelatedRailStyle}" ItemTemplate="{StaticResource RelatedTemplate}"
                      ItemClick="OnSimilarClick" GotFocus="OnCardFocus" LostFocus="OnCardBlur">
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource SkylineCardItemStyle}">
                  <Setter Property="Margin" Value="{StaticResource SkylineDetailRailGap}" />
                </Style>
              </ListView.ItemContainerStyle>
            </ListView>
          </StackPanel>
          <Button x:Name="DetailsSection" Style="{StaticResource SkylineDetailFactsStopStyle}" Visibility="Collapsed"
                  GotFocus="OnDetailsFocus" AutomationProperties.Name="Details">
            <StackPanel Spacing="{StaticResource SkylineDetailFactsGap}">
              <TextBlock Text="Details" Style="{StaticResource SkylineDetailSectionHeaderStyle}" />
              <ItemsControl x:Name="DetailFacts" Width="{StaticResource SkylineDetailFactsWidth}" MaxWidth="{StaticResource SkylineDetailFactsWidth}" HorizontalAlignment="Left"
                            HorizontalContentAlignment="Stretch" ItemTemplate="{StaticResource DetailFactTemplate}" IsTabStop="False" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <ProgressRing x:Name="LoadingRing" Width="32" Height="32" IsActive="True" Foreground="{StaticResource SkylinePrimary}" />
    <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Visibility="Collapsed">
      <TextBlock x:Name="ErrorText" FontSize="{StaticResource SkylineBodySize}" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                 Foreground="{StaticResource SkylineSecondary}" />
      <Button x:Name="RetryButton" Content="Try Again" Style="{StaticResource SkylineButtonStyle}" HorizontalAlignment="Center" Click="OnRetryClick" />
    </StackPanel>

    <!-- These modal surfaces disable only the page beneath them, containing focus without
         replacing the detail route. Back dismisses first (TvOptionDialog.kt / TvExpandableSynopsis.kt). -->
    <Grid x:Name="DialogLayer" Visibility="Collapsed" Background="#C7000000" TabFocusNavigation="Cycle" Tapped="OnDialogBackgroundTapped">
      <Border x:Name="MorePanel" Width="380" Padding="10,14,10,10" Style="{StaticResource SkylineDetailDialogPanelStyle}" Visibility="Collapsed"
              AutomationProperties.Name="More Actions">
        <StackPanel>
          <TextBlock Text="MORE ACTIONS" Margin="10,0,10,6" FontSize="9.5" LineHeight="12" FontWeight="SemiBold" CharacterSpacing="140" Foreground="#99EDEDED" />
          <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" IsTabStop="False">
            <StackPanel x:Name="MoreOptions">
              <Button x:Name="FavoriteItem" Style="{StaticResource SkylineDetailMenuRowStyle}" Click="OnFavoriteClick" GotFocus="OnMoreRowFocus" LostFocus="OnMoreRowBlur">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Viewbox Width="19" Height="19" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid Width="24" Height="24">
                      <Path x:Name="FavoriteOutline" Stroke="#FFEDEDED" StrokeThickness="2" StrokeLineJoin="Round"
                            Data="M12,21 L4.6,14 C0,9.8 2.4,3 7.5,3 C9.4,3 11,4 12,5.5 C13,4 14.6,3 16.5,3 C21.6,3 24,9.8 19.4,14 Z" />
                      <Path x:Name="FavoriteBroken" Stroke="#FFEDEDED" StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed"
                            Data="M10,3.8 C9.2,3.3 8.4,3 7.5,3 C2.4,3 0,9.8 4.6,14 L12,21 L19.4,14 C24,9.8 21.6,3 16.5,3 C15.6,3 14.8,3.3 14,3.8 M12,3 L10,9 L14,12 L11,16 L12,21" />
                    </Grid>
                  </Viewbox>
                  <TextBlock x:Name="FavoriteLabel" Grid.Column="1" Text="Add to Favorites" TextWrapping="Wrap" />
                </Grid>
              </Button>
              <Button x:Name="WatchedItem" Style="{StaticResource SkylineDetailMenuRowStyle}" Click="OnWatchedClick" GotFocus="OnMoreRowFocus" LostFocus="OnMoreRowBlur">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid Width="19" Height="19" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid x:Name="WatchedMarkIcon">
                      <Ellipse Stroke="#FFEDEDED" StrokeThickness="1.6" />
                      <Path Stroke="#FFEDEDED" StrokeThickness="1.6" Data="M4.5,9.5 L8,13 L14.5,6.5" />
                    </Grid>
                    <Path x:Name="WatchedUnmarkIcon" Stroke="#FFEDEDED" StrokeThickness="1.6" Visibility="Collapsed"
                          Data="M1,9 L5,13 L7,11 M8,9 L11,12 L18,5 M4,3 L16,16" />
                  </Grid>
                  <TextBlock x:Name="WatchedLabel" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
              </Button>
              <Button x:Name="SeasonWatchedItem" Style="{StaticResource SkylineDetailMenuRowStyle}" Click="OnSeasonWatchedClick" GotFocus="OnMoreRowFocus" LostFocus="OnMoreRowBlur" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid Width="19" Height="19" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid x:Name="SeasonMarkIcon">
                      <Ellipse Stroke="#FFEDEDED" StrokeThickness="1.6" />
                      <Path Stroke="#FFEDEDED" StrokeThickness="1.6" Data="M4.5,9.5 L8,13 L14.5,6.5" />
                    </Grid>
                    <Path x:Name="SeasonUnmarkIcon" Stroke="#FFEDEDED" StrokeThickness="1.6" Visibility="Collapsed"
                          Data="M1,9 L5,13 L7,11 M8,9 L11,12 L18,5 M4,3 L16,16" />
                  </Grid>
                  <TextBlock x:Name="SeasonWatchedLabel" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
              </Button>
              <Button x:Name="SeasonItem" Style="{StaticResource SkylineDetailMenuRowStyle}" Click="OnGoToSeasonClick" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xE714;" FontSize="19" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <TextBlock x:Name="GoToSeasonLabel" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>
              </Button>
              <Button x:Name="SeriesItem" Style="{StaticResource SkylineDetailMenuRowStyle}" Click="OnSeriesClick" Visibility="Collapsed">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <FontIcon Glyph="&#xE7F4;" FontSize="19" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <TextBlock Grid.Column="1" Text="Go to Series" />
                </Grid>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Border x:Name="SynopsisPanel" Style="{StaticResource SkylineDetailDialogPanelStyle}" Visibility="Collapsed" CornerRadius="22">
        <ScrollViewer x:Name="SynopsisScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled" IsTabStop="True" UseSystemFocusVisuals="False">
          <StackPanel Padding="32,28" Spacing="12">
            <TextBlock x:Name="FullSynopsisTitle" FontSize="20.6" LineHeight="24.1" FontWeight="Bold" Foreground="#FFFFFFFF" TextWrapping="Wrap" />
            <TextBlock x:Name="FullSynopsisTagline" FontFamily="Georgia" FontStyle="Italic" FontSize="13.8" LineHeight="18.1" Foreground="#D1FFFFFF" TextWrapping="Wrap" />
            <TextBlock x:Name="FullSynopsis" FontSize="14.6" LineHeight="21.5" Foreground="#DBFFFFFF" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <controls:PlaybackSelectorMenu x:Name="SelectorMenu" IsHitTestVisible="False"
                                   AnchorGap="{StaticResource SkylinePlaybackSelectorGap}" WindowInset="{StaticResource SkylinePlaybackSelectorWindowInset}" />
  </Grid>
</Page>
