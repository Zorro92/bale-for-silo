<Page
    x:Class="Bale.Xbox.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black"
    NavigationCacheMode="Disabled"
    IsTabStop="True"
    UseSystemFocusVisuals="False">

  <Grid Background="Black">
    <!-- Recreated on mount; teardown removes the native video presenter as well as its player. -->
    <Border x:Name="VideoHost" />
    <!-- Bale draws subtitles itself (Services/SubtitleOverlay.cs): above the video, below every player panel.
         Empty and deviceless until a track loads. -->
    <SwapChainPanel x:Name="SubtitleLayer" IsHitTestVisible="False" />
    <!-- TvSkipSeekIndicator.kt / TvPlayerScrubber.kt: passive feedback, never a focus surface.
         Keep the resting scrubber's geometry, reserving the official transport row below for later. -->
    <Grid x:Name="TransportFeedback" Visibility="Collapsed" IsHitTestVisible="False">
      <Border Style="{StaticResource SkylinePlayerTransportScrimStyle}" />
      <Grid Style="{StaticResource SkylinePlayerTransportStyle}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource SkylinePlayerSkipChipStyle}">
          <Grid ColumnSpacing="{StaticResource SkylinePlayerSkipChipGap}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SkipDelta" Style="{StaticResource SkylinePlayerSkipDeltaStyle}" />
            <TextBlock x:Name="SkipLanding" Grid.Column="1" Style="{StaticResource SkylinePlayerSkipLandingStyle}" />
          </Grid>
        </Border>
        <Grid Grid.Row="1" Style="{StaticResource SkylinePlayerTrackHostStyle}">
          <Grid x:Name="TransportTrack" Style="{StaticResource SkylinePlayerTrackStyle}" SizeChanged="OnTransportSizeChanged">
            <Border Style="{StaticResource SkylinePlayerTrackRailStyle}" />
            <Border x:Name="TransportPlayed" Style="{StaticResource SkylinePlayerTrackPlayedStyle}" Width="0" />
          </Grid>
        </Grid>
        <Grid Grid.Row="2" Style="{StaticResource SkylinePlayerClockRowStyle}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TransportElapsed" Style="{StaticResource SkylinePlayerTimeStyle}" Typography.NumeralAlignment="Tabular" />
          <TextBlock x:Name="TransportRemaining" Grid.Column="1" Style="{StaticResource SkylinePlayerRemainingStyle}" Typography.NumeralAlignment="Tabular" />
        </Grid>
      </Grid>
    </Grid>
    <!-- TvPlayerNoticeOverlay.kt: top-start, passive informational pill; never takes focus.
         Keep it above the default-on development stats panel so the notice is still readable. -->
    <Border x:Name="VersionNotice" Style="{StaticResource SkylinePlayerNoticeStyle}"
            Visibility="Collapsed" IsHitTestVisible="False" Canvas.ZIndex="1">
      <Border.RenderTransform>
        <TranslateTransform x:Name="VersionNoticeSlide" />
      </Border.RenderTransform>
      <Grid ColumnSpacing="8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Viewbox Width="18" Height="18" VerticalAlignment="Center">
          <Path Fill="White" Width="24" Height="24"
                Data="M11,17 L13,17 L13,11 L11,11 Z M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M12,20 C7.59,20 4,16.41 4,12 C4,7.59 7.59,4 12,4 C16.41,4 20,7.59 20,12 C20,16.41 16.41,20 12,20 Z M11,9 L13,9 L13,7 L11,7 Z" />
        </Viewbox>
        <TextBlock x:Name="VersionNoticeText" Grid.Column="1" Style="{StaticResource SkylinePlayerNoticeTextStyle}" />
      </Grid>
    </Border>
    <!-- Only DEBUG_SERVER code makes this visible. Read-only: it must never take player focus. -->
    <Border x:Name="StatsPanel" Style="{StaticResource SkylinePlayerStatsPanelStyle}"
            Visibility="Collapsed" IsHitTestVisible="False">
      <!-- Long values wrap; the right stick (keyboard U/N) scrolls when the pane is taller than the screen. -->
      <ScrollViewer x:Name="StatsScroller" IsTabStop="False" VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
      <Grid ColumnSpacing="{StaticResource SkylinePlayerStatsColumnGap}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="StatsLeftRows" />
        <StackPanel x:Name="StatsRightRows" Grid.Column="1" />
        <!-- Copy these XAML-assigned Styles, not resource dictionary entries: Native AOT safe. -->
        <Grid x:Name="StatsRowStyleSource" Style="{StaticResource SkylinePlayerStatsRowStyle}" Visibility="Collapsed">
          <TextBlock x:Name="StatsLabelStyleSource" Style="{StaticResource SkylinePlayerStatsLabelStyle}" />
          <TextBlock x:Name="StatsValueStyleSource" Style="{StaticResource SkylinePlayerStatsValueStyle}" />
        </Grid>
      </Grid>
      </ScrollViewer>
    </Border>
    <!-- TvPlayerScreen.kt TvPlayerLoadingSpinner: one plain, centered 64dp paper spinner. -->
    <ProgressRing x:Name="LoadingRing" Style="{StaticResource SkylinePlayerLoadingStyle}"
                  AutomationProperties.Name="Loading" Visibility="Collapsed" IsActive="False" />
    <!-- StatusViews.kt TvErrorScreen: keep the shared 24dp arrangement around its 8dp spacer. -->
    <Grid x:Name="ErrorPanel" Style="{StaticResource SkylineProfileErrorScreenStyle}" Visibility="Collapsed">
      <StackPanel Style="{StaticResource SkylineProfileErrorContentStyle}">
        <TextBlock x:Name="ErrorText" Style="{StaticResource SkylineProfileErrorMessageStyle}" />
        <Border Height="{StaticResource SkylineProfileErrorSpacer}" />
        <Button x:Name="RetryButton" Content="Retry" Click="OnRetryClick" Style="{StaticResource SkylineProfileRetryStyle}" />
      </StackPanel>
    </Grid>
  </Grid>
</Page>
