  <!-- TvAnchoredSelectorMenu.kt: 300–400dp anchored Skyline panel, 6dp gap, pinned eyebrow,
       270dp scrolling list, 28dp check slot, 19dp check and 10dp row corners.
       Text is TvPlayerType at plain sp (no 0.86): the menu is hosted in a Material DropdownMenu
       popup, which draws outside SiloTvTheme's fontScale; measured on the shipping APK.
       Compose's default LineHeightStyle trims the line-height padding above the first and below the
       last line, so a one-line Text is only Inter's natural 1.21 em tall: 11→13.3, 15→18.15,
       14→16.95. That makes a two-line row 55dp, as measured on the APK (58 untrimmed). -->
  <x:Double x:Key="SkylinePlaybackSelectorGap">6</x:Double>
  <x:Double x:Key="SkylinePlaybackSelectorWindowInset">48</x:Double>
  <x:Double x:Key="SkylinePlaybackSelectorListHeight">270</x:Double>
  <!-- TvAnchoredSelectorMenu.kt's SelectorMenuScrollEdgeHeight masks only the rows, not the chevrons. -->
  <x:Double x:Key="SkylinePlaybackSelectorEdgeFadeHeight">26</x:Double>
  <GridLength x:Key="SkylinePlaybackSelectorCheckSlot">28</GridLength>
  <Style x:Key="SkylinePlaybackSelectorPanelStyle" TargetType="controls:SkylinePanel" BasedOn="{StaticResource SkylinePanelChromeStyle}">
    <Setter Property="MinWidth" Value="300" /><Setter Property="MaxWidth" Value="400" />
    <Setter Property="CornerRadius" Value="20" /><Setter Property="Padding" Value="10,14,10,10" />
    <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style x:Key="SkylinePlaybackSelectorHeaderStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="13.3" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CharacterSpacing" Value="140" /><Setter Property="Foreground" Value="#99EDEDED" />
    <Setter Property="Margin" Value="10,0,10,6" /><Setter Property="MaxLines" Value="1" />
  </Style>
  <Style x:Key="SkylinePlaybackSelectorTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" /><Setter Property="LineHeight" Value="18.15" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="MaxLines" Value="1" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="SkylinePlaybackSelectorDetailStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="16.95" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Opacity" Value="0.6" /><Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="MaxLines" Value="2" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="SkylinePlaybackSelectorCheckStyle" TargetType="Viewbox">
    <Setter Property="Width" Value="19" /><Setter Property="Height" Value="19" />
    <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,1,0,0" />
  </Style>
  <Style x:Key="SkylinePlaybackSelectorOverflowStyle" TargetType="Viewbox">
    <Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" />
    <Setter Property="Opacity" Value="0.7" />
    <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <!-- TvSelectorRowVisualState.kt: selected soft fill; Paper/Ink focus takes precedence over selection. -->
  <Style x:Key="SkylinePlaybackSelectorRowStyle" TargetType="ToggleButton">
    <Setter Property="Padding" Value="10,9" /><Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{StaticResource SkylinePrimary}" />
    <Setter Property="UseSystemFocusVisuals" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" /><VisualState x:Name="PointerOver" /><VisualState x:Name="Pressed" />
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Content.Opacity" Value="0.38" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="CheckStates">
                <VisualState x:Name="Unchecked" />
                <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Selected.Opacity" Value="1" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Indeterminate" />
              </VisualStateGroup>
              <VisualStateGroup x:Name="FocusStates">
                <VisualState x:Name="Focused"><VisualState.Setters>
                  <Setter Target="FocusFill.Opacity" Value="1" /><Setter Target="Content.Foreground" Value="#FF0B0B0C" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="PointerFocused"><VisualState.Setters>
                  <Setter Target="FocusFill.Opacity" Value="1" /><Setter Target="Content.Foreground" Value="#FF0B0B0C" />
                </VisualState.Setters></VisualState>
                <VisualState x:Name="Unfocused" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Selected" CornerRadius="10" Background="#13EDEDED" Opacity="0" />
            <Border x:Name="FocusFill" CornerRadius="10" Background="{StaticResource SkylinePrimary}" Opacity="0" />
            <ContentPresenter x:Name="Content" Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Stretch" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Detail's centered More Actions panel (TvOptionDialog.kt / TvPlayerChrome.kt), not an anchored flyout. -->
