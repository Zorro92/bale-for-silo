<UserControl
    x:Class="Bale.Xbox.Controls.SignOutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource SkylineFont}" IsTabStop="False" IsHitTestVisible="False">
  <!-- TvSignOutDialog.kt / TvDialog.kt: a 640dp opaque card over a 78% black scrim.
       Default-style Cancel comes first and takes focus; destructive actions never take initial focus. -->
  <Grid x:Name="ModalLayer" Background="{StaticResource SkylineDialogScrim}" Visibility="Collapsed"
        PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp" Tapped="OnBackgroundTapped">
    <Grid Style="{StaticResource SkylineSignOutDialogCardStyle}" AutomationProperties.Name="Sign Out">
      <Border x:Name="ShadowHost" IsHitTestVisible="False">
        <Rectangle x:Name="ShadowMask" Style="{StaticResource SkylineDialogShadowMaskStyle}" />
      </Border>
      <Border Style="{StaticResource SkylineDialogSurfaceStyle}" />
      <StackPanel Style="{StaticResource SkylineDialogContentStyle}">
        <TextBlock Text="Sign Out" Style="{StaticResource SkylineDialogTitleStyle}" />
        <TextBlock Text="Choose whether to keep or remove this server from this TV." Style="{StaticResource SkylineDialogMessageStyle}" />
        <!-- rail-layout: non-card — TvDialog.kt's horizontal confirmation actions, with contained focus. -->
        <ItemsControl x:Name="Actions" Style="{StaticResource SkylineDialogActionsStyle}" IsTabStop="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource SkylineDialogActionGap}" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SkylineDialogButtonStyle}" Click="OnCancelClick" />
          <Button x:Name="SignOutButton" Content="Sign Out" Style="{StaticResource SkylineDialogDestructiveButtonStyle}" Click="OnSignOutClick" />
          <Button x:Name="RemoveServerButton" Content="Sign Out &amp; Remove Server" Style="{StaticResource SkylineDialogDestructiveButtonStyle}" Click="OnRemoveServerClick" />
        </ItemsControl>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
