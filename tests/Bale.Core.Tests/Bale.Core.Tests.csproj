<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);DEBUG_SERVER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Bale.Core/Bale.Core.csproj" />
    <!-- Exercise Xbox's pure layout math on Linux without referencing UWP/XAML. -->
    <Compile Include="../../src/Bale.Xbox/Services/CardRailMetrics.cs" Link="CardRailMetrics.cs" />
    <Compile Include="../../src/Bale.Xbox/Services/CardMenuPlacement.cs" Link="CardMenuPlacement.cs" />
    <Compile Include="../../src/Bale.Xbox/Services/RailScrollState.cs" Link="RailScrollState.cs" />
    <Compile Include="../../src/Bale.Xbox/Services/TopMenuPreviewTiming.cs" Link="TopMenuPreviewTiming.cs" />
    <!-- The DEBUG_SERVER fixture has no UWP, network, client or storage dependency. -->
    <Compile Include="../../src/Bale.Xbox/Services/ProfilePreview.cs" Link="ProfilePreview.cs" />
    <!-- Test focus retry coordination against a minimal event/tree stand-in, not the UWP runtime. -->
    <Compile Include="../../src/Bale.Xbox/Services/FocusRetry.cs" Link="FocusRetry.cs" />
    <!-- Check declarative Skyline geometry/states on Linux; this does not render or compile UWP. -->
    <None Include="../../src/Bale.Xbox/Themes/Skyline.xaml" Link="Skyline.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Bale.Xbox/MainPage.xaml" Link="MainPage.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Bale.Xbox/ServerListPage.xaml" Link="ServerListPage.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Bale.Xbox/ProfileEditorPage.xaml" Link="ProfileEditorPage.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Bale.Xbox/Controls/ProfileTextDialog.xaml" Link="ProfileTextDialog.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Bale.Xbox/Controls/ConnectionDialog.xaml" Link="ConnectionDialog.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/Bale.Xbox/Controls/SavedServerRow.xaml" Link="SavedServerRow.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
