<UserControl
    x:Class="Bale.Xbox.Controls.LibraryBrowseToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <!-- TvLibraryBrowseControls.kt: icon/label colors invert together, with a quieter sort direction. -->
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="SortFocus">
        <VisualState x:Name="SortResting" />
        <VisualState x:Name="SortFocused"><VisualState.Setters>
          <Setter Target="SortIcon.Fill" Value="{StaticResource SkylineLibraryControlFocusedText}" />
          <Setter Target="SortLabel.Foreground" Value="{StaticResource SkylineLibraryControlFocusedText}" />
          <Setter Target="SortDirection.Foreground" Value="{StaticResource SkylineLibraryControlFocusedDirection}" />
        </VisualState.Setters></VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="FilterFocus">
        <VisualState x:Name="FilterResting" />
        <VisualState x:Name="FilterFocused"><VisualState.Setters>
          <Setter Target="FilterIcon.Fill" Value="{StaticResource SkylineLibraryControlFocusedText}" />
          <Setter Target="FilterLabel.Foreground" Value="{StaticResource SkylineLibraryControlFocusedText}" />
          <Setter Target="FilterCount.Foreground" Value="{StaticResource SkylineLibraryControlFocusedText}" />
        </VisualState.Setters></VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="ClearFocus">
        <VisualState x:Name="ClearResting" />
        <VisualState x:Name="ClearFocused"><VisualState.Setters>
          <Setter Target="ClearIcon.Fill" Value="{StaticResource SkylineLibraryControlFocusedText}" />
          <Setter Target="ClearLabel.Foreground" Value="{StaticResource SkylineLibraryControlFocusedText}" />
        </VisualState.Setters></VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="FilterActivity">
        <VisualState x:Name="FilterInactive" />
        <VisualState x:Name="FilterActive"><VisualState.Setters>
          <Setter Target="FilterButton.Background" Value="{StaticResource SkylineLibraryControlActive}" />
          <Setter Target="FilterButton.Height" Value="{StaticResource SkylineLibraryBadgeControlHeight}" />
          <Setter Target="FilterButton.CornerRadius" Value="{StaticResource SkylineLibraryBadgeControlRadius}" />
          <Setter Target="FilterBadge.Visibility" Value="Visible" />
        </VisualState.Setters></VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <!-- rail-layout: non-card — TvLibraryBrowseControls.kt Sort / Filter / Clear filters pills. -->
    <ItemsControl x:Name="Controls" IsTabStop="False" PreviewKeyDown="OnControlsKeyDown">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Style="{StaticResource SkylineLibraryControlsRowStyle}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <Button x:Name="SortButton" Style="{StaticResource SkylineLibraryControlStyle}" Click="OnSortClick" GotFocus="OnPillFocus" LostFocus="OnPillBlur">
        <StackPanel Style="{StaticResource SkylineLibraryControlContentStyle}">
          <Viewbox Style="{StaticResource SkylineLibraryControlIconStyle}">
            <Path x:Name="SortIcon" Style="{StaticResource SkylineLibraryControlGlyphStyle}"
                  Data="M16,17.01 L16,3 L14,3 L14,17.01 L11,17.01 L15,21 L19,17.01 Z M9,3 L5,6.99 L8,6.99 L8,21 L10,21 L10,6.99 L13,6.99 Z" />
          </Viewbox>
          <TextBlock x:Name="SortLabel" Style="{StaticResource SkylineLibraryControlLabelStyle}" />
          <TextBlock x:Name="SortDirection" Style="{StaticResource SkylineLibraryControlDirectionStyle}" />
        </StackPanel>
      </Button>
      <Button x:Name="FilterButton" Style="{StaticResource SkylineLibraryControlStyle}" Click="OnFilterClick" GotFocus="OnPillFocus" LostFocus="OnPillBlur">
        <StackPanel Style="{StaticResource SkylineLibraryControlContentStyle}">
          <Viewbox Style="{StaticResource SkylineLibraryControlIconStyle}">
            <Path x:Name="FilterIcon" Style="{StaticResource SkylineLibraryControlGlyphStyle}"
                  Data="M10,18 L14,18 L14,16 L10,16 Z M3,6 L3,8 L21,8 L21,6 Z M6,13 L18,13 L18,11 L6,11 Z" />
          </Viewbox>
          <TextBlock x:Name="FilterLabel" Text="Filter" Style="{StaticResource SkylineLibraryControlLabelStyle}" />
          <Border x:Name="FilterBadge" Style="{StaticResource SkylineLibraryControlBadgeStyle}" Visibility="Collapsed">
            <TextBlock x:Name="FilterCount" Style="{StaticResource SkylineLibraryControlBadgeTextStyle}" />
          </Border>
        </StackPanel>
      </Button>
      <Button x:Name="ClearButton" Style="{StaticResource SkylineLibraryControlStyle}" Click="OnClearClick" Visibility="Collapsed" GotFocus="OnPillFocus" LostFocus="OnPillBlur">
        <StackPanel Style="{StaticResource SkylineLibraryControlContentStyle}">
          <Viewbox Style="{StaticResource SkylineLibraryControlIconStyle}">
            <Path x:Name="ClearIcon" Style="{StaticResource SkylineLibraryControlGlyphStyle}"
                  Data="M12,2 C6.47,2 2,6.47 2,12 C2,17.53 6.47,22 12,22 C17.53,22 22,17.53 22,12 C22,6.47 17.53,2 12,2 Z M12,20 C7.59,20 4,16.41 4,12 C4,7.59 7.59,4 12,4 C16.41,4 20,7.59 20,12 C20,16.41 16.41,20 12,20 Z M15.59,7 L12,10.59 L8.41,7 L7,8.41 L10.59,12 L7,15.59 L8.41,17 L12,13.41 L15.59,17 L17,15.59 L13.41,12 L17,8.41 Z" />
          </Viewbox>
          <TextBlock x:Name="ClearLabel" Text="Clear filters" Style="{StaticResource SkylineLibraryControlLabelStyle}" />
        </StackPanel>
      </Button>
    </ItemsControl>
    <TextBlock x:Name="ItemCount" Grid.Column="1" Style="{StaticResource SkylinePersonalCountStyle}" Visibility="Collapsed" />
  </Grid>
</UserControl>
