<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="bale-native" value=".cache/ffmpeg-native" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Exact IDs take precedence over nuget.org's wildcard: both forks require the verified feed. -->
    <packageSource key="bale-native">
      <package pattern="FFmpegInteropX.UWP.FFmpeg" />
      <package pattern="FFmpegInteropX.UWP.Lib" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
