<Page
    x:Class="Bale.Xbox.CatalogGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Bale.Xbox.Views"
    FontFamily="{StaticResource SkylineFont}"
    Background="{StaticResource SkylineBackground}">
  <Page.Resources>
    <DataTemplate x:Key="BadgeTemplate" x:DataType="views:BadgeView">
      <Border Style="{StaticResource SkylineDetailPosterBadgeStyle}" BorderThickness="{x:Bind Border}" CornerRadius="{x:Bind Radius}" Padding="{x:Bind Padding}">
        <TextBlock Text="{x:Bind Text}" Style="{StaticResource SkylineDetailPosterBadgeTextStyle}" FontSize="{x:Bind FontSize}" />
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="CardTemplate" x:DataType="views:CardView">
      <StackPanel Width="{x:Bind Width, Mode=OneWay}" Spacing="{StaticResource SkylineCatalogCaptionGap}" Margin="{x:Bind GridHeadroom, Mode=OneWay}">
        <Grid x:Name="Art" Width="{x:Bind Width, Mode=OneWay}" Height="{x:Bind Height, Mode=OneWay}">
          <Grid CornerRadius="{StaticResource SkylineCardRadius}" Background="{StaticResource SkylineCardPlaceholder}">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" Style="{StaticResource SkylineDetailTrailerSecondaryStyle}"
                       TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Image, Mode=OneWay}" Stretch="UniformToFill" />
            <ItemsControl ItemsSource="{x:Bind CornerTop, Mode=OneWay}" ItemTemplate="{StaticResource BadgeTemplate}" Margin="{x:Bind CornerInset, Mode=OneWay}"
                          HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="False" IsHitTestVisible="False" />
            <ItemsControl ItemsSource="{x:Bind CornerBottom, Mode=OneWay}" ItemTemplate="{StaticResource BadgeTemplate}" Margin="{x:Bind CornerInset, Mode=OneWay}"
                          HorizontalAlignment="Left" VerticalAlignment="Bottom" IsTabStop="False" IsHitTestVisible="False" />
            <Border Visibility="{x:Bind WatchedVisibility, Mode=OneWay}" Width="{x:Bind WatchedSize, Mode=OneWay}" Height="{x:Bind WatchedSize, Mode=OneWay}"
                    CornerRadius="{x:Bind WatchedRadius, Mode=OneWay}" Margin="{x:Bind WatchedInset, Mode=OneWay}" Background="#FFFFFFFF"
                    HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" AutomationProperties.Name="Watched">
              <Viewbox Width="{x:Bind WatchedIconSize, Mode=OneWay}" Height="{x:Bind WatchedIconSize, Mode=OneWay}">
                <Path Width="24" Height="24" Fill="#FF000000" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z" />
              </Viewbox>
            </Border>
          </Grid>
          <Border x:Name="FocusGlow" Style="{StaticResource SkylineDetailPosterGlowStyle}" />
          <Border x:Name="FocusRing" Style="{StaticResource SkylineDetailPosterRingStyle}" />
        </Grid>
        <Grid>
          <StackPanel>
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SkylineCatalogCardTitleStyle}" />
            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" Style="{StaticResource SkylineCatalogCardSubtitleStyle}" />
          </StackPanel>
          <TextBlock x:Name="FocusCaption" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource SkylineCatalogCardTitleStyle}"
                     VerticalAlignment="Top" Foreground="{StaticResource SkylinePrimary}" Opacity="0" IsHitTestVisible="False" />
        </Grid>
      </StackPanel>
    </DataTemplate>
  </Page.Resources>

  <!-- TvSectionBrowseScreen.kt / TvCatalogGrid.kt: the renderer is shared; personal chrome is optional. -->
  <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="SourceLayout">
        <VisualState x:Name="Catalog" />
        <VisualState x:Name="Personal">
          <VisualState.Setters>
            <Setter Target="PersonalHeader.Visibility" Value="Visible" />
            <Setter Target="PageTitle.Visibility" Value="Collapsed" />
            <Setter Target="Cards.Padding" Value="{StaticResource SkylinePersonalGridPadding}" />
            <Setter Target="Cards.ItemContainerStyle" Value="{StaticResource SkylinePersonalGridItemStyle}" />
            <Setter Target="ToolbarSlot.Margin" Value="{StaticResource SkylinePersonalControlsMargin}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="PersonalKind">
        <VisualState x:Name="PersonalWatchlist"><VisualState.Setters>
          <Setter Target="PersonalTitleWatchlistIcon.Visibility" Value="Visible" />
          <Setter Target="PersonalEmptyWatchlistIcon.Visibility" Value="Visible" />
        </VisualState.Setters></VisualState>
        <VisualState x:Name="PersonalFavorites"><VisualState.Setters>
          <Setter Target="PersonalTitleFavoritesIcon.Visibility" Value="Visible" />
          <Setter Target="PersonalEmptyFavoritesIcon.Visibility" Value="Visible" />
        </VisualState.Setters></VisualState>
        <VisualState x:Name="PersonalHistory"><VisualState.Setters>
          <Setter Target="PersonalTitleHistoryIcon.Visibility" Value="Visible" />
          <Setter Target="PersonalEmptyHistoryIcon.Visibility" Value="Visible" />
        </VisualState.Setters></VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="PersonalControls">
        <VisualState x:Name="PersonalWithoutControls" />
        <VisualState x:Name="PersonalWithControls"><VisualState.Setters>
          <Setter Target="PersonalEmptyPanel.Margin" Value="{StaticResource SkylinePersonalInlineStateMargin}" />
        </VisualState.Setters></VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- TvPersonalScreens.kt keeps this title outside the scrolling grid. -->
    <StackPanel x:Name="PersonalHeader" Style="{StaticResource SkylinePersonalHeaderStyle}" Visibility="Collapsed">
      <TextBlock Text="YOUR LIBRARY" Style="{StaticResource SkylinePersonalEyebrowStyle}" />
      <StackPanel Style="{StaticResource SkylinePersonalTitleRowStyle}">
        <Viewbox Style="{StaticResource SkylinePersonalTitleIconStyle}">
          <Grid Width="24" Height="24">
            <Path x:Name="PersonalTitleWatchlistIcon" Style="{StaticResource SkylinePersonalIconPathStyle}" Visibility="Collapsed"
                Data="M17,3 H7 C5.9,3 5,3.9 5,5 V21 L12,18 L19,21 V5 C19,3.9 18.1,3 17,3 Z M17,18 L12,15.82 L7,18 V5 H17 Z" />
            <Path x:Name="PersonalTitleFavoritesIcon" Style="{StaticResource SkylinePersonalIconPathStyle}" Visibility="Collapsed"
                Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 Z" />
            <Path x:Name="PersonalTitleHistoryIcon" Style="{StaticResource SkylinePersonalIconPathStyle}" Visibility="Collapsed"
                Data="M13,3 C8.03,3 4,7.03 4,12 H1 L4.89,15.89 L4.96,16.03 L9,12 H6 C6,8.13 9.13,5 13,5 C16.87,5 20,8.13 20,12 C20,15.87 16.87,19 13,19 C11.07,19 9.32,18.21 8.06,16.94 L6.64,18.36 C8.27,19.99 10.51,21 13,21 C17.97,21 22,16.97 22,12 C22,7.03 17.97,3 13,3 Z M12,8 V13 L16.28,15.54 L17,14.33 L13.5,12.25 V8 Z" />
          </Grid>
        </Viewbox>
        <TextBlock x:Name="PersonalTitle" Style="{StaticResource SkylineCatalogTitleStyle}" />
      </StackPanel>
    </StackPanel>

    <Grid x:Name="ContentArea" Grid.Row="1">
      <GridView x:Name="Cards" Padding="{StaticResource SkylineCatalogPagePadding}" IsTabStop="False" SelectionMode="None" IsItemClickEnabled="True"
                ItemTemplate="{StaticResource CardTemplate}" ItemContainerStyle="{StaticResource SkylineCatalogGridItemStyle}"
                ItemClick="OnCardClick" GotFocus="OnCardFocus" LostFocus="OnCardBlur" Visibility="Collapsed"
                ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
        <GridView.ItemsPanel>
          <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="6" /></ItemsPanelTemplate>
        </GridView.ItemsPanel>
        <GridView.Header>
          <StackPanel>
            <TextBlock x:Name="PageTitle" Style="{StaticResource SkylineCatalogTitleStyle}" Margin="{StaticResource SkylineCatalogHeaderMargin}" />
            <!-- Optional source chrome scrolls with the cards (TvCatalogGrid's spanning header).
                 A Border slot can be populated through Child under Native AOT. -->
            <Border x:Name="ToolbarSlot" />
          </StackPanel>
        </GridView.Header>
        <GridView.Footer>
          <StackPanel x:Name="GridStates">
            <TextBlock x:Name="EmptyMessage" Text="This row has no titles right now." Style="{StaticResource SkylineCatalogMessageStyle}" Visibility="Collapsed" />
            <StackPanel x:Name="MoreErrorPanel" Style="{StaticResource SkylineCatalogRetryPanelStyle}" Visibility="Collapsed">
              <TextBlock Text="Couldn't load more" Style="{StaticResource SkylinePersonStatusStyle}" />
              <Button x:Name="MoreRetryButton" Content="Retry" Style="{StaticResource SkylineButtonStyle}" HorizontalAlignment="Center" Click="OnMoreRetryClick" />
            </StackPanel>
            <ProgressRing x:Name="MoreLoading" Style="{StaticResource SkylinePersonLoadingStyle}" IsActive="False" Visibility="Collapsed" />
          </StackPanel>
        </GridView.Footer>
      </GridView>
      <StackPanel x:Name="PersonalEmptyPanel" Style="{StaticResource SkylinePersonalEmptyStyle}" Visibility="Collapsed" IsHitTestVisible="False">
        <Viewbox Style="{StaticResource SkylinePersonalEmptyIconStyle}">
          <Grid Width="24" Height="24">
            <Path x:Name="PersonalEmptyWatchlistIcon" Style="{StaticResource SkylinePersonalIconPathStyle}" Fill="{StaticResource SkylineSecondary}" Visibility="Collapsed"
                Data="M17,3 H7 C5.9,3 5,3.9 5,5 V21 L12,18 L19,21 V5 C19,3.9 18.1,3 17,3 Z M17,18 L12,15.82 L7,18 V5 H17 Z" />
            <Path x:Name="PersonalEmptyFavoritesIcon" Style="{StaticResource SkylinePersonalIconPathStyle}" Fill="{StaticResource SkylineSecondary}" Visibility="Collapsed"
                Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.04 Z" />
            <Path x:Name="PersonalEmptyHistoryIcon" Style="{StaticResource SkylinePersonalIconPathStyle}" Fill="{StaticResource SkylineSecondary}" Visibility="Collapsed"
                Data="M13,3 C8.03,3 4,7.03 4,12 H1 L4.89,15.89 L4.96,16.03 L9,12 H6 C6,8.13 9.13,5 13,5 C16.87,5 20,8.13 20,12 C20,15.87 16.87,19 13,19 C11.07,19 9.32,18.21 8.06,16.94 L6.64,18.36 C8.27,19.99 10.51,21 13,21 C17.97,21 22,16.97 22,12 C22,7.03 17.97,3 13,3 Z M12,8 V13 L16.28,15.54 L17,14.33 L13.5,12.25 V8 Z" />
          </Grid>
        </Viewbox>
        <TextBlock x:Name="PersonalEmptyMessage" Style="{StaticResource SkylinePersonalEmptyTextStyle}" />
      </StackPanel>
      <ProgressRing x:Name="LoadingRing" Style="{StaticResource SkylinePersonLoadingStyle}" IsActive="False" Visibility="Collapsed" />
      <StackPanel x:Name="ErrorPanel" Style="{StaticResource SkylineCatalogRetryPanelStyle}" Visibility="Collapsed">
        <TextBlock x:Name="ErrorMessage" Text="Couldn't load this row." Style="{StaticResource SkylineCatalogMessageStyle}" />
        <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource SkylineButtonStyle}" HorizontalAlignment="Center" Click="OnRetryClick" />
      </StackPanel>
      <StackPanel x:Name="UnavailablePanel" Padding="{StaticResource SkylineCatalogPagePadding}" Visibility="Collapsed">
        <TextBlock x:Name="UnavailableTitle" Style="{StaticResource SkylineCatalogTitleStyle}" />
        <TextBlock Text="This row is no longer available." Style="{StaticResource SkylineCatalogMessageStyle}" />
      </StackPanel>
    </Grid>
    <!-- Source-specific full-page overlays (for example a toolbar dialog); empty for section pages. -->
    <Border x:Name="SourceOverlay" Grid.RowSpan="2" Visibility="Collapsed" />
  </Grid>
</Page>
