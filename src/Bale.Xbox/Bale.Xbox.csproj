<Project Sdk="Microsoft.NET.Sdk">

  <!-- UWP on modern .NET with Native AOT. Builds on Windows only (XAML compiler + MSIX tooling);
       CI does this on a GitHub-hosted Windows runner. Everything testable lives in Bale.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Bale.Xbox</RootNamespace>
    <AssemblyName>Bale</AssemblyName>
    <UseUwp>true</UseUwp>
    <UseUwpTools>true</UseUwpTools>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <DefaultLanguage>en-US</DefaultLanguage>
    <PublishAot>true</PublishAot>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Auto: also generate WinRT vtables for generic collections handed to XAML (ItemsSource = List<T>), which AOT can't do at runtime. -->
    <CsWinRTAotOptimizerEnabled>Auto</CsWinRTAotOptimizerEnabled>
    <!-- The generated vtables use unsafe code; without this CsWinRT silently skips them (CsWinRT1030). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CsWinRTAotWarningLevel>2</CsWinRTAotWarningLevel>
    <!-- Development control channel (Services/DebugServer.cs). Build with -p:BaleDebugServer=false for anything shipped. -->
    <BaleDebugServer Condition="'$(BaleDebugServer)' == ''">true</BaleDebugServer>
    <DefineConstants Condition="'$(BaleDebugServer)' == 'true'">$(DefineConstants);DEBUG_SERVER</DefineConstants>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Content Include="Assets\Fonts\InterVariable.ttf" />
    <Content Include="Assets\Fonts\Inter-OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bale.Core\Bale.Core.csproj" />
  </ItemGroup>

</Project>
